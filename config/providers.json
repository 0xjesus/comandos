        "grok",
        "agent",
        "--no-leader",
        "{model_args}",
        "{effort_args}",
        "{danger_args}",
        "stdio"
      ],
      "accountsProvider": "grok",
      "modelArgs": [
        "-m",
        "{model}"
      ],
      "effortArgs": [
        "--reasoning-effort",
        "{effort}"
      ],
      "dangerArgs": [
        "--always-approve"
      ],
      "modelVia": "acp",
      "resume": false
    },
    "opencode": {
      "label": "OpenCode (ACP)",
      "command": [
        "opencode",
        "acp"
      ],
      "modelEnv": "OPENCODE_CONFIG_CONTENT",
      "modelEnvTemplate": "{\"model\":\"{model}\"}",
      "resume": false
    },
    "agy": {
