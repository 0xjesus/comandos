        "codex-acp"
      ],
      "accountsProvider": "codex",
      "modelArgs": [
        "-c",
        "model=\"{model}\""
      ],
      "effortArgs": [
        "-c",
        "model_reasoning_effort=\"{effort}\""
      ],
      "dangerMode": "full-access",
      "resume": false
    },
    "grok": {
      "label": "Grok Build (ACP)",
