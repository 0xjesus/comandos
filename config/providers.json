  "acpAgents": {
    "claude": {
      "label": "Claude Code (ACP)",
      "command": [
        "claude-agent-acp"
      ],
      "requires": [
        "claude"
      ],
      "env": {
        "CLAUDE_CODE_EXECUTABLE": "which:claude"
      },
      "accountsProvider": "claude",
      "modelVia": "acp",
      "effortEnv": "MAX_THINKING_TOKENS",
      "effortEnvMap": {
        "low": "1024",
        "medium": "4096",
        "high": "16000",
        "xhigh": "32000",
        "max": "63999"
      },
      "dangerMode": "bypassPermissions",
      "resume": true
    },
