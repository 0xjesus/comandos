def _worktree_include_files(cwd):
    """Patrones de .worktreeinclude, o el fallback sensato (.env*)."""
    pats = []
    try:
        with open(os.path.join(cwd, ".worktreeinclude")) as f:
            pats = [l.strip() for l in f if l.strip() and not l.startswith("#")]
    except OSError:
        pats = [".env", ".env.*", ".envrc"]
    out = []
    for pat in pats:
        out += glob.glob(os.path.join(cwd, pat))
    return [f for f in out if os.path.isfile(f)]


def make_worktree(cwd):
    """Crea un worktree del repo y copia los gitignored esenciales.
    (El paso que todo el mundo omite, segun la investigacion.)"""
    if subprocess.run(["git", "-C", cwd, "rev-parse", "--git-dir"],
                      capture_output=True, timeout=8).returncode != 0:
        return None, "no es repo git"
    n = int(time.time()) % 100000
    name = f"wt-{n}"
    path = os.path.join(cwd, ".claude", "worktrees", name)
    while os.path.exists(path):
        n += 1
        name = f"wt-{n}"
        path = os.path.join(cwd, ".claude", "worktrees", name)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    r = subprocess.run(["git", "-C", cwd, "worktree", "add", path,
                        "-b", f"worktree-{name}"],
                       capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        return None, (r.stderr or "git worktree fallo").strip()[:200]
    for f in _worktree_include_files(cwd):
        try:
            shutil.copy2(f, os.path.join(path, os.path.basename(f)))
        except OSError:
            pass
    return path, None


