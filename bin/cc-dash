_limits_refreshing = False


def notice_emit(kind, title, excerpt="", project=None, source_event_id=None):
    """Record a non-turn notice (model/news announcement, usage alert) in the
    N1 event log so the strip, floats, sound and push share one policy."""
    try:
        conn = app_state.connect()
        app_state.migrate(conn)
        now = int(time.time() * 1000)
        conn.execute("BEGIN IMMEDIATE")
        try:
            event_store.append_event(conn, {
                "eventId": f"{kind}:{now}:{secrets.token_hex(4)}", "source": "comandos", "kind": kind,
                "evidence": "confirmed", "correlation": "unknown", "occurredAtMs": now, "receivedAtMs": now,
                "projectKey": project, "title": str(title or "")[:200], "excerpt": str(excerpt or "")[:500],
                "sourceEventId": source_event_id})
            conn.execute("COMMIT")
        except BaseException:
            conn.execute("ROLLBACK")
            raise
        finally:
            conn.close()
    except Exception as exc:
        print(f"notice_emit {kind}: {exc}", file=sys.stderr)


def _news_edition_notice(edition):
    """One visual notice per summary, ready or not (never a waiting request)."""
    import news_editions
    eid = str((edition or {}).get("id") or "")
    if eid:
        title, body = news_editions.notice_text(edition)
        notice_emit("news_edition", title, body, source_event_id="news-edition:" + eid)


def usage_alert_send(message, title=None, kind="info", project=None):
    """Entrega una alerta de uso por los MISMOS canales que las notificaciones
    normales: el popup PROPIO de ComandOS (cc-notifyd; jamas el popup plano
    de GNOME). Telegram ya no forma parte de ComandOS."""
    notice_emit("usage_alert", title or "Límite de uso", message, project or "Uso")
    conf = read_conf()
    if conf.get("DESKTOP_NOTIFY", "1") == "1":
        try:
            payload = json.dumps({
                "title": title or "Límite de uso", "body": message, "session": "",
                "kind": kind, "project": project or "Uso", "options": "",
                "full": message,
            }).encode()
            urllib.request.urlopen(urllib.request.Request(
                "http://127.0.0.1:4778/notify", data=payload,
                headers={"Content-Type": "application/json"}), timeout=2)
        except Exception:
            pass


def desktop_popup(title, body, project, kind="waiting"):
    """Popup propio de ComandOS (cc-notifyd) si «Popups de escritorio» está encendido.
    La web no puede hablarle directo a :4778 (CORS); pasa por aquí (POST /notify-popup)."""
    if read_conf().get("DESKTOP_NOTIFY", "1") != "1":
        return False
    payload = json.dumps({"title": str(title)[:200], "body": str(body)[:400], "session": "",
                          "kind": "waiting" if kind == "waiting" else "done",
                          "project": str(project)[:80], "options": "", "full": str(body)[:400]}).encode()
    try:
        urllib.request.urlopen(urllib.request.Request(
            "http://127.0.0.1:4778/notify", data=payload,
            headers={"Content-Type": "application/json"}), timeout=2)
        return True
    except Exception:
        return False


def _claude_account_creds():
    """[(alias, creds_path)]: main (~/.claude) + cada ~/.claude-accounts/<alias>.
    Descubrimiento por convencion de directorios — nada hardcodeado."""
    out = [("main", os.path.expanduser("~/.claude/.credentials.json"))]
    base = os.path.expanduser("~/.claude-accounts")
    try:
        for name in sorted(os.listdir(base)):
            path = os.path.join(base, name, ".credentials.json")
            if not name.endswith(".lock") and os.path.isfile(path):
                out.append((name, path))
    except OSError:
        pass
    return out


def claude_accounts():
    """[{alias, dir, email, loggedIn}] — main (~/.claude) + ~/.claude-accounts/<alias>
    (tambien las recien creadas sin login, para que se vean como 'pendiente')."""
    out = [{"alias": "main", "dir": os.path.expanduser("~/.claude")}]
    base = os.path.expanduser("~/.claude-accounts")
    try:
        for name in sorted(os.listdir(base)):
            d = os.path.join(base, name)
            if name.startswith(("-", ".")) or name.endswith(".lock") or not os.path.isdir(d):
                continue
            out.append({"alias": name, "dir": d})
    except OSError:
        pass
    for a in out:
        a["loggedIn"] = os.path.isfile(os.path.join(a["dir"], ".credentials.json"))
        a["email"] = account_email_for_dir(a["dir"], "claude") if a["loggedIn"] else ""
    return out


def _proc_cmdline(pid):
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as f:
            return [x.decode("utf-8", "replace") for x in f.read().split(b"\0") if x]
    except Exception:
        return []


# Cuotas declaradas por el USUARIO para providers sin API de limites (Grok).
# Solo numeros de tokens; nada sensible. Editable desde la UI (definir limite).
QUOTAS_FILE = os.path.join(HOOKS, "provider-quotas.json")
_quotas_lock = threading.Lock()


def user_quotas():
    try:
        with open(QUOTAS_FILE) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


# Lo que el USUARIO paga de suscripcion por proveedor (para ROI) + moneda de
# despliegue. Solo montos declarados; nada de datos de tarjetas ni cuentas.
SUBS_FILE = os.path.join(HOOKS, "provider-subs.json")
SUB_CURRENCIES = ("USD", "MXN", "EUR")


def user_subs():
    try:
        with open(SUBS_FILE) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def set_user_sub(provider, monthly, currency, display=None):
    if provider and provider not in ("claude", "codex", "grok"):
        raise ValueError("provider desconocido")
    with _quotas_lock:
        data = user_subs()
        subs = data.setdefault("subs", {})
        if provider:
            amount = round(max(0.0, float(monthly or 0)), 2)
            cur = str(currency or "USD").upper()
            if cur not in SUB_CURRENCIES:
                raise ValueError("moneda no soportada")
            if amount:
                subs[provider] = {"monthly": amount, "currency": cur}
            else:
                subs.pop(provider, None)
        if display:
            cur = str(display.get("currency") or "USD").upper()
            if cur not in SUB_CURRENCIES:
                raise ValueError("moneda no soportada")
            rate = float(display.get("usdRate") or 0)
            data["display"] = {"currency": cur,
                               "usdRate": round(rate, 4) if rate > 0 else None}
        write_json_file(SUBS_FILE, data, indent=1)
        return data


def set_user_quota(provider, tokens_7d):
    if provider not in ("grok", "groq"):
        raise ValueError("provider sin cuota configurable")
    tokens = max(0, int(tokens_7d or 0))
    with _quotas_lock:
        data = user_quotas()
        if tokens:
            data[provider] = {"tokens_7d": tokens, "set_at": int(time.time())}
        else:
            data.pop(provider, None)
        write_json_file(QUOTAS_FILE, data, indent=1)
    return data.get(provider)


# ---- Navegador de carpetas del wizard: SOLO lectura de nombres de
# directorios bajo $HOME, y mkdir confinado a $HOME. Nada de archivos.
FS_HOME = os.path.realpath(os.path.expanduser("~"))


def _fs_safe(path):
    """Path absoluto real, o None si sale de $HOME."""
    try:
        real = os.path.realpath(os.path.expanduser(str(path or "~")))
    except Exception:
        return None
    if real != FS_HOME and not real.startswith(FS_HOME + os.sep):
        return None
    return real


def fs_dirs(path):
    """Estado del path + subcarpetas del ancestro existente mas cercano.
    Si el path no existe, dice exactamente que parte falta (para crearla)."""
    raw = str(path or "~")
    real = _fs_safe(raw)
    if real is None:
        return {"error": "fuera de tu carpeta de usuario"}
    exists = os.path.isdir(real)
    base = real
    missing = ""
    while base and not os.path.isdir(base):
        base, tail = os.path.split(base)
        missing = tail + (os.sep + missing if missing else "")
    frag = "" if exists else missing.split(os.sep)[0].lower()
    dirs = []
    try:
        with os.scandir(base) as it:
            for e in it:
                try:
                    if not e.is_dir(follow_symlinks=False):
                        continue
                except OSError:
                    continue
                if e.name.startswith(".") and not frag.startswith("."):
                    continue
                if frag and not e.name.lower().startswith(frag):
                    continue
                dirs.append(e.name)
    except OSError:
        pass
    dirs.sort(key=str.lower)
    return {"path": real, "exists": exists, "base": base,
            "parent": os.path.dirname(base) if base != FS_HOME else "",
            "missing": missing,
            "home": FS_HOME,
            "dirs": [{"name": n, "path": os.path.join(base, n)} for n in dirs[:150]]}


def fs_mkdir(path):
    real = _fs_safe(path)
    if real is None:
        raise ValueError("solo puedo crear carpetas dentro de tu carpeta de usuario")
    if os.path.isdir(real):
        return real
    if os.path.exists(real):
        raise ValueError("ya existe un ARCHIVO con ese nombre")
    os.makedirs(real, exist_ok=False)
    return real


# ---- Watcher de modelos: siempre saber lo MAS RECIENTE de cada CLI ----
MODEL_WATCH_FILE = os.path.join(HOOKS, "model-watch.json")
_model_watch_state = {"versions": {}, "last_full": 0.0, "catalog": None}
# Un solo ciclo a la vez: el loop, POST /models/refresh y ?refresh=1 comparten
# este lock (snapshot .tmp, noticias, latido y _model_watch_state no se pisan).
_MODEL_WATCH_LOCK = threading.Lock()


def _model_watch_notify(news, versions):
    for prov, models in news.items():
        body = ", ".join(models[:4]) + ("…" if len(models) > 4 else "")
        detail = ("detectados en el binario; disponibilidad sin verificar" if prov == "claude"
                  else "detectados en el CLI; los catálogos locales actualizan el selector")
        notice_emit("announcement", f"Modelos nuevos de {prov} detectados",
                    f"{body} (CLI {versions.get(prov, '?')}) — {detail}")
        try:
            urllib.request.urlopen(urllib.request.Request(
                "http://127.0.0.1:4778/notify",
                data=json.dumps({"title": f"Modelos nuevos de {prov} detectados",
                                 "kind": "info", "project": "modelos",
                                 "body": f"{body} (CLI {versions.get(prov, '?')}) — {detail}"}).encode(),
                headers={"Content-Type": "application/json"}), timeout=3)
        except Exception:
            pass


def _model_watch_cycle(force=False):
    with _MODEL_WATCH_LOCK:
        return _model_watch_cycle_locked(force)


def _model_watch_cycle_locked(force=False):
    """Chequeo barato de versiones cada vuelta; escaneo COMPLETO de binarios
    al cambiar versión/catálogo local o cada 6 h. Novedades -> popup."""
    try:
        versions = model_watch_lib.installed_versions()
        catalog = model_catalog_lib.catalog_signature()
        changed = (versions != _model_watch_state["versions"] or
                   catalog != _model_watch_state.get("catalog"))
        due = time.time() - _model_watch_state["last_full"] > 6 * 3600
        if force or changed or due:
            # comandos presentes en cada binario (barra de comandos): se calienta
            # aquí para que la primera petición no lea cientos de MB
            try:
                with _CLI_CATALOG_LOCK:
                    if _CLI_CATALOG["catalog"] is None:
                        _CLI_CATALOG["catalog"] = cli_catalog.load_catalog()
                    cli_catalog.detected_commands(_CLI_CATALOG["catalog"])
                    for _cli in _CLI_CATALOG["catalog"]["clis"]:
                        cli_help.help_for(_cli["binary"])
            except Exception:
                pass
            result = model_watch_lib.watch_models(
                HOOKS, PROVIDERS_FILE, grok_home=os.path.expanduser("~/.grok"))
            _model_watch_state["last_full"] = time.time()
            _model_watch_state["catalog"] = model_catalog_lib.catalog_signature()
            if result.get("news"):
                _model_watch_notify(result["news"], versions)
            # noticias de skills/MCPs (patrón Radar): mismas vueltas de 6h
            try:
                nres = news_watch_lib.watch_news(HOOKS)
                fresh = nres.get("news") or []
                if fresh:
                    top = fresh[0]
                    notice_emit("announcement", f"Noticias de skills/MCPs ({len(fresh)})", top.get("title", "")[:140])
                    urllib.request.urlopen(urllib.request.Request(
                        "http://127.0.0.1:4778/notify",
                        data=json.dumps({"title": f"Noticias de skills/MCPs ({len(fresh)})",
                                         "kind": "info", "project": "noticias",
                                         "body": top.get("title", "")[:140]}).encode(),
                        headers={"Content-Type": "application/json"}), timeout=3)
            except Exception:
                pass
            _model_watch_state["versions"] = versions
            try:
                snap = _read_json_quiet(MODEL_WATCH_FILE) or {}
                snap["heartbeatAt"] = int(time.time())
                write_json_file(MODEL_WATCH_FILE, snap, indent=1)
            except Exception:
                pass
            return result
        _model_watch_state["versions"] = versions
        # latido: aunque el ciclo sea el barato (solo versiones), deja
        # constancia de que el watcher VIVE — visible en /models/latest
        try:
            snap = _read_json_quiet(MODEL_WATCH_FILE) or {}
            snap["heartbeatAt"] = int(time.time())
            snap.setdefault("versions", versions)
            write_json_file(MODEL_WATCH_FILE, snap, indent=1)
        except Exception:
            pass
    except Exception:
        pass
    return None


def _model_watch_loop():
    time.sleep(90)          # no competir con el arranque
    while True:
        _model_watch_cycle()
        time.sleep(600)     # versiones cada 10 min; binarios al cambiar o 6h


# ---- N5: ediciones de novedades (tres al día, con fuentes) ----
# Leer nunca genera: /news/editions y /news/edition solo consultan SQLite. El
# scheduler arranca en main() y queda inerte sin HOOKS/news-editions.json.
_NEWS_LOCAL = threading.local()
_NEWS_EDITION_ID_RE = re.compile(r"^\d{4}-\d{2}-\d{2}@\d{2}:\d{2}$")
_news_scheduler = None


def news_editions_config_path():
    return os.path.join(HOOKS, "news-editions.json")


def news_conn():
    conn = getattr(_NEWS_LOCAL, "conn", None)
    if conn is None:
        conn = app_state.connect()
        app_state.migrate(conn)
        _NEWS_LOCAL.conn = conn
    return conn


def news_editions_payload():
    import news_editions
    config = news_editions.load_config(news_editions_config_path())
    status = news_editions.config_status(config)
    policy = news_editions.policy_from_config(config)
    conn = news_conn()
    latest = news_editions.latest_readable(conn)
    now_ms = int(time.time() * 1000)
    editions = news_editions.list_editions(conn, 30, until_ms=now_ms)
    summarizer = (config or {}).get("summarizer") if isinstance((config or {}).get("summarizer"), dict) else {}
    steps = summarizer.get("steps") if summarizer.get("kind") == "chain" else [summarizer] if summarizer else []
    chain = [f"{st.get('agent') or st.get('kind')}:{st.get('model') or 'predeterminado'}"
             for st in steps if isinstance(st, dict)]
    return {**status, "latest": latest["id"] if latest else None, "editions": editions,
            "next": news_editions.next_scheduled(conn, now_ms), "chain": chain,
            "policy": {k: policy[k] for k in ("timezone", "slots", "maxSources", "budgetUsd")}}


def news_edition_payload(edition_id):
    import news_editions
    import news_reading
    conn = news_conn()
    if edition_id == "latest":
        latest = news_editions.latest_readable(conn)
        if not latest:
            return 404, {"error": "Aún no hay ediciones publicadas."}
        edition_id = latest["id"]
    if not _NEWS_EDITION_ID_RE.match(edition_id or ""):
        return 400, {"error": "Edición inválida"}
    found = news_editions.get_edition(conn, edition_id)
    if not found:
        return 404, {"error": "Edición no encontrada"}
    counts = news_reading.story_counts(conn, [st["id"] for st in found["stories"]])
    for st in found["stories"]:
        st["counts"] = counts.get(st["id"], {"notes": 0, "chat": 0, "saved": False})
    return 200, found


# Lectura de una noticia: fuente capturada, traducción, chat, notas y guardadas.
# Chat y traducción corren en hilos (el agente tarda); el lector consulta.
_NEWS_MEDIA_RE = re.compile(r"^[0-9a-f]{32}\.(png|jpg|webp|gif|avif)$")
_NEWS_MEDIA_TYPES = {"png": "image/png", "jpg": "image/jpeg", "webp": "image/webp", "gif": "image/gif",
                     "avif": "image/avif"}
_NEWS_AGENTS = threading.Semaphore(2)


def _news_int(value):
    try:
        number = int(str(value))
    except (TypeError, ValueError):
        return None
    return number if 0 < number < 2**53 else None


def _news_asker():
    import news_editions
    return news_editions.make_asker(news_editions.load_config(news_editions_config_path()))


def _news_agent_job(work):
    """Corre work(conn, ask) en un hilo con su propia conexión."""
    ask = _news_asker()                       # falla aquí (sin cadena) antes de prometer nada

    def run():
        with _NEWS_AGENTS:
            conn = app_state.connect()
            try:
                app_state.migrate(conn)
                work(conn, ask)
            except Exception as exc:
                sys.stderr.write(f"cc-dash news agent: {exc!r}\n")
            finally:
                conn.close()
    threading.Thread(target=run, daemon=True).start()


def news_get(path, query):
    import news_editions
    import news_reading
    conn = news_conn()
    if path == "/news/source":
        sid = _news_int((query.get("id") or [""])[0])
        src = news_editions.get_source(conn, sid) if sid else None
        if not src:
            return 404, {"error": "Fuente no encontrada"}
        src["translation"] = news_reading.translation(conn, sid, "es")
        return 200, src
    if path == "/news/chat":
        story = _news_int((query.get("story") or [""])[0])
        if not story or not news_reading.story_row(conn, story):
            return 404, {"error": "Noticia no encontrada"}
        return 200, {"messages": news_reading.chat_history(conn, story)}
    if path == "/news/notes":
        story = _news_int((query.get("story") or [""])[0])
        return 200, news_reading.list_notes(conn, story_id=story, query=(query.get("q") or [""])[0][:200])
    if path == "/news/saved":
        return 200, {"stories": news_reading.saved_stories(conn)}
    return 404, {"error": "Ruta desconocida"}


def news_media(name):
    import news_editions
    if not _NEWS_MEDIA_RE.match(name or ""):
        return None, None
    path = os.path.join(news_editions.media_dir(), name)
    try:
        with open(path, "rb") as fh:
            return _NEWS_MEDIA_TYPES[name.rsplit(".", 1)[1]], fh.read()
    except OSError:
        return None, None


def news_post(path, data):
    import news_reading
    conn = news_conn()
    try:
        if path == "/news/saved":
            story = _news_int(data.get("storyId"))
            got = news_reading.set_saved(conn, story, bool(data.get("saved"))) if story else None
            return (200, {"saved": got}) if got is not None else (404, {"error": "Noticia no encontrada"})
        if path == "/news/notes":
            action = data.get("action")
            if action == "add":
                return 200, {"note": news_reading.add_note(conn, _news_int(data.get("storyId")), data.get("text"))}
            if action == "update":
                return 200, {"note": news_reading.update_note(conn, _news_int(data.get("noteId")), data.get("text"))}
            if action == "delete":
                return 200, {"deleted": news_reading.delete_note(conn, _news_int(data.get("noteId")))}
            return 400, {"error": "Acción de nota desconocida"}
        if path == "/news/chat/note":
            return 200, news_reading.toggle_chat_note(conn, _news_int(data.get("chatId")))
        if path == "/news/chat":
            story = _news_int(data.get("storyId"))
            try:
                _news_asker()
            except RuntimeError as exc:
                return 503, {"error": str(exc)}
            pending = news_reading.start_chat(conn, story, data.get("message"))
            _news_agent_job(lambda c, ask: news_reading.run_chat(c, story, pending, ask))
            return 200, {"messages": news_reading.chat_history(conn, story)}
        if path == "/news/translate":
            sid = _news_int(data.get("sourceId"))
            try:
                _news_asker()
            except RuntimeError as exc:
                return 503, {"error": str(exc)}
            start, state = news_reading.start_translation(conn, sid)
            if start:
                _news_agent_job(lambda c, ask: news_reading.run_translation(c, sid, ask))
            return 200, {"translation": state}
    except LookupError as exc:
        return 404, {"error": str(exc).strip("'")}
    except ValueError as exc:
        return 400, {"error": str(exc)}
    except RuntimeError as exc:
        return 409, {"error": str(exc)}
    return 404, {"error": "Ruta desconocida"}


# ---- N4: Web Push al Android (suscripción y prueba son acciones explícitas) ----
# El envío automático lo conecta el integrador con push_dispatch(events, clients,
# policy=<política N2>); sin pywebpush /push/key responde "no disponible".
_PUSH_LOCAL = threading.local()
_PUSH_TEST_LAST = {}
PUSH_TEST_INTERVAL_S = 10.0

# ---- N2: shared notice policy (lib/notification_delivery.py) ----------------
_NOTICES_LOCAL = threading.local()
NOTICE_PUSH_INTERVAL_S = 15


def notices_conn():
    conn = getattr(_NOTICES_LOCAL, "conn", None)
    if conn is None:
        conn = app_state.connect()
        app_state.migrate(conn)
        _NOTICES_LOCAL.conn = conn
    return conn


def notices_focus_active():
    """D5: during an active focus block only permissions sound."""
    import notification_delivery
    return notification_delivery.focus_block_active(notices_conn())


def notices_is_live():
    """(sesión, pane) -> ¿esa terminal sigue viva? Para no contar pedidos de terminales cerradas."""
    try:   # una consulta directa a tmux (ms); read_states tarda ~1 s y frenaba /notices/watch
        r = tmux("list-panes", "-a", "-F", "#{session_name}\t#{pane_id}")
        if r.returncode != 0:
            return None                  # sin tmux legible: no se filtra nada
        live = {tuple(line.split("\t", 1)) for line in r.stdout.splitlines() if "\t" in line}
    except Exception:
        return None
    sessions = {s for s, _ in live}
    return lambda s, p: (s, p or "") in live if p else s in sessions


def notices_now():
    return int(time.time() * 1000)


# The desktop's own speaker (same device id as the hook and cc-app): events
# no hook sees, like a Pomodoro focus end, still sound here when it wins.
DESKTOP_DEVICE = "desktop-" + re.sub(r"[^A-Za-z0-9_.-]", "-", os.uname().nodename or "local")[:60]
DESKTOP_NOTICE_SOUND = "/usr/share/sounds/freedesktop/stereo/complete.oga"
# Fin del Pomodoro en esta máquina: jingle 8-bit propio (grill 30-sep: el
# tintineo del sistema era de 1 s y casi no se oía).
POMODORO_END_SOUND = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
                                  "assets", "sounds", "pomodoro-complete.wav")


def _play_local_sound(path, volume=None):
    """volume 0..1 (preferencias de avisos). pipewire-pulse ignora el --volume
    de paplay, así que pw-play va primero cuando hay que atenuar."""
    players = [["paplay", path], ["pw-play", path], ["afplay", path]]
    if volume is not None:
        v = max(0.0, min(1.0, float(volume)))
        players = [["pw-play", f"--volume={v:.2f}", path], ["paplay", f"--volume={int(v * 65536)}", path],
                   ["afplay", "-v", f"{v:.2f}", path]]
    for player in players:
        if shutil.which(player[0]) and os.path.exists(path):
            subprocess.Popen(player, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return True
    return False


def _desktop_notice_sound(event_id, db_file=None):
    import notification_delivery
    conn = app_state.connect(db_file) if db_file else notices_conn()
    now = notices_now()
    pomodoro = event_id.startswith("pomodoro:")
    for device in (DESKTOP_DEVICE, notification_delivery.LOCAL_SPEAKER):
        if notification_delivery.claim_sound(conn, event_id, device, now)["play"]:
            if pomodoro:
                volume = notification_delivery.load_prefs(conn).get("volume", 0.6)
                _play_local_sound(POMODORO_END_SOUND, volume)
            else:
                _play_local_sound(DESKTOP_NOTICE_SOUND)
            return True
    return False


def _notices_push_loop():
    """Push unread notices when no client was visible for 2 min (D5), through
    the same route_event policy the strip, floats and sounds use."""
    import notification_delivery
    import web_push
    time.sleep(30)
    while True:
        try:
            if web_push.available()[0]:
                conn = notices_conn()
                now = notices_now()
                window = event_store.list_events(conn, max(0, event_store.latest_sequence(conn) - 200), 200)
                read = {r[0] for r in conn.execute("SELECT event_id FROM notice_reads")}
                policy = notification_delivery.push_policy(notification_delivery.load_prefs(conn),
                                                           notices_focus_active(), read)
                push_dispatch(window, notification_delivery.clients(conn, now), policy, now)
        except Exception as exc:
            print(f"notices push: {exc}", file=sys.stderr)
        time.sleep(NOTICE_PUSH_INTERVAL_S)


def push_conn():
    conn = getattr(_PUSH_LOCAL, "conn", None)
    if conn is None:
        conn = app_state.connect()
        app_state.migrate(conn)
        _PUSH_LOCAL.conn = conn
    return conn


def _push_send(subscription, payload):
    import web_push
    return web_push.send_push(subscription, payload)


def push_key_payload():
    import web_push
    ok, reason = web_push.available()
    if not ok:
        return 503, {"available": False, "error": reason}
    return 200, {"available": True, "publicKey": web_push.load_or_create_vapid().public_key}


def push_subscription_write(method, data):
    import web_push
    ok, reason = web_push.available()
    if not ok:
        return 503, {"ok": False, "error": reason}
    conn = push_conn()
    if method == "DELETE":
        return 200, {"ok": True, "removed": web_push.remove_subscription(conn, str(data.get("endpoint") or ""))}
    try:
        sid = web_push.save_subscription(conn, data.get("subscription"),
                                         device_id=str(data.get("deviceId") or "") or None,
                                         user_agent=str(data.get("userAgent") or "") or None)
    except ValueError as exc:
        return 400, {"ok": False, "error": str(exc)}
    return 200, {"ok": True, "id": sid}


def push_test(data):
    import web_push
    ok, reason = web_push.available()
    if not ok:
        return 503, {"ok": False, "error": reason}
    endpoint = str(data.get("endpoint") or "")
    if not web_push.find_subscription(push_conn(), endpoint):
        return 404, {"ok": False, "error": "Este dispositivo no tiene una suscripción activa."}
    now = time.monotonic()
    if now - _PUSH_TEST_LAST.get(endpoint, -1e9) < PUSH_TEST_INTERVAL_S:
        return 429, {"ok": False, "error": "Espera unos segundos antes de otra prueba."}
    try:
        result = web_push.run_test(push_conn(), endpoint, _push_send)
    except LookupError as exc:
        return 404, {"ok": False, "error": str(exc)}
    _PUSH_TEST_LAST[endpoint] = now
    return 200, result


def push_dispatch(events, clients, policy=None, now_ms=None):
    """Send due pushes for N1 events; `policy(event, clients, now_ms)` is the
    shared N2 policy (default: D5, no visible client for 2 min)."""
    import web_push
    if not web_push.available()[0]:
        return []
    return web_push.send_due_push(push_conn(), int(now_ms or time.time() * 1000),
                                  policy or web_push.default_policy, events, clients, sender=_push_send)


def _news_editions_loop():
    import news_editions
    global _news_scheduler
    def connect():
        conn = app_state.connect()
        app_state.migrate(conn)
        return conn
    import news_radar
    import news_reading

    def recent_urls():
        conn = connect()
        try:
            return news_editions.recent_story_urls(conn, int(time.time() * 1000) - 48 * 3600 * 1000)
        finally:
            conn.close()
    boot = connect()
    try:
        news_reading.recover(boot)
    finally:
        boot.close()
    _news_scheduler = news_editions.EditionScheduler(
        connect, news_editions_config_path(), news_watch_lib, notify=_news_edition_notice,
        fetch=news_editions.make_radar_fetcher(news_radar, recent_urls=recent_urls))
    time.sleep(120)
    while True:
        try:
            _news_scheduler.tick()
        except Exception as exc:
            sys.stderr.write(f"cc-dash news editions: {exc!r}\n")
        time.sleep(60)


def _refresh_provider_limits():
    global _limits_refreshing
    try:
        codex_rows = cc_usage.read_codex_rate_limits()
        claude_rows, healths = [], {}
        for alias, path in _claude_account_creds():
            rows, health = cc_usage.fetch_claude_oauth_limits(creds_path=path)
            email = account_email_for_dir(os.path.dirname(path), "claude")
            for r in rows:
                r["account"] = alias
                if email:
                    r["accountEmail"] = email
                if alias != "main":
                    r["id"] = f"{alias}:{r.get('id', '')}"
            if not rows and health.get("status") == "error":
                # Fetch fallido (p.ej. 429): conservar el ultimo dato bueno DE
                # ESA cuenta. captured_at delata su edad y la UI la muestra.
                with _limits_lock:
                    rows = [r for r in _limits_cache["limits"]
                            if r.get("provider") == "claude"
                            and (r.get("account") or "main") == alias]
                health["stale"] = bool(rows)
            key = "claude_oauth" if alias == "main" else f"claude_oauth:{alias}"
            health["account"] = alias
            healths[key] = health
            claude_rows += rows
        # Grok: xAI no expone limites por API — mostramos consumo MEDIDO local
        # (usage_turns provider='grok'). Si el usuario configuro su cuota
        # semanal (provider-quotas.json), calculamos % usado y cuanto queda.
        grok_rows = []
        try:
            gm = cc_usage.grok_measured_usage(USAGE_DB)
        except Exception:
            gm = None
        # Limite OFICIAL: el CLI de grok escribe creditUsagePercent + periodo
        # semanal + tier en su log local. Si esta vigente, ese % manda; la
        # cuota declarada por el usuario queda como respaldo.
        official = None
        try:
            official = cc_usage.read_grok_credit_limits(
                [str(home) for _alias, home in grok_state.account_homes()] or None)
        except Exception:
            official = None
        if official and official.get("stale_period"):
            # La semana de grok ya venció y grok no ha vuelto a correr: la semana nueva va en 0 %.
            # Sus periodos son semanas seguidas, así que el reset es el fin viejo + N semanas.
            now = int(time.time())
            weeks = -(-(now - official["resets_at"]) // (7 * 86400)) or 1
            official = {**official, "percent": 0.0, "resets_at": official["resets_at"] + weeks * 7 * 86400}
        if gm or official:
            gm = gm or {"tokens_today": 0, "turns_today": 0, "tokens_7d": 0,
                        "turns_7d": 0, "daily": []}
            quota = int((user_quotas().get("grok") or {}).get("tokens_7d") or 0)
            if official:
                pct = round(float(official["percent"]), 1)
                resets = official["resets_at"]
                conf, label = "exact", "Semana"
                plan = official.get("tier") or ""
                captured = official["captured_at"]
                note = "creditUsagePercent oficial del CLI de grok (log local)"
            else:
                pct = round(gm["tokens_7d"] / quota * 100, 1) if quota > 0 else None
                resets, conf, label, plan = 0, "measured", "Consumo medido", ""
                captured = int(time.time())
                note = "sin dato oficial reciente — abre grok para refrescarlo"
            grok_rows.append({
                "id": "grok_measured", "provider": "grok",
                "kind": "window" if official else "measured",
                "label": label, "scope": "", "percent": pct,
                "resets_at": resets, "severity": "info", "is_active": True,
                "window": "7d", "source": "grok_cli_log" if official else "local",
                "confidence": conf, "captured_at": captured, "account": "main",
                "plan_type": plan or None,
                "tokens_today": gm["tokens_today"], "turns_today": gm["turns_today"],
                "tokens_7d": gm["tokens_7d"], "turns_7d": gm["turns_7d"],
                "daily": gm.get("daily") or [], "quota_7d": quota or None,
                "note": note,
            })
        groq_rows = _groq_limit_rows()
        # agy: cuota que su barra de estado le pasa a adapters/agy-statusline.py (cc-agents setup).
        try:
            agy_rows = cc_usage.read_agy_quota(AGY_QUOTA_FILE, now=time.time())
        except Exception:
            agy_rows = []
        try:
            cc_usage.record_quota_snapshots(USAGE_DB, claude_rows + codex_rows + grok_rows + agy_rows)
        except Exception:
            pass
        with _limits_lock:
            _limits_cache["at"] = int(time.time())
            _limits_cache["limits"] = claude_rows + codex_rows + grok_rows + agy_rows + groq_rows
            _limits_cache["health"] = healths
    finally:
        with _limits_lock:
            _limits_refreshing = False


GROQ_RATELIMIT_FILE = os.path.join(HOOKS, "groq-ratelimit.json")
AGY_QUOTA_FILE = os.path.join(HOOKS, "agy-quota.json")


def read_groq_rate_limits():
    """Últimos x-ratelimit-* de Groq (si OpenCode/un probe los guardó). Sin
    inventar cuota: si no hay archivo, la card es consumo medido local."""
    try:
        with open(GROQ_RATELIMIT_FILE) as fh:
            data = json.load(fh)
        headers = data.get("headers") if isinstance(data, dict) else None
        captured = int(data.get("at") or 0) if isinstance(data, dict) else 0
        if not isinstance(headers, dict):
            return []
        rows = cc_usage.parse_groq_ratelimit_headers(headers, now=captured or None)
        for row in rows:
            row["account"] = "main"
        return rows
    except Exception:
        return []


def _groq_limit_rows():
    rows = []
    try:
        gm = cc_usage.groq_measured_usage(USAGE_DB)
    except Exception:
        gm = None
    headers = read_groq_rate_limits()
    if not gm and not headers:
        return rows
    gm = gm or {"tokens_today": 0, "turns_today": 0, "tokens_7d": 0,
                "turns_7d": 0, "daily": []}
    quota = int((user_quotas().get("groq") or {}).get("tokens_7d") or 0)
    if headers:
        rows.extend(headers)
    pct = round(gm["tokens_7d"] / quota * 100, 1) if quota > 0 else None
    rows.append({
        "id": "groq_measured", "provider": "groq",
        "kind": "measured", "label": "Consumo medido", "scope": "",
        "percent": pct, "resets_at": 0, "severity": "info", "is_active": True,
        "window": "7d", "source": "local", "confidence": "measured",
        "captured_at": int(time.time()), "account": "main",
        "tokens_today": gm["tokens_today"], "turns_today": gm["turns_today"],
        "tokens_7d": gm["tokens_7d"], "turns_7d": gm["turns_7d"],
        "daily": gm.get("daily") or [], "quota_7d": quota or None,
        "note": (" Groq x-ratelimit de la última respuesta" if headers else
                 "sin API de cuota — declara un límite o pega headers x-ratelimit-*"),
    })
    return rows


def usage_provider_limits(force=False):
    global _limits_refreshing
    if force:
        with _limits_lock:
            _limits_refreshing = True
        _refresh_provider_limits()
    else:
        with _limits_lock:
            health = _limits_cache["health"].get("claude_oauth") or {}
            ttl = LIMITS_TTL * 3 if health.get("status") == "error" else LIMITS_TTL
            stale = time.time() - _limits_cache["at"] > ttl
            start = stale and not _limits_refreshing
            if start:
                _limits_refreshing = True
        if start:
            threading.Thread(target=_refresh_provider_limits, daemon=True).start()
    with _limits_lock:
        return {"limits": list(_limits_cache["limits"]),
                "health": dict(_limits_cache["health"])}


def _limits_snapshot_loop():
    """Lee los límites cada 5 min aunque nadie abra el tablero: así la última foto de cada
    ciclo semanal queda a ≤5 min de su reset (Comparar → «cuota que sobra»)."""
    while True:
        try:
            usage_provider_limits()
        except Exception:
            pass
        time.sleep(300)


