_side_head.pack_start(_side_prev, False, False, 0)
_side_head.pack_start(_side_tabs_sw, True, True, 0)
_side_head.pack_start(_side_next, False, False, 0)
_side_head.pack_start(_side_plus, False, False, 0)
_side_head.pack_end(_side_tog, False, False, 0)
