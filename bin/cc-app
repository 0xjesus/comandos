# ⊞ «varias filas» (1-oct): la misma tira envuelta para ver todas las pestañas;
# pref compartida tabs_layout (row | rows), igual en el remoto (#tab-rows).
TABS_LAYOUT = {"mode": "row"}


def apply_tabs_layout(mode, persist=True):
    mode = "rows" if mode == "rows" else "row"
    if mode != TABS_LAYOUT["mode"]:
        TABS_LAYOUT["mode"] = mode
        nb.set_rows(mode == "rows")
        for b in (_tab_prev, _tab_next):
            b.set_visible(mode == "row")
    rows = mode == "rows"
    _rows_btn.set_image(_themed_icon_image("rows", 18, THEME.get("brand") if rows else None))
    _rows_btn.set_tooltip_text(("Una fila" if rows else "Varias filas") if ES else ("One row" if rows else "Several rows"))
    if persist:
        def _save():
            try:
                request = urllib.request.Request(BASE_URL + "/prefs-set", data=json.dumps({"tabs_layout": mode}).encode(),
                                                 headers={"Content-Type": "application/json"}, method="POST")
                urllib.request.urlopen(request, timeout=5).read()
            except Exception:
                pass
        threading.Thread(target=_save, daemon=True).start()
    return False


_rows_btn = _icon_btn("rows", "Varias filas" if ES else "Several rows",
                      lambda *_: apply_tabs_layout("row" if TABS_LAYOUT["mode"] == "rows" else "rows"), size=18)
_rows_btn.get_style_context().add_class("cc-key")
_rows_btn.get_style_context().add_class("cc-key-rows")
_strip_actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
_strip_actions.get_style_context().add_class("strip-actions")
for _b in (_quick_term_btn, _plus, _sort_btn, _rows_btn, _tab_next):
    _strip_actions.pack_start(_b, False, False, 0)
_strip_actions.show_all()
nb.set_action_widget(_strip_actions, Gtk.PackType.END)
if (PREFS.get("tabs_layout") if isinstance(PREFS, dict) else None) == "rows":
    apply_tabs_layout("rows", False)
_headerbar.show_all()

# Puente tablero -> app: las tarjetas piden abrir pestanas aqui
ucm = WebKit2.UserContentManager()


_WEBMODAL = {"win": None, "wv": None, "title": None}


def open_web_modal(url, label=""):
    """Navegador MODAL ultraligero: UN solo WebView cacheado que se reutiliza
    para todos los links (cero procesos web nuevos por click). Esc lo oculta
    sin destruirlo — reabrir es instantaneo."""
    if _WEBMODAL["win"] is None:
        dlg = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        dlg.set_transient_for(win)
        dlg.set_modal(True)
        dlg.set_decorated(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.get_style_context().add_class("mosaic-zoom")
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.get_style_context().add_class("mosaic-head")
        tl = Gtk.Label(xalign=0)
        tl.set_ellipsize(Pango.EllipsizeMode.END)
        head.pack_start(tl, True, True, 8)
        xb = _icon_btn("close", "Cerrar (Esc)" if ES else "Close (Esc)",
                       lambda *_: dlg.hide(), size=14)
        head.pack_end(xb, False, False, 4)
        box.pack_start(head, False, False, 0)
        wv2 = WebKit2.WebView()
        box.pack_start(wv2, True, True, 0)
        dlg.add(box)
        dlg.connect("key-press-event",
                    lambda _w, ev: (dlg.hide(), True)[1] if ev.keyval == Gdk.KEY_Escape else False)
        dlg.connect("delete-event", lambda *_: (dlg.hide(), True)[1])
        _WEBMODAL.update(win=dlg, wv=wv2, title=tl)
    w, h = win.get_size()
    _WEBMODAL["win"].set_default_size(max(640, w - 120), max(420, h - 90))
    _WEBMODAL["win"].set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
    _WEBMODAL["title"].set_markup(
        f'<span weight="bold"> 🌐 {GLib.markup_escape_text((label or url)[:80])}</span>'
        f'<span foreground="#8A8F98" size="small">  · Esc {"cierra" if ES else "closes"}</span>')
    _WEBMODAL["wv"].load_uri(url)
    _WEBMODAL["win"].show_all()
    return False


# Modal «Cadenas» del escritorio (fase 2, mockup aprobado: modal centrado). El
# tablero es solo la columna izquierda del paned, así que su overlay no puede
# cubrir las terminales VTE: aquí la misma página (?panel=chains) se abre en una
# ventana modal centrada sobre la app. Un solo WebView, se oculta al cerrar.
_CHAINMODAL = {"win": None, "wv": None}


def open_chain_modal(*_):
    if _CHAINMODAL["win"] is None:
        dlg = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        dlg.set_transient_for(win)
        dlg.set_modal(True)
        dlg.set_decorated(False)
        dlg.get_style_context().add_class("mosaic-zoom")
        wv2 = WebKit2.WebView.new_with_user_content_manager(ucm)   # mismo puente «centro»
        try:
            wv2.get_settings().set_property("enable-write-console-messages-to-stdout", True)
        except Exception:
            pass
        dlg.add(wv2)
        dlg.connect("key-press-event",
                    lambda _w, ev: (dlg.hide(), True)[1] if ev.keyval == Gdk.KEY_Escape else False)
        dlg.connect("delete-event", lambda *_: (dlg.hide(), True)[1])
        _CHAINMODAL.update(win=dlg, wv=wv2)
    w, h = win.get_size()
    _CHAINMODAL["win"].set_default_size(min(1040, max(640, w - 120)), min(700, max(420, h - 90)))
    _CHAINMODAL["win"].set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
    page = _cur_page()
    sess = ""
    try:
        term = getattr(page, "_term", None)
        sess = (term_session(term) if term is not None else None) or getattr(page, "_key", None) or ""
    except Exception:
        sess = ""
    pane = _cur_pane_id(sess) if sess and not sess.startswith("xterm-") else ""
    q = urlencode({"panel": "chains", "v": _DASH_V, "session": sess, "pane": pane})
    _CHAINMODAL["wv"].load_uri(f"{BASE_URL}/?{q}")
    _CHAINMODAL["win"].show_all()
    return False


def _chain_modal_msg(d):
    """Mensajes {chainModal: close|saved|run, slug} de la página ?panel=chains."""
    what = d.get("chainModal")
    slug = re.sub(r"[^a-z0-9-]", "", str(d.get("slug") or ""))[:80]
    # guardar también cierra el constructor (como el overlay del remoto)
    if _CHAINMODAL["win"] is not None:
        _CHAINMODAL["win"].hide()
    if what in ("saved", "run"):
        tail = f".then(()=>window.commandSidebar.startChain({json.dumps(slug)}))" if what == "run" and slug else ""
        _dash_js(f"window.commandSidebar&&window.commandSidebar.refresh(){tail}")


HEADER_ACTIONS["chains"] = open_chain_modal


# Analytics (grill 2-oct): el mockup aprobado mide 1120 px y el tablero es solo la columna
# izquierda, así que se abre como Cadenas: una ventana centrada sobre toda la app.
_ANMODAL = {"win": None, "wv": None}


def open_analytics_modal(*_):
    if _ANMODAL["win"] is None:
        dlg = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        dlg.set_transient_for(win)
        # No modal: un clic en la app (la ventana pierde el foco) la cierra, igual que Esc.
        dlg.set_modal(False)
        dlg.set_decorated(False)
        dlg.get_style_context().add_class("mosaic-zoom")
        wv2 = WebKit2.WebView.new_with_user_content_manager(ucm)   # mismo puente «centro»
        dlg.add(wv2)
        dlg.connect("key-press-event",
                    lambda _w, ev: (dlg.hide(), True)[1] if ev.keyval == Gdk.KEY_Escape else False)
        dlg.connect("delete-event", lambda *_: (dlg.hide(), True)[1])
        dlg.connect("focus-out-event", lambda *_: (dlg.hide(), False)[1])
        _ANMODAL.update(win=dlg, wv=wv2)
    w, h = win.get_size()
    _ANMODAL["win"].set_default_size(min(1180, max(640, w - 120)), min(940, max(480, h - 90)))
    _ANMODAL["win"].set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
    q = urlencode({"panel": "usage", "v": _DASH_V})
    _ANMODAL["wv"].load_uri(f"{BASE_URL}/?{q}")
    _ANMODAL["win"].show_all()
    return False


HEADER_ACTIONS["analytics"] = open_analytics_modal


def open_web_tab(url, label=""):
    """Navegador DENTRO de ComandOS: una pestaña WebKit para leer noticias
    sin salir de la app. Cerrable como cualquier pestaña."""
    key = f"web:{url[:120]}"
    if key in tabs:
        ws_select(key)
        return False
    wv2 = WebKit2.WebView()
    wv2.load_uri(url)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    box.pack_start(wv2, True, True, 0)
    box._term = None
    box._webview = wv2
    box._key = key
    box._label = ("🌐 " + (label or url.split("/")[2]))[:40]
    idx = nb.append_page(box, tab_label(box._label, key))
    nb.set_tab_reorderable(box, False)
    box.show_all()
    nb.set_current_page(idx)
    tabs[key] = box
    return False


def on_msg(mgr, res):
    try:
        d = json.loads(res.get_js_value().to_string())
        if d.get("type") == "extensions":
            GLib.idle_add(_open_extension_shelf, d.get("session", ""), d.get("pane", ""), d.get("harness", ""))
            return
        if d.get("type") == "reader":
            action = d.get("action")
            if action == "open":
                eid = str(d.get("id") or "")
                GLib.idle_add(reader_open, eid if re.fullmatch(r"\d{4}-\d{2}-\d{2}@\d{2}:\d{2}", eid) else "")
            elif action == "close":
                GLib.idle_add(reader_close)
            elif action == "terminal":
                GLib.idle_add(reader_terminal, bool(d.get("on")))
            return
        if d.get("buttonStyle") in ("sutil", "arcade", "tecla", "pixel", "consola"):
            GLib.idle_add(apply_button_style, d["buttonStyle"])
            return
        if d.get("headerAction") in HEADER_ACTIONS:
            GLib.idle_add(HEADER_ACTIONS[d["headerAction"]])
            return
        if isinstance(d.get("sidebarTerm"), dict):
            st = d["sidebarTerm"]
            if "hidden" in st:
                _SIDE["hidden"] = bool(st.get("hidden"))
            if "tabs" in st:
                _SIDE["tabs"] = _side_tabs_from_web(st.get("tabs"))
            if isinstance(st.get("cmds"), dict):       # panel de la barra de comandos (web)
                c = st["cmds"]
                _SIDE["cmds_closed"] = not bool(c.get("open"))
                _SIDE["sheet_open"] = bool(c.get("open"))
                try:
                    _SIDE["cmds_h"] = max(0, min(4000, int(c.get("h") or 0)))
                except (TypeError, ValueError):
                    _SIDE["cmds_h"] = 0
            GLib.idle_add(_side_term_show, str(st.get("session") or ""))
            return
        if d.get("leftPanel") in ("toggle", "hide", "show"):
            GLib.idle_add(_left_panel_set, {"toggle": not _SIDE.get("leftHidden"), "hide": True, "show": False}[d["leftPanel"]])
            return
        if d.get("chainModal") in ("close", "saved", "run"):
            GLib.idle_add(_chain_modal_msg, d)
            return
        if d.get("theme"):
            apply_theme(d["theme"])
            return
        if d.get("openUrlModal"):
            u = str(d.get("openUrlModal"))[:2000]
            if u.startswith("http://") or u.startswith("https://"):
                GLib.idle_add(open_web_modal, u, str(d.get("label") or "")[:80])
            return
        if d.get("openUrl"):
            u = str(d.get("openUrl"))[:2000]
            if u.startswith("http://") or u.startswith("https://"):
                GLib.idle_add(open_web_tab, u, str(d.get("label") or "")[:60])
            return
        if d.get("type") == "rename":
            sess = d.get("session", "")
            label = d.get("label", "")
            box = tabs.get(sess)
            if box is not None and isinstance(label, str) and label.strip():
                set_tab_label(box, label.strip())
            return
        label = d.get("label", None)
        open_tab(d.get("session", ""), d.get("win", "claude"),
                 label=label if isinstance(label, str) and label else None)
    except Exception as e:
        print(f"mensaje invalido del tablero: {e}")


ucm.register_script_message_handler("centro")
ucm.connect("script-message-received::centro", on_msg)

wv = WebKit2.WebView.new_with_user_content_manager(ucm)
try:
    # errores JS del tablero al stdout/log del app: sin esto los bugs del
    # webview (motor WebKitGTK != Chrome) son invisibles
    wv.get_settings().set_property("enable-write-console-messages-to-stdout", True)
except Exception:
    pass
wv.get_settings().set_property("enable-developer-extras", True)
wv.get_settings().set_property("enable-webaudio", True)


def on_perm(view, request):
    # Sin esto, WebKit niega Notification.requestPermission y el switch
    # de "Notificaciones del navegador" fallaba siempre dentro de la app
    if isinstance(request, WebKit2.NotificationPermissionRequest):
        request.allow()
        return True
    return False


wv.connect("permission-request", on_perm)
wv.load_uri(URL)
wv.connect("load-failed", lambda v, e, u, err:
           (GLib.timeout_add_seconds(2, lambda: (wv.load_uri(URL), False)[1]), True)[1])

