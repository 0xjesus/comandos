def show_help(*_):
    w = Gtk.Frame()
    w.set_size_request(640, 720)
    w.set_halign(Gtk.Align.CENTER); w.set_valign(Gtk.Align.CENTER)
    w.get_style_context().add_class("helpwin")
    close_ref = [None]
    def _close():
        if close_ref[0]:
            close_ref[0]()
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    outer.set_property("margin", 22)
    title = Gtk.Label(xalign=0)
    title.set_markup("<span size='16000' weight='bold'>" + ("Atajos de teclado" if ES else "Keyboard shortcuts") + "</span>")
    title.get_style_context().add_class("help-h")
    outer.pack_start(title, False, False, 0)
    for section, rows in SHORTCUTS:
        sl = Gtk.Label(xalign=0)
        sl.set_markup(f"<span weight='bold'>{section.upper()}</span>")
        sl.get_style_context().add_class("help-sec")
        sl.set_margin_top(16)
        outer.pack_start(sl, False, False, 0)
        grid = Gtk.Grid()
        grid.set_column_spacing(18); grid.set_row_spacing(7)
        grid.set_margin_top(6)
        for i, (keys, desc) in enumerate(rows):
            k = Gtk.Label(label=keys, xalign=0)
            k.get_style_context().add_class("help-key")
            d = Gtk.Label(label=desc, xalign=0)
            d.get_style_context().add_class("help-desc")
            grid.attach(k, 0, i, 1, 1)
            grid.attach(d, 1, i, 1, 1)
        outer.pack_start(grid, False, False, 0)
    hint = Gtk.Label(xalign=0)
    hint.set_markup("<span size='9000'>" + (
        "Ctrl-b es el 'prefix' de tmux: sueltas y luego tecleas la letra.  "
        "Esc o ? cierra esta ventana." if ES else
        "Ctrl-b is the tmux 'prefix': release it, then type the letter.  "
        "Esc or ? closes this window.") + "</span>")
    hint.get_style_context().add_class("help-hint")
    hint.set_margin_top(20)
    outer.pack_start(hint, False, False, 0)
    scroll.add(outer)
    w.add(scroll)

    def on_help_key(ev):
        if ev.keyval in (Gdk.KEY_question, Gdk.KEY_F1):
            _close(); return True
        return False
    close_ref[0] = show_modal_panel(w, on_key=on_help_key)


def _agent_cleanup_worker(pane_pid):
    try:
        agent_stop.cleanup_after_exit(pane_pid)
    except Exception as ex:
        print(f"ctrl+c agent cleanup: {ex}")


def _arm_agent_cleanup(term):
    """Doble Ctrl+C: si el CLI en primer plano es grok/codex y sale, limpiar
    sus hijos despegados. Todo lo de /proc va en un hilo."""
    tty = getattr(term, "_tty", None)
    if not tty:
        return False
    r = tmuxc("list-clients", "-F",
              "#{client_tty}|#{client_key_table}|#{client_prefix}|#{pane_in_mode}|#{pane_pid}")
    state = agent_stop.parse_client_state(r.stdout if r.returncode == 0 else "", tty)
    if agent_stop.client_blocks_stop(state):
        return False
    threading.Thread(target=_agent_cleanup_worker, args=(state["pane_pid"],), daemon=True).start()
    return True


def handle_ctrl_c(term, copy_context, now):
    """Ctrl+C en una terminal. True = consumido (copia); False = el ^C llega al CLI.
    Un solo Ctrl+C no hace nada extra; ver lib/agent_stop.py."""
    action = agent_stop.ctrl_c_action(term.get_has_selection(), copy_context, now,
                                      getattr(term, "_last_ctrl_c", None))
    term._last_ctrl_c = now if action == "pass" and not copy_context else None
    if action == "copy":
        term.copy_clipboard_format(Vte.Format.TEXT)
        term.unselect_all()
        return True
    if action == "arm":
        _arm_agent_cleanup(term)
    return False


def on_key(w, e):
    if e.keyval == Gdk.KEY_Escape and ws_cancel_drag():
        return True
    ctrl = e.state & Gdk.ModifierType.CONTROL_MASK
    shift = e.state & Gdk.ModifierType.SHIFT_MASK
    # Ayuda: F1. Nunca '?': Shift+/ tiene que escribir el signo en el chat.
    if e.keyval == Gdk.KEY_F1:
        show_help(); return True
    # Clipboard natural cuando el foco esta en una terminal:
    #   Ctrl+V pega; Ctrl+C copia si hay seleccion (si no, interrumpe como siempre).
    #   En Grok o Codex, un doble Ctrl+C que cierra el CLI limpia sus hijos despegados.
    fw = win.get_focus()
    # La seleccion con mouse deja el pane en copy-mode (highlight visible).
    # El PRIMER keypress real despues de soltar lo saca: el teclado nunca se
    # atora y la tecla llega a la shell como si nada.
    MODS = (Gdk.KEY_Control_L, Gdk.KEY_Control_R, Gdk.KEY_Shift_L, Gdk.KEY_Shift_R,
            Gdk.KEY_Alt_L, Gdk.KEY_Alt_R, Gdk.KEY_Super_L, Gdk.KEY_Super_R)
    copy_context = False
    if isinstance(fw, Vte.Terminal) and getattr(fw, "_sel_flag", False) \
            and e.keyval not in MODS:
        fw._sel_flag = False
        copy_context = exit_copy_mode(fw)
    if ctrl and isinstance(fw, Vte.Terminal):
        if e.keyval in (Gdk.KEY_v, Gdk.KEY_V):
            exit_copy_mode(fw)     # si habia highlight de tmux, salir antes de pegar
            fw.paste_clipboard()
            return True
        if e.keyval in (Gdk.KEY_c, Gdk.KEY_C) and not shift:
            return handle_ctrl_c(fw, copy_context, time.monotonic())
        if e.keyval in (Gdk.KEY_c, Gdk.KEY_C) and fw.get_has_selection():
            fw.copy_clipboard_format(Vte.Format.TEXT)
            fw.unselect_all()
            return True
    if e.keyval == Gdk.KEY_F12:
        nb.set_visible(not nb.get_visible())
        if nb.get_visible() and cur_term():
            cur_term().grab_focus()
        return True
    if e.keyval == Gdk.KEY_F5:
        wv.load_uri(URL)
        return True
    if ctrl and shift and e.keyval in (Gdk.KEY_A, Gdk.KEY_a):
        # Ctrl+Shift+A: iniciar IA en el pane activo de la pestana actual
        try:
            box = nb.get_nth_page(nb.get_current_page())
            sess = term_session(getattr(box, "_term", None)) or str(getattr(box, "_key", "") or "").partition(":")[0]
            r = tmuxc("display-message", "-p", "-t", "=" + sess + ":", "#{pane_id}") if sess else None
            open_ai_session_here(sess, (r.stdout or "").strip() if r else "")
        except Exception as ex:
            print(f"ctrl+shift+a: {ex}")
        return True
    if ctrl and e.keyval in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
        if shift:
            _cycle_tab(-1)          # Ctrl+Shift+Tab: ciclar hacia atrás
        elif not _mru_toggle():
            _cycle_tab(1)           # sin historial MRU aún: ciclar adelante
        if cur_term():
            cur_term().grab_focus()
        return True
    if ctrl and e.keyval in (Gdk.KEY_g, Gdk.KEY_G):
        _mosaic_toggle()
        return True
    if ctrl and e.keyval in (Gdk.KEY_Page_Down, Gdk.KEY_Page_Up):
        _cycle_tab(1 if e.keyval == Gdk.KEY_Page_Down else -1)
        if cur_term():
            cur_term().grab_focus()
        return True
    t = cur_term()
    if t and ctrl and shift and e.keyval in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
        t.set_font_scale(min(2.5, t.get_font_scale() + 0.1)); return True
    if t and ctrl and shift and e.keyval in (Gdk.KEY_minus, Gdk.KEY_underscore, Gdk.KEY_KP_Subtract):
        t.set_font_scale(max(0.5, t.get_font_scale() - 0.1)); return True
    if t and ctrl and shift and e.keyval in (Gdk.KEY_0, Gdk.KEY_parenright):
        t.set_font_scale(1.0); return True
    if ctrl and not shift and e.keyval in (Gdk.KEY_k, Gdk.KEY_K):
        open_switcher(); return True
    # CONTROL_MASK + SHIFT_MASK + Gdk.KEY_K → snippets modal
    if ctrl and shift and e.keyval in (Gdk.KEY_k, Gdk.KEY_K):
        open_snippets_dialog(); return True
    if ctrl and not shift and e.keyval in (Gdk.KEY_t, Gdk.KEY_T):
        new_local_tab(); return True
    if ctrl and shift and e.keyval in (Gdk.KEY_t, Gdk.KEY_T):
        open_xterm_tab("local"); return True
    if ctrl and shift and e.keyval in (Gdk.KEY_w, Gdk.KEY_W):
        page = nb.get_nth_page(nb.get_current_page())
        if page is not None and getattr(page, "_key", None):
            close_tab(page._key)
        return True
    if ctrl and not shift and e.keyval in (Gdk.KEY_q, Gdk.KEY_Q):
        Gtk.main_quit(); return True
    return False


# Super+N y los popups piden foco via cc-dash: escribe app-focus.json y aqui
# enfocamos (o abrimos) la pestana de esa sesion, sin mover clientes de nadie
FOCUS_FILE = os.path.expanduser("~/.claude/hooks/app-focus.json")


def on_focus_request(_mon, _f, _other, event):
    if event != Gio.FileMonitorEvent.CHANGES_DONE_HINT:
        return
    try:
        with open(FOCUS_FILE) as fh:
            d = json.load(fh)
        sess, winname = d.get("session", ""), d.get("win", "claude")
        label = d.get("label", None)
    except Exception:
        return
    if sess and sess not in ("local", "hub", "control"):
        open_tab(sess, winname, label=label if isinstance(label, str) and label else None)
        raise_main_window()


def raise_main_window():
    """Trae ComandOS al frente de forma CONFIABLE en GNOME/Mutter, que rechaza
    que una app se enfoque sola (por eso "a veces" no subia). Un pulso de
    keep-above fuerza la ventana ARRIBA aunque Mutter no le de el teclado;
    luego se suelta para no dejarla pineada."""
    win.deiconify()
    win.set_keep_above(True)
    win.present_with_time(Gtk.get_current_event_time() or 0)
    def _drop():
        win.set_keep_above(False)
        return False
    GLib.timeout_add(500, _drop)


# Cierres pedidos desde el tablero (remoto o local): cc-dash escribe
# app-tab-close.json tras la confirmacion del usuario; aqui cerramos la tab
# GTK sin re-preguntar. Asi remoto y escritorio quedan en sync.
CLOSE_FILE = os.path.expanduser("~/.claude/hooks/app-tab-close.json")


def on_tab_close_request(_mon, _f, _other, event):
    if event != Gio.FileMonitorEvent.CHANGES_DONE_HINT:
        return
    try:
        with open(CLOSE_FILE) as fh:
            data = json.load(fh)
    except Exception:
        return
    # Un cierre de grupo deja la lista completa: cada miembro escribe el
    # archivo y el monitor puede ver solo la ultima escritura.
    sessions = data.get("sessions") if isinstance(data.get("sessions"), list) else [data.get("session", "")]
    for sess in sessions:
        if isinstance(sess, str) and sess and sess in tabs:
            close_tab(sess, confirm=False)


_close_mon = Gio.File.new_for_path(CLOSE_FILE).monitor_file(Gio.FileMonitorFlags.NONE, None)
_close_mon.connect("changed", on_tab_close_request)

# El remoto abrio una tab (boton +, abrir sesion, recuperar): cc-dash escribe
# app-tab-open.json y aqui abrimos la MISMA pestana — en segundo plano, sin
# robarle el foco a la tab en la que el usuario esta trabajando.
OPEN_FILE = os.path.expanduser("~/.claude/hooks/app-tab-open.json")


def on_tab_open_request(_mon, _f, _other, event):
    if event != Gio.FileMonitorEvent.CHANGES_DONE_HINT:
        return
    try:
        with open(OPEN_FILE) as fh:
            d = json.load(fh)
        sess, label = d.get("session", ""), d.get("label") or None
    except Exception:
        return
    if not sess or sess in tabs:
        return
    cur = nb.get_nth_page(nb.get_current_page())
    try:
        open_tab(sess, "claude", label=label)
    except Exception:
        return
    if cur is not None and nb.page_num(cur) >= 0:
        nb.set_current_page(nb.page_num(cur))


_open_mon = Gio.File.new_for_path(OPEN_FILE).monitor_file(Gio.FileMonitorFlags.NONE, None)
_open_mon.connect("changed", on_tab_open_request)

_focus_mon = Gio.File.new_for_path(FOCUS_FILE).monitor_file(Gio.FileMonitorFlags.NONE, None)
_focus_mon.connect("changed", on_focus_request)


def _cur_page():
    return nb.get_nth_page(nb.get_current_page())


def _cur_term():
    page = _cur_page()
    return getattr(page, "_term", None) or (page if hasattr(page, "feed_child") else None)


def _page_for(sess):
    for i in range(nb.get_n_pages()):
        p = nb.get_nth_page(i)
        if getattr(p, "_key", None) == sess or sess in getattr(p, "members", {}):
            return i, p
    return -1, None


def _cur_pane_id(sess=None):
    """Pane activo de la pestana actual (o de `sess`), o "" si no hay sesion
    tmux real (xterm-*, sesion muerta). Un target vacio es el pane de OTRA sesion."""
    page = _cur_page()
    term = getattr(page, "_term", None)
    sess = sess or (term_session(term) if term is not None else None) or getattr(page, "_key", None) or "local"
    if sess.startswith("xterm-"):
        return ""
    r = tmuxc("display-message", "-p", "-t", f"={sess}:", "#{pane_id}")
    pane = (r.stdout or "").strip() if r.returncode == 0 else ""
    return pane if re.fullmatch(r"%\d+", pane) else ""


def _kill_cur_pane(sess=None):
    """Cerrar el split actual por el camino guardado (copia previa + identidad)."""
    pane = _cur_pane_id(sess)
    if not pane:
        return None
    r = tmuxc("display-message", "-p", "-t", pane, "#{session_name}")
    owner = (r.stdout or "").strip() if r.returncode == 0 else ""
    if not owner:
        return None

    def work():
        status, listing = _dash_call("/terminal-panes", {"session": owner, "action": "list"})
        entry = next((p for p in listing.get("panes") or [] if p.get("id") == pane), None) if status == 200 else None
        if not entry:
            return 400, {"error": listing.get("error") or "El panel ya no existe"}
        return _dash_call("/terminal-panes", {"session": owner, "action": "close", "pane": pane,
                                              "identity": entry.get("identity")})
    _in_background(work, lambda res: res[0] == 200 or notify_popup(
        "Cerrar split" if ES else "Close split", res[1].get("error") or "No se cerró"))
    return pane


def _select_pane_cmd(a):
    pane = str(a.get("pane") or "")
    return tmuxc("select-pane", "-t", pane) if re.fullmatch(r"%\d+", pane) else None


def _split_cmd(side, ssh=False):
    # split() vive anidada en el menú contextual (flags, cmd=None); aquí
    # replicamos su tmux split-window contra el pane/sesión actuales.
    flags = {"right": ["-h"], "left": ["-h", "-b"], "down": ["-v"], "up": ["-v", "-b"]}[side]
    term = _cur_term()
    cur_sess = term_session(term) if term is not None else None
    if not cur_sess:
        cur_sess = getattr(_cur_page(), "_key", None)
    target = _cur_pane_id() or (("=" + cur_sess + ":") if cur_sess else None)
    if not target:
        return
    cmd = None
    if ssh:
        host = ssh_host_from_session(cur_sess)
        if host:
            cmd = f"ssh {host}"
    args = ["split-window"] + flags + ["-t", target]
    if cmd:
        args.append(cmd)
    else:
        r = tmuxc("display-message", "-p", "-t", target, "#{pane_current_path}")
        cwd = (r.stdout or "").strip()
        if cwd:
            args += ["-c", cwd]
    tmuxc(*args)


def _side_toggle():
    _left_panel_toggle()


def set_font_scale(scale):
    t = _cur_term()
    if t is None:
        return
    t.set_font_scale(max(0.5, min(2.5, float(scale))))


APP_COMMANDS = {
    "split": lambda a: _split_cmd(a.get("side", "right")),
    "split_ssh": lambda a: _split_cmd(a.get("side", "right"), ssh=True),
    "kill_pane": lambda a: _kill_cur_pane(a.get("session")),
    "toggle_window": lambda a: feed(_cur_term(), b"\x02l"),
    "select_pane": lambda a: _select_pane_cmd(a),
    "next_tab": lambda a: _cycle_tab(1),
    "prev_tab": lambda a: _cycle_tab(-1),
    "mru_toggle": lambda a: _mru_toggle(),
    "focus_page": lambda a: (lambda i: nb.set_current_page(i) if i >= 0 else None)(_page_for(a.get("session"))[0]),
    "tab_reorder": lambda a: tab_reorder(a.get("session"), a.get("index", 0)),
    "mosaic": lambda a: {"on": _mosaic_open, "off": _mosaic_close, "toggle": _mosaic_toggle}[a.get("state", "toggle")](),
    "mosaic_zoom": lambda a: _mosaic_zoom(a.get("session"), a.get("session")),
    "side_panel": lambda a: _left_panel_set(not bool(a.get("on"))),
    "terminals_visible": lambda a: nb.set_visible(bool(a.get("on", True))),
    "reload_dashboard": lambda a: wv.load_uri(URL),
    "font_scale": lambda a: set_font_scale(1.0) if not a.get("delta") else set_font_scale(_cur_term().get_font_scale() + float(a["delta"])),
    "open_switcher": lambda a: open_switcher(),
    "tabs_overview": lambda a: open_tabs_overview(),
    "help": lambda a: show_help(),
    "snippets": lambda a: open_snippets_dialog(),
    "new_local_tab": lambda a: new_local_tab(),
    "open_xterm_tab": lambda a: open_xterm_tab(a.get("session") or "local"),
    "open_wizard": lambda a: _open_wizard(),
    "start_ai_here": lambda a: open_ai_session_here(a.get("session"), a.get("pane")),
    "copy_selection": lambda a: copy_vte_selection(_cur_term()),
    "paste_clipboard": lambda a: (exit_copy_mode(_cur_term()), _cur_term().paste_clipboard()),
    "copy_reply": lambda a: copy_claude_reply(_cur_term()),
    "window": lambda a: {"minimize": win.iconify, "maximize": win.maximize, "restore": win.unmaximize, "raise": raise_main_window}[a.get("action", "raise")](),
    "paned_position": lambda a: paned.set_position(int(a.get("px", 700))),
    "quit": lambda a: Gtk.main_quit(),
}


def on_app_command(path):
    try:
        with open(path) as f:
            data = json.load(f)
        os.remove(path)
    except Exception:
        return
    fn = APP_COMMANDS.get(str(data.get("command") or ""))
    if not fn:
        return
    try:
        fn(data.get("args") or {})
    except Exception as e:
        notify_popup(f"Comando '{data.get('command')}' falló", str(e))


# Dispatcher (y POST /app/command) escriben app-command.json; la app observa
# el archivo y ejecuta el comando GTK equivalente (splits, mosaico, pestañas).
CMD_FILE = os.path.expanduser("~/.claude/hooks/app-command.json")
_cmd_file = Gio.File.new_for_path(CMD_FILE)
_cmd_mon = _cmd_file.monitor_file(Gio.FileMonitorFlags.NONE, None)
_cmd_mon.connect("changed", lambda m, f, o, ev: on_app_command(f.get_path())
                 if f is not None and ev in (Gio.FileMonitorEvent.CREATED, Gio.FileMonitorEvent.CHANGES_DONE_HINT) else None)

# Antes de on_key: si on_key consume la tecla, la emision se detiene.
win.connect("key-press-event", lambda *_: report_presence(interaction=True) and False)
win.connect("key-press-event", on_key)
win.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK)
win.connect("motion-notify-event", _ws_window_motion)
win.connect("button-release-event", _ws_window_release)
# Los clics los consume VTE antes de llegar a la ventana: capturarlos arriba
# sin reclamarlos (el gesto no roba el evento).
_presence_clicks = Gtk.GestureMultiPress.new(win)
_presence_clicks.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
_presence_clicks.set_button(0)
_presence_clicks.connect("pressed", lambda *_: report_presence(interaction=True))
win.connect("window-state-event", _presence_window_state)
GLib.timeout_add_seconds(30, lambda: (report_presence(), True)[1])
win.connect("destroy", Gtk.main_quit)
win.show_all()
_side_paned.set_no_show_all(True)  # un show_all de más arriba no lo reabre
if _SIDE.get("leftHidden"):        # el panel izquierdo se queda como lo dejaste
    _side_paned.hide()
_left_btn_paint()
hub._term.grab_focus()
GLib.timeout_add(600, finish_startup_restore)
GLib.timeout_add_seconds(5, lambda: (threading.Thread(target=snapshot_layouts, daemon=True).start(), True)[1])
GLib.timeout_add_seconds(5, lambda: (start_work_marks_fetch(), True)[1])
GLib.timeout_add_seconds(30, lambda: (threading.Thread(target=snapshot_tabs, daemon=True).start(), True)[1])
GLib.timeout_add_seconds(8, lambda: (threading.Thread(target=snapshot_tabs, daemon=True).start(), False)[1])
threading.Thread(target=poll_state_loop, daemon=True).start()
threading.Thread(target=notices_watch_loop, daemon=True).start()
try:
    Gtk.main()
finally:
    snapshot_layouts(wait=True)
