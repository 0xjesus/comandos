.help-desc { color: @DIM@; font-size: 13px; }
.help-hint { color: @FAINT@; }
"""


_SHELF_HANDLE = 6  # alto del separador del estante de extensiones (px)


def _shelf_separator_css():
    """El separador del estante sí se ve: es el asa para cambiarle la altura.
    Más específico que la regla que vuelve invisible al del Paned principal."""
    return (
        b"paned.cc-paned paned.cc-shelf-paned > separator{"
        b" min-height:" + str(_SHELF_HANDLE).encode() + b"px;background-image:none;border:0;box-shadow:none;"
        b" background-color:" + THEME["line"].encode() + b";"
        b"}"
        b"paned.cc-paned paned.cc-shelf-paned > separator:hover{"
        b" background-color:" + THEME["brand"].encode() + b";"
        b"}"
    )


def theme_css(t):
    s = APP_CSS
    try:
        icons = _ICONS_DIR
    except NameError:          # tests ejecutan esta funcion aislada
        icons = ""
    for k, v in (("@BAR@", t["bar"]), ("@BG@", t["bg"]), ("@TEXT@", t["text"]),
                 ("@DIM@", t["dim"]), ("@FAINT@", t["faint"]), ("@BRAND@", t["brand"]),
                 ("@LINE@", t["line"]), ("@LINE2@", t["line2"]),
                 ("@ICONS@", icons)):
        s = s.replace(k, v)
    return s


def fetch_prefs():
    """Lee TODAS las prefs de cc-dash. Blocking pero con timeout corto — solo
    se usa al arrancar. Fallback a defaults si cc-dash aún no responde."""
    try:
        with urllib.request.urlopen(BASE_URL + "/prefs", timeout=2) as r:
            return json.loads(r.read().decode())
    except Exception:
        return {}


def fetch_pref_theme():
    return (fetch_prefs().get("theme") or "noche")


PREFS = fetch_prefs()
THEME = THEMES.get(PREFS.get("theme", "noche"), THEMES["noche"])

# Overrides de terminal desde /prefs — con defaults sensatos si cc-dash aún no
# guardó el schema nuevo. Ver DESIGN.md §7.
_PF_FAMILY = (PREFS.get("font_family") or "").strip() or "Ubuntu Sans Mono"
_PF_SIZE = int(PREFS.get("font_size") or FONT_SIZE)
FONT_FAMILY = f"{_PF_FAMILY},JetBrainsMono Nerd Font,JetBrains Mono,DejaVu Sans Mono,Monospace"
FONT_SIZE = _PF_SIZE
FONT = f"{FONT_FAMILY} {FONT_SIZE}"
TERM_PADDING = max(0, min(40, int(PREFS.get("terminal_padding", 8))))
TERM_LINE_SCALE = 1.2   # interlineado de la terminal (el mockup respira; 1.0 se veía apretado). Igual en remoto (term.html).
HEADER_EXTRA = 14   # px extra sobre la VTE: la cabecera de los panes de arriba crece hacia ese margen
TERM_OPACITY = max(30, min(100, int(PREFS.get("terminal_opacity", 100)))) / 100.0
_CURSOR_SHAPE = (PREFS.get("cursor_shape") or "block")
_CURSOR_BLINK = bool(PREFS.get("cursor_blink", True))


def rgba(h):
    c = Gdk.RGBA()
    c.parse(h)
    return c


def tmuxc(*args):
    try:
        return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=5)
    except Exception:
        return subprocess.CompletedProcess(args, 1, "", "")


def http_post(path, payload, timeout=15):
    req = urllib.request.Request(
        BASE_URL + path,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode()), None
    except urllib.error.HTTPError as e:
        try:
            return None, json.loads(e.read().decode()).get("error", str(e))
        except Exception:
            return None, str(e)
    except Exception as e:
        return None, str(e)


def http_ensure(sess, win_name="claude"):
    http_post("/ensure", {"session": sess, "win": win_name})


# ---------- snippets store (spejo del cc-dash) ----------
SNIPPETS_FILE = os.path.expanduser("~/.claude/hooks/snippets.json")


def snip_load():
    try:
        with open(SNIPPETS_FILE) as f:
            data = json.load(f)
        return data if isinstance(data, list) else []
    except FileNotFoundError:
        return []
    except Exception:
        return []


def snip_save(items):
    # Mismo candado y escritura atómica que cc-dash: los dos escriben este archivo.
    os.makedirs(os.path.dirname(SNIPPETS_FILE), exist_ok=True)
    with _file_lock(SNIPPETS_FILE):
        fd, tmp = tempfile.mkstemp(prefix=".snippets.json.", suffix=".tmp",
                                   dir=os.path.dirname(SNIPPETS_FILE))
        try:
            with os.fdopen(fd, "w") as f:
                json.dump(items, f)
            os.replace(tmp, SNIPPETS_FILE)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)


SNIP_LOG_FILE = "/tmp/cc-app-snip.log"


def _snip_env_snapshot():
    """Escribe estado del display server al inicio para el debug."""
    try:
        if not os.path.exists(SNIP_LOG_FILE):
            return
        with open(SNIP_LOG_FILE, "a") as f:
            f.write("=" * 60 + "\n")
            f.write(f"cc-app startup {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
            for k in ("DISPLAY", "WAYLAND_DISPLAY", "XDG_SESSION_TYPE",
                     "GDK_BACKEND", "XDG_CURRENT_DESKTOP", "WSL_DISTRO_NAME",
                     "PULSE_SERVER"):
                f.write(f"  {k}={os.environ.get(k, '<unset>')}\n")
            f.write("=" * 60 + "\n")
    except Exception:
        pass


_snip_env_snapshot()


def snip_log(msg):
    """Log opt-in del SnippetsDialog para diagnostico. Escribe a
    /tmp/cc-app-snip.log si el archivo existe; touch para activar, borrar
    para desactivar. Silencioso por default en uso normal."""
    try:
        if not os.path.exists(SNIP_LOG_FILE):
            return
        with open(SNIP_LOG_FILE, "a") as f:
            ts = time.strftime("%H:%M:%S") + f".{int((time.time()%1)*1000):03d}"
            f.write(f"[{ts}] {msg}\n")
    except Exception:
        pass


def snip_paste(sess, text):
    """Pega `text` en la sesion tmux `sess` usando bracketed paste. NUNCA ejecuta.

    Secuencia: load-buffer (via stdin) -> paste-buffer -p -> delete-buffer.
    El shell moderno buffea el texto y espera al usuario para ejecutar."""
    # has-session usa `=<sess>` (session-target). paste-buffer usa `=<sess>:`
    # (pane-target: sesion + ventana/pane activos) — tmux 3.2a exige el `:`
    # final si no aparece un window index, como en cc-dash.
    session_target = "=" + sess
    pane_target = "=" + sess + ":"
    r = subprocess.run(["tmux", "has-session", "-t", session_target],
                       capture_output=True, text=True, timeout=5)
    if r.returncode != 0:
        return f"No hay sesion tmux '{sess}'"
    # Buffer propio por pegado: con uno fijo, dos pegados a la vez se cruzan de pane.
    buf = "comandos-snip-" + secrets.token_hex(8)
    r = subprocess.run(["tmux", "load-buffer", "-b", buf, "-"],
                       input=text, capture_output=True, text=True, timeout=5)
    if r.returncode != 0:
        subprocess.run(["tmux", "delete-buffer", "-b", buf],
                       capture_output=True, text=True, timeout=5)
        return r.stderr.strip() or "load-buffer fallo"
    err = None
    r = subprocess.run(["tmux", "paste-buffer", "-p", "-d", "-b", buf, "-t", pane_target],
                       capture_output=True, text=True, timeout=5)
    if r.returncode != 0:
        err = r.stderr.strip() or "paste-buffer fallo"
        subprocess.run(["tmux", "delete-buffer", "-b", buf],
                       capture_output=True, text=True, timeout=5)
    return err


URL_RE = r"https?://[^\s'\"<>\]\)]+"
# Rutas locales clickeables: ~/lo-que-sea, o absolutas con >=2 segmentos (asi
# /model, /compact o /usr solitos NO se vuelven links). Acepta :linea al final.
PATH_RE = r"(?:~/[\w.+@%,=-]+(?:/[\w.+@%,=-]+)*|/[\w.+@%,=-]+(?:/[\w.+@%,=-]+)+)(?::\d+)?"


def normalize_wrapped_url_text(text):
    """Join visual terminal wraps that split a URL across rows."""
    pat = r"https?://(?:[^\s'\"<>\]\)]+|[ \t]*\r?\n[ \t]*[^\s'\"<>\]\)]+)+"
    return re.sub(pat, lambda m: re.sub(r"[ \t]*\r?\n[ \t]*", "", m.group(0)), text or "")


def url_from_wrapped_text(text, fragment="", row=None, col=None):
    """URL o RUTA local bajo el punto, re-unida si el wrap la partio en
    varias filas. Un link JAMAS debe romperse por saltos de linea."""
    wrap = r"[ \t]*\r?\n[ \t]*"
    uch = r"[^\s'\"<>\]\)]"
    pch = r"[\w.+@%,=~/-]"
    pats = (
        rf"https?://(?:{uch}+|{wrap}{uch}+)+",
        # ~/... o /a/b (>=2 segmentos), con :linea opcional; tolera wraps
        rf"(?:~|/)(?:{pch}+|{wrap}{pch}+)+(?::\d+)?",
    )
    point = None
    if row is not None and col is not None:
        lines = (text or "").splitlines(True)
        if 0 <= row < len(lines):
            point = sum(len(lines[i]) for i in range(row)) + min(max(col, 0), len(lines[row]))
    frag = normalize_wrapped_url_text(fragment or "").strip()

    def joined(m):
        link = re.sub(wrap, "", m.group(0))
        if link.startswith("http"):
            return link
        # rutas: exigir >=2 segmentos en absolutas (que /model no sea link)
        body = link[:-len(link.rsplit(":", 1)[1]) - 1] if re.search(r":\d+$", link) else link
        if body.startswith("/") and body.count("/") < 2:
            return None
        return link

    candidates = []
    for pat in pats:
        for m in re.finditer(pat, text or ""):
            link = joined(m)
            if link:
                candidates.append((m, link))
    # una ruta contenida dentro de una URL no es candidata propia
    candidates = [(m, link) for m, link in candidates
                  if not any(o is not m and o.start() <= m.start() and m.end() <= o.end()
                             for o, _l in candidates)]
    for m, link in candidates:
        if frag and (frag in link or link in frag):
            return link
        if point is not None and m.start() <= point < m.end():
            return link
    if not frag and point is None and len(candidates) == 1:
        return candidates[0][1]
    return frag


def cell_at_event(term, event):
    cw = max(1, int(term.get_char_width() or 1))
    ch = max(1, int(term.get_char_height() or 1))
    x = max(0, int(event.x) - int(term.get_margin_start()))
    y = max(0, int(event.y) - int(term.get_margin_top()))
    col = min(max(0, x // cw), max(0, int(term.get_column_count() or 1) - 1))
    top = 0
    adj = term.get_vadjustment()
    if adj:
        top = int((adj.get_value() or 0) // ch) if term.get_scroll_unit_is_pixels() else int(adj.get_value() or 0)
    return top + (y // ch), col


def url_at_event(term, event, match=""):
    try:
        row, col = cell_at_event(term, event)
        cols = max(1, int(term.get_column_count() or 1))
        start = max(0, row - 3)
        text, _attrs = term.get_text_range(start, 0, row + 4, cols, None, None)
        # En splits tmux cada fila mezcla varios panes + bordes │: recortar
        # las lineas a las columnas del pane clickeado para que el wrap se
        # re-una dentro DE ESE pane y no se contamine con el vecino.
        sess = term_session(term)
        if sess and text:
            r = tmuxc("list-panes", "-t", "=" + sess + ":",
                      "-F", "#{pane_id}|#{pane_left}|#{pane_right}")
            for line in (r.stdout or "").splitlines():
                parts = line.split("|")
                if len(parts) == 3 and int(parts[1]) <= col <= int(parts[2]):
                    left, right = int(parts[1]), int(parts[2])
                    if left > 0 or right < cols - 1:
                        text = "\n".join(l[left:right + 1]
                                         for l in text.splitlines())
                        col -= left
                    break
        url = url_from_wrapped_text(text or "", match or "", row - start, col)
        if url:
            return url
    except Exception:
        pass
    return normalize_wrapped_url_text(match or "")


def ssh_host_from_session(sess):
    if not isinstance(sess, str):
        return None
    if sess.startswith("ssh-"):
        return sess[4:] or None
    if sess.startswith("sshtab-"):
        host, sep, idx = sess[len("sshtab-"):].rpartition("-")
        if sep and idx.isdigit() and host:
            return host
    return None


_SSH_SCROLL_PENDING = {}
_SSH_SCROLL_TIMERS = {}
_SSH_SCROLL_EXECUTOR = ThreadPoolExecutor(
    max_workers=1, thread_name_prefix="comandos-ssh-scroll")


def terminal_grid_at_event(term, event):
    col = int(
        max(0, float(event.x) - float(term.get_margin_start())) /
        max(1.0, float(term.get_char_width() or 1))
    )
    row = int(
        max(0, float(event.y) - float(term.get_margin_top())) /
        max(1.0, float(term.get_char_height() or 1))
    )
    col = min(col, max(0, int(term.get_column_count() or 1) - 1))
    row = min(row, max(0, int(term.get_row_count() or 1) - 1))
    return col, row


def _ssh_scroll_amount(event):
    if event.direction == Gdk.ScrollDirection.UP:
        return -3.0
    if event.direction == Gdk.ScrollDirection.DOWN:
        return 3.0
    if event.direction != Gdk.ScrollDirection.SMOOTH:
        return 0.0
    try:
        values = event.get_scroll_deltas()
        if len(values) == 3:
            ok, _dx, dy = values
            if not ok:
                return 0.0
        else:
            _dx, dy = values
        return max(-8.0, min(8.0, float(dy) * 2.0))
    except Exception:
        return 0.0


def _flush_ssh_scroll(sess):
    pending = _SSH_SCROLL_PENDING.pop(sess, None)
    _SSH_SCROLL_TIMERS.pop(sess, None)
    if not pending:
        return False
    delta = int(round(pending["delta"]))
    if not delta and abs(pending["delta"]) >= 0.25:
        delta = 1 if pending["delta"] > 0 else -1
    if not delta:
        return False
    col, row = pending["col"], pending["row"]
    _SSH_SCROLL_EXECUTOR.submit(
        http_post, "/tmux-scroll",
        {"session": sess, "delta": delta, "col": col, "row": row}, 3,
    )
    return False


def on_ssh_scroll(term, event):
    if term.get_has_selection():
        return False
    sess = getattr(term, "_session_hint", None) or term_session(term)
    if not ssh_host_from_session(sess):
        return False
    amount = _ssh_scroll_amount(event)
    if not amount:
        return False
    col, row = terminal_grid_at_event(term, event)
    pending = _SSH_SCROLL_PENDING.setdefault(
        sess, {"delta": 0.0, "col": col, "row": row})
    pending["delta"] = max(-24.0, min(24.0, pending["delta"] + amount))
    pending["col"], pending["row"] = col, row
    if sess not in _SSH_SCROLL_TIMERS:
        _SSH_SCROLL_TIMERS[sess] = GLib.timeout_add(45, _flush_ssh_scroll, sess)
    return True


_CURSOR_SHAPE_MAP = {
    "block":     Vte.CursorShape.BLOCK,
    "ibeam":     Vte.CursorShape.IBEAM,
    "underline": Vte.CursorShape.UNDERLINE,
}


def _bg_rgba():
    """Background del theme actual con la opacidad configurada. Requiere que
    la ventana tenga visual RGBA (se setea en el bootstrap con set_visual)."""
    c = Gdk.RGBA()
    c.parse(THEME["bg"])
    c.alpha = TERM_OPACITY
    return c


def _tmux_window_size(sess):
    """(cols, rows) que la sesión ya tiene en tmux, o None."""
    # «=sesión:» — sin los dos puntos display-message no resuelve la sesión y responde vacío.
    r = tmuxc("display-message", "-p", "-t", "=" + sess + ":", "#{window_width} #{window_height}")
    try:
        cols, rows = (int(x) for x in r.stdout.split())
    except (ValueError, AttributeError):
        return None
    return (cols, rows) if cols >= 20 and rows >= 5 else None


def _spawn_when_settled(term, spawn, quiet_ms=250, cap_ms=1500):
    """Engancha la sesión cuando la VTE deja de cambiar de tamaño (``quiet_ms`` sin
    size-allocate) o, como tope, a los ``cap_ms``. Al arrancar la ventana se
    acomoda en varios pasos (174→168→163 columnas): engancharse antes hacía que
    tmux redimensionara cada sesión tres veces y Claude Code se redibujara otras
    tantas. Así hay, como mucho, un cambio: al tamaño final."""
    st = {"timer": None, "done": False, "sid": None}

    def go():
        st["timer"] = None
        if st["done"]:
            return False
        st["done"] = True
        if st["sid"] is not None:
            term.disconnect(st["sid"])
            st["sid"] = None
        spawn()
        return False

    def on_alloc(*_):
        if st["timer"] is not None:
            GLib.source_remove(st["timer"])
        st["timer"] = GLib.timeout_add(quiet_ms, go)

    st["sid"] = term.connect("size-allocate", on_alloc)
    GLib.timeout_add(cap_ms, go)
    return st


def make_term(argv_sh, before_spawn=None, session=None):
    term = Vte.Terminal()
    term.set_font(Pango.FontDescription(FONT)); _term_line_scale(term)
    term.set_colors(rgba(THEME["fg"]), _bg_rgba(), [rgba(p) for p in THEME["pal"]])
    term.set_color_cursor(rgba(THEME["cursor"]))
    term.set_cursor_shape(_CURSOR_SHAPE_MAP.get(_CURSOR_SHAPE, Vte.CursorShape.BLOCK))
    term.set_cursor_blink_mode(
        Vte.CursorBlinkMode.ON if _CURSOR_BLINK else Vte.CursorBlinkMode.OFF)
    term.set_scrollback_lines(10000)
    term.set_audible_bell(False)
    term.connect("button-press-event", on_term_button)
    term.connect("button-release-event", on_term_release)
    term.connect("scroll-event", on_ssh_scroll)
    # Seleccionar = copiar al clipboard del sistema (portapapeles compartido)
    term.connect("selection-changed", lambda t: copy_vte_selection(t))
    term.connect("focus-in-event", lambda t, _e: (globals().get("_side_term_focused") or (lambda _t: False))(t))
    # URLs clickeables: click simple (sin arrastre) o Ctrl+click, con manita
    for pattern in (URL_RE, PATH_RE):
        try:
            rx = Vte.Regex.new_for_match(pattern, -1, 0x00000400)  # PCRE2_MULTILINE
            tag = term.match_add_regex(rx, 0)
            try:
                term.match_set_cursor_name(tag, "pointer")
            except Exception:
                pass
        except Exception:
            pass
    # Padding alrededor del texto (configurable en Ajustes > Terminal).
    term.set_margin_start(TERM_PADDING + 2); term.set_margin_end(max(0, TERM_PADDING - 4))
    term.set_margin_top(TERM_PADDING + HEADER_EXTRA); term.set_margin_bottom(max(0, TERM_PADDING - 2))

    # Drag & drop: soltar archivos/carpetas desde Files o el escritorio pega
    # sus RUTAS (shell-quoted) en el prompt — como GNOME Terminal. Nunca
    # ejecuta nada: el texto queda esperando tu Enter.
    _tl = Gtk.TargetList.new([])
    _tl.add_uri_targets(0)
    _tl.add_text_targets(1)
    term.drag_dest_set(Gtk.DestDefaults.ALL, [], Gdk.DragAction.COPY)
    term.drag_dest_set_target_list(_tl)

    def _on_drop(widget, ctx, _x, _y, data, _info, t):
        try:
            uris = data.get_uris()
            if uris:
                paths = []
                for u in uris:
                    pu = urlparse(u)
                    paths.append(shlex.quote(unquote(pu.path)) if pu.scheme == "file"
                                 else shlex.quote(u))
                widget.feed_child((" ".join(paths) + " ").encode())
            else:
                txt = data.get_text()
                if txt:
                    widget.feed_child(txt.encode())
        except Exception:
            pass
        ctx.finish(True, False, t)
        return True
    term.connect("drag-data-received", _on_drop)

    def spawn(*_):
        if before_spawn is not None:
            try:
                before_spawn()
            except Exception as e:
                print(f"terminal recovery failed; retaining snapshot: {e}")
                GLib.timeout_add(800, spawn)
                return False
        # Hasta que GTK le da tamaño (y con la pantalla bloqueada no lo hace) la
        # VTE mide 80×24: el `tmux attach` encogía la sesión para TODOS sus
        # clientes —el celular incluido— y Claude Code redibujaba su pantalla
        # entera («escribe sola», 1-oct). Arranca con el tamaño que la sesión ya
        # tiene; cuando GTK la dimensiona, pone el real.
        # «Sin tamaño de GTK» = asignación de 1 px, no «sin realizar»: con la pantalla
        # bloqueada la VTE ya está realizada pero nunca recibió tamaño (sigue en 80×24).
        if session and term.get_allocated_width() <= 1:
            size = _tmux_window_size(session)
            if size:
                term.set_size(*size)
        try:
            res = term.spawn_sync(Vte.PtyFlags.DEFAULT, os.path.expanduser("~"),
                                  ["/bin/sh", "-c", argv_sh], [],
                                  GLib.SpawnFlags.DEFAULT, None, None, None)
            # tty del hijo: nos dice que cliente tmux es esta pestana
            pid = res[1] if isinstance(res, (tuple, list)) and len(res) > 1 else None
            if pid:
                try:
                    term._tty = os.readlink(f"/proc/{pid}/fd/0")
                except Exception:
                    pass
        except Exception as e:
            print(f"terminal fallo: {e}")
        return False

    term._respawn = True
    term.connect("child-exited", lambda *_: term._respawn and GLib.timeout_add(800, spawn))
    if session:
        _spawn_when_settled(term, spawn)
    else:
        spawn()
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    box.get_style_context().add_class("termwrap")
    sb = Gtk.Scrollbar(orientation=Gtk.Orientation.VERTICAL,
                       adjustment=term.get_vadjustment())
    box.pack_start(term, True, True, 0)
    box.pack_start(sb, False, False, 0)
    box._term = term
    return box


def feed(term, seq):
    try:
        term.feed_child(seq)
    except TypeError:
        term.feed_child(seq.decode("latin1"), len(seq))


def new_session_dialog(*_):
    dlg = Gtk.Dialog(title="Nueva sesion" if ES else "New session", transient_for=win)
    dlg.set_decorated(False)   # sin min/max/close del WM; los botones están adentro
    dlg.get_style_context().add_class("cc-dialog")
    dlg.add_buttons("Cancelar" if ES else "Cancel", Gtk.ResponseType.CANCEL,
                    "Abrir" if ES else "Open", Gtk.ResponseType.OK)
    box = dlg.get_content_area()
    box.set_property("margin", 14); box.set_spacing(8)
    lbl = Gtk.Label(label=("Proyecto de ~/codebase (abre su Claude),\no cualquier nombre (terminal en blanco):" if ES else
                           "A ~/codebase project (opens its Claude),\nor any name (blank terminal):"), xalign=0)
    box.add(lbl)
    entry = Gtk.Entry()
    entry.set_placeholder_text("nombre..." if ES else "name...")
    entry.set_activates_default(True)
    dlg.set_default_response(Gtk.ResponseType.OK)
    box.add(entry)
    err = Gtk.Label(xalign=0); err.get_style_context().add_class("dim-error")
    box.add(err)
    busy = [False]

    def done(name, res, e):
        busy[0] = False
        dlg.set_response_sensitive(Gtk.ResponseType.OK, True)
        if e:
            err.set_text("⚠ " + e)   # ahora el error se VE, no falla en silencio
            return False
        dlg.destroy()
        # el server pudo resolver a la sesion real (claude en pestana term-*)
        open_tab((res or {}).get("session") or name, "claude")
        return False

    def on_response(_d, rid):
        if rid != Gtk.ResponseType.OK:
            if not busy[0]:
                dlg.destroy()
            return
        name = entry.get_text().strip().replace(".", "-").replace(":", "-")
        if not name or busy[0]:
            return
        busy[0] = True
        dlg.set_response_sensitive(Gtk.ResponseType.OK, False)
        err.set_text("Abriendo…" if ES else "Opening…")
        # /new puede tardar hasta 15 s: en un hilo, la ventana sigue viva.
        threading.Thread(target=lambda: GLib.idle_add(done, name, *http_post("/new", {"session": name})),
                         daemon=True).start()
    dlg.connect("response", on_response)
    dlg.set_modal(True)
    dlg.show_all()


def term_session(term):
    """Sesion tmux que muestra esta pestana (por el tty de su cliente)."""
    tty = getattr(term, "_tty", None)
    if not tty:
        return None
    r = tmuxc("list-clients", "-F", "#{client_tty}|#{client_session}")
    for l in r.stdout.splitlines():
        t, _, s = l.partition("|")
        if t == tty:
            return s
    return None


def pane_at(term, event):
    """(pane_id, total_panes) del pane bajo el cursor del mouse."""
    sess = term_session(term)
    if not sess:
        return None, 0
    # Primero la geometría de los marcos ya dibujados: un clic no espera a tmux.
    geo = _PANE_GEO.get(id(term)) if "_PANE_GEO" in globals() else None
    cw, chh = term.get_char_width(), term.get_char_height()
    if geo and cw >= 4 and chh >= 6:
        col, row = int(event.x // cw), int(event.y // chh)
        for pid, g in geo.items():
            height = _PANE_BOX.get(pid, (0, False))[0]
            if g[0] <= col < g[0] + g[2] and g[1] - 1 <= row < g[1] + height:
                return pid, len(geo)
    col = int((event.x - 10) // max(1, term.get_char_width()))
    row = int((event.y - 8) // max(1, term.get_char_height()))
    r = tmuxc("list-panes", "-t", "=" + sess + ":",
              "-F", "#{pane_id}|#{pane_left}|#{pane_top}|#{pane_right}|#{pane_bottom}")
    panes = [l.split("|") for l in r.stdout.splitlines() if l and l.count("|") == 4]
    for pid, l, t, rr, b in panes:
        if int(l) <= col <= int(rr) and int(t) <= row <= int(b):
            return pid, len(panes)
    return None, len(panes)


def copy_mode_pane(sess, preferred=None):
    """Pane que esta en copy-mode, priorizando el pane bajo el cursor."""
    if preferred:
        r = tmuxc("display-message", "-p", "-t", preferred, "#{pane_in_mode}")
        if r.stdout.strip() == "1":
            return preferred
    if not sess:
        return None
    r = tmuxc("list-panes", "-t", "=" + sess + ":", "-F", "#{pane_id}|#{pane_in_mode}")
    if r.returncode != 0:
        return None
    for line in r.stdout.splitlines():
        pane, _, mode = line.partition("|")
        if pane and mode == "1":
            return pane
    return None


def select_pane_at_event(term, event):
    pane_id, _npanes = pane_at(term, event)
    if pane_id:
        tmuxc("select-pane", "-t", pane_id)
        return pane_id
    return None


def copy_text_to_clipboard(text):
    if not text:
        return False
    cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
    cb.set_text(text, -1)
    try:
        cb.store()
    except Exception:
        pass
    return True


def copy_vte_selection(term):
    if not term.get_has_selection():
        return False
    term.copy_clipboard_format(Vte.Format.TEXT)
    term._last_selection_copy = time.monotonic()
    try:
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).store()
    except Exception:
        pass
    return True


def copy_tmux_selection_to_clipboard(pane):
    if not pane:
        return False
    r = tmuxc("send-keys", "-t", pane, "-X", "copy-selection-no-clear")
    if r.returncode != 0:
        r = tmuxc("send-keys", "-t", pane, "-X", "copy-selection")
    if r.returncode != 0:
        return False
    r = tmuxc("save-buffer", "-")
    if r.returncode != 0:
        return False
    return copy_text_to_clipboard(r.stdout)


def notify_popup(title, body):
    """Feedback visible via el demonio de popups (se autocierra en 12s).
    En un hilo: el demonio puede tardar hasta 3 s y nunca frena GTK."""
    def send():
        try:
            req = urllib.request.Request(
                "http://127.0.0.1:4778/notify",
                data=json.dumps({"title": title, "body": body, "kind": "done",
                                 "project": title, "session": "local"}).encode(),
                headers={"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=3)
        except Exception:
            pass
    threading.Thread(target=send, daemon=True).start()


def export_claude_reply(term, fmt):
    """Guarda la ultima respuesta de Claude de esta sesion como .txt o PDF
    (lo genera cc-dash en ~/Descargas, lo abre, y AVISA donde quedo)."""
    def work():
        sess = term_session(term)
        if not sess:
            return
        res, err = http_post("/export", {"session": sess, "format": fmt}, timeout=45)
        if err:
            notify_popup("No se pudo guardar" if ES else "Could not save", err)
        else:
            notify_popup("Respuesta guardada" if ES else "Reply saved", (res or {}).get("path", ""))
    threading.Thread(target=work, daemon=True).start()


def copy_claude_reply(term):
    """Copia al clipboard la ULTIMA respuesta de Claude de esta sesion (el
    texto completo que guardan los hooks), sin andar seleccionando a mano."""
    def found(txt, project):
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(txt, -1)
        notify_popup("Respuesta copiada" if ES else "Reply copied",
                     (f"{len(txt)} caracteres al portapapeles ({project})" if ES else
                      f"{len(txt)} characters copied ({project})"))
        return False

    def work():
        sess = term_session(term)
        if not sess:
            return
        try:
            with urllib.request.urlopen(BASE_URL + "/state", timeout=3) as r:
                items = json.loads(r.read().decode())
        except Exception:
            return
        for it in items:
            if it.get("session") == sess and (it.get("detail") or it.get("last")):
                GLib.idle_add(found, it.get("detail") or it["last"], it.get("project"))
                return
        notify_popup("Sin respuesta guardada" if ES else "No reply captured",
                     "Esta sesion aun no tiene una respuesta capturada por los hooks" if ES else
                     "This session has no hook-captured reply yet")
    threading.Thread(target=work, daemon=True).start()


def exit_copy_mode(term):
    """Si el pane activo esta en modo copia (highlight de tmux), salir para que
    el paste entre como TEXTO y no como teclas del modo copia."""
    sess = term_session(term)
    if sess:
        r = tmuxc("display-message", "-p", "-t", f"={sess}:", "#{pane_in_mode}")
        if r.stdout.strip() == "1":
            tmuxc("send-keys", "-t", f"={sess}:", "-X", "cancel")
            return True
    return False


def open_url(url, parent=None, timestamp=0):
    """Abre una URL en el navegador default — o una RUTA LOCAL con su app
    default (xdg-open): archivos, carpetas, PDFs, imágenes; nunca ejecuta.
    En WSL prefiere `wslview`; en macOS `open`; en Linux nativo usa el
    contexto del click, con fallbacks a GIO y `xdg-open`."""
    if isinstance(url, str) and url[:1] in ("/", "~"):
        path = os.path.expanduser(re.sub(r":\d+$", "", url.strip()))
        if os.path.exists(path):
            try:
                subprocess.Popen(["xdg-open" if sys.platform != "darwin" else "open", path],
                                 start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
            return
    is_wsl = False
    try:
        with open("/proc/sys/kernel/osrelease") as f:
            is_wsl = "microsoft" in f.read().lower()
    except Exception:
        pass
    if sys.platform == "darwin":
        opener = "open"
    elif is_wsl and shutil.which("wslview"):
        opener = "wslview"
    else:
        if parent is not None:
            try:
                if Gtk.show_uri_on_window(parent, url, timestamp):
                    return True
            except Exception:
                pass
        try:
            if Gio.AppInfo.launch_default_for_uri(url, None):
                return True
        except Exception:
            pass
        opener = "xdg-open"
    try:
        subprocess.Popen([opener, url], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except Exception:
        return False


def _clean_local_path(url):
    """'/a/b.py:12' o '~/x' -> ruta absoluta existente, o '' si no es archivo."""
    if not isinstance(url, str) or url[:1] not in ("/", "~"):
        return ""
    path = os.path.expanduser(re.sub(r":\d+$", "", url.strip()))
    return path if os.path.exists(path) else ""


def reveal_in_file_manager(path):
    """Abre el EXPLORADOR de archivos con el archivo RESALTADO (no lo abre con
    su app). Estándar org.freedesktop.FileManager1.ShowItems — lo implementan
    Nautilus, Nemo, Dolphin, Caja, Thunar…; si no responde, abre la carpeta
    contenedora con xdg-open."""
    path = _clean_local_path(path) or os.path.expanduser(re.sub(r":\d+$", "", str(path).strip()))
    try:
        uri = GLib.filename_to_uri(path, None)
        r = subprocess.run(
            ["gdbus", "call", "--session",
             "--dest", "org.freedesktop.FileManager1",
             "--object-path", "/org/freedesktop/FileManager1",
             "--method", "org.freedesktop.FileManager1.ShowItems",
             "[" + GLib.Variant("s", uri).print_(False) + "]", ""],
            timeout=4, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if r.returncode == 0:
            return True
    except Exception:
        pass
    # Fallback: abrir la carpeta contenedora (no el archivo).
    folder = path if os.path.isdir(path) else os.path.dirname(path)
    try:
        subprocess.Popen(["xdg-open" if sys.platform != "darwin" else "open", folder],
                         start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except Exception:
        return False


def link_actions_popover(term, event, url):
    """Popover al hacer click en una ruta/link de la terminal. Rutas locales:
    ABRIR CARPETA (explorador, resaltado) por defecto + botones Abrir archivo y
    Copiar. Links web: Abrir (navegador) + Copiar. Nada se abre sin que el
    usuario elija."""
    is_path = bool(_clean_local_path(url)) or url[:1] in ("/", "~")
    disp = re.sub(r"^file://", "", url)
    home = os.path.expanduser("~")
    disp_short = ("~" + disp[len(home):]) if disp.startswith(home) else disp
    pop = Gtk.Popover()
    pop.set_relative_to(term)
    rect = Gdk.Rectangle()
    rect.x, rect.y, rect.width, rect.height = int(event.x), int(event.y), 1, 1
    pop.set_pointing_to(rect)
    pop.set_position(Gtk.PositionType.BOTTOM)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
    for m in ("start", "end", "top", "bottom"):
        getattr(box, f"set_margin_{m}")(8)
    lbl = Gtk.Label(xalign=0)
    lbl.set_markup(f'<span size="small" font_family="monospace">{GLib.markup_escape_text(disp_short[:80])}</span>')
    lbl.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
    lbl.set_max_width_chars(46)
    box.pack_start(lbl, False, False, 0)
    box.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 2)

    def row(icon, label, cb):
        b = Gtk.Button()
        b.set_relief(Gtk.ReliefStyle.NONE)
        inner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        inner.pack_start(_themed_icon_image(icon, 15), False, False, 0)
        tl = Gtk.Label(label=label, xalign=0)
        inner.pack_start(tl, True, True, 0)
        b.add(inner)
        b.get_style_context().add_class("tabplus")

        def go(*_a):
            pop.popdown()
            try:
                cb()
            except Exception:
                pass
        b.connect("clicked", go)
        box.pack_start(b, False, False, 0)
        return b

    if is_path:
        row("folder-open", "Abrir carpeta" if ES else "Open folder",
            lambda: reveal_in_file_manager(url))
        row("file", "Abrir archivo" if ES else "Open file",
            lambda: open_url(url, term.get_toplevel(), getattr(event, "time", 0)))
        row("copy", "Copiar ruta" if ES else "Copy path",
            lambda: copy_text_to_clipboard(disp))
    else:
        row("external-link", "Abrir" if ES else "Open",
            lambda: open_url(url, term.get_toplevel(), getattr(event, "time", 0)))
        row("copy", "Copiar link" if ES else "Copy link",
            lambda: copy_text_to_clipboard(url))
    pop.add(box)
    box.show_all()
    pop.popup()


def on_term_release(term, event):
    """Al soltar el mouse: 1) si fue un CLICK limpio sobre una URL, abrirla;
    2) marcar que pudo quedar seleccion tmux (el primer keypress la limpia)."""
    press = getattr(term, "_primary_press", None)
    term._primary_press = None
    term._sel_flag = True
    if term.get_has_selection():
        copy_vte_selection(term)
    if press and event.button == 1:
        x, y, url, pane_id = press
        clean_click = abs(event.x - x) < 5 and abs(event.y - y) < 5
        if clean_click:
            if pane_id:
                tmuxc("select-pane", "-t", pane_id)
            if url:
                # Click simple: NO abrir directo. Popover con opciones — para
                # rutas locales, abrir carpeta (explorador) es lo principal;
                # además Copiar y Abrir archivo. Para links: Abrir + Copiar.
                link_actions_popover(term, event, url)
    return False


def on_term_button(term, event):
    # Ctrl+click: acción directa RÁPIDA (sin popover) — link al navegador,
    # ruta local al EXPLORADOR de archivos (resaltada), nunca abre el archivo.
    if event.button == 1 and (event.state & Gdk.ModifierType.CONTROL_MASK):
        try:
            match, _tag = term.match_check_event(event)
            url = url_at_event(term, event, match or "")
            if url:
                if _clean_local_path(url):
                    reveal_in_file_manager(url)
                else:
                    open_url(url, term.get_toplevel(), getattr(event, "time", 0))
                return True
        except Exception:
            pass
        return False
    # Click simple: recordar URL y pane. Se actua al SOLTAR solo si no hubo
    # arrastre, para que seleccionar texto no provoque un redraw de tmux.
    if event.button == 1:
        pane_id, _npanes = pane_at(term, event)
        try:
            match, _tag = term.match_check_event(event)
            url = url_at_event(term, event, match or "")
        except Exception:
            url = None
        term._primary_press = (event.x, event.y, url, pane_id)
        return False
    if event.button != 3:
        return False
    box = term.get_parent()
    menu = Gtk.Menu()

    def item(label, cb, sensitive=True, danger=False):
        it = Gtk.MenuItem(label=label)
        it.connect("activate", lambda *_: cb())
        it.set_sensitive(sensitive)
        if danger and hasattr(it, "get_style_context"):
            it.get_style_context().add_class("cc-danger")
        menu.append(it)

    key = getattr(box, "_key", None)
    cur_sess = term_session(term)          # sesion realmente mostrada (hub incluido)
    pane_id, npanes = pane_at(term, event)  # pane bajo el cursor
    if pane_id:
        tmuxc("select-pane", "-t", pane_id)
    ssh_host = ssh_host_from_session(cur_sess)
    is_ssh = bool(ssh_host)

    def split(flags, cmd=None):
        target = pane_id or (("=" + cur_sess + ":") if cur_sess else None)
        if not target:
            return
        args = ["split-window"] + flags + ["-t", target]
        if cmd:
            args.append(cmd)
        else:
            r = tmuxc("display-message", "-p", "-t", target, "#{pane_current_path}")
            cwd = r.stdout.strip()
            if cwd:
                args += ["-c", cwd]
        tmuxc(*args)

    # Hay DOS tipos de seleccion: la de la terminal (VTE, con Shift+arrastrar)
    # y la de tmux (arrastrar normal, es la que persiste). Copiar cubre ambas.
    copy_pane = copy_mode_pane(cur_sess, pane_id)

    def do_copy():
        if copy_vte_selection(term):
            return
        target = copy_mode_pane(term_session(term), pane_id) or copy_pane
        if target and copy_tmux_selection_to_clipboard(target):
            return
        if time.monotonic() - getattr(term, "_last_selection_copy", 0) < 15:
            notify_popup("Seleccion copiada" if ES else "Selection copied",
                         "Ya estaba en el portapapeles" if ES else "Already on the clipboard")
            return
        notify_popup("No se pudo copiar" if ES else "Could not copy",
                     "No encontre una seleccion activa" if ES else "No active selection found")

    item(("Copiar                   Ctrl+C" if ES else "Copy                     Ctrl+C"), do_copy,
         sensitive=True)
    item(("Pegar                    Ctrl+V" if ES else "Paste                    Ctrl+V"),
         lambda: (exit_copy_mode(term), term.paste_clipboard()))
    item("Copiar respuesta de Claude" if ES else "Copy Claude's reply", lambda: copy_claude_reply(term))
    item("Guardar respuesta como .txt" if ES else "Save reply as .txt", lambda: export_claude_reply(term, "txt"))
    item("Guardar respuesta como PDF" if ES else "Save reply as PDF", lambda: export_claude_reply(term, "pdf"))
    menu.append(Gtk.SeparatorMenuItem())
    if is_ssh:
        host = ssh_host
        sshcmd = f"ssh {host}"
        item("Split derecha    (otra conexion al server)" if ES else "Split right    (new connection to server)", lambda: split(["-h"], sshcmd))
        item("Split izquierda  (otra conexion al server)" if ES else "Split left     (new connection to server)", lambda: split(["-h", "-b"], sshcmd))
        item("Split abajo      (otra conexion al server)" if ES else "Split down     (new connection to server)", lambda: split(["-v"], sshcmd))
        item("Split arriba     (otra conexion al server)" if ES else "Split up       (new connection to server)", lambda: split(["-v", "-b"], sshcmd))
        item("Split local (tu maquina, derecha)" if ES else "Local split (your machine, right)", lambda: split(["-h"]))
    else:
        item("Split derecha" if ES else "Split right", lambda: split(["-h"]))
        item("Split izquierda" if ES else "Split left", lambda: split(["-h", "-b"]))
        item("Split abajo" if ES else "Split down", lambda: split(["-v"]))
        item("Split arriba" if ES else "Split up", lambda: split(["-v", "-b"]))
    item("Alternar ventana 1/2     Ctrl-b l" if ES else "Toggle window 1/2        Ctrl-b l", lambda: feed(term, b"\x02l"))
    item("Cerrar ESTE split" if ES else "Close THIS split",
         lambda: close_split_guarded(cur_sess, pane_id),
         sensitive=bool(pane_id) and npanes > 1 and bool(cur_sess), danger=True)
    menu.append(Gtk.SeparatorMenuItem())
    item("Iniciar sesión de IA aquí…" if ES else "Start AI session here…",
         lambda: open_ai_session_here(cur_sess or str(key or "").partition(":")[0], pane_id))
    item("Nueva terminal aqui       Ctrl+T" if ES else "New terminal here         Ctrl+T", new_local_tab)
    item("Terminal experimental (xterm.js)  Ctrl+Shift+T"
         if ES else "Experimental terminal (xterm.js)  Ctrl+Shift+T",
         lambda: open_xterm_tab("local"))
    item("Abrir proyecto..." if ES else "Open project...", new_session_dialog)
    sub = Gtk.Menu()
    r = tmuxc("list-sessions", "-F", "#{session_name}")
    for s in (r.stdout.split() if r.returncode == 0 else []):
        si = Gtk.MenuItem(label=s)
        si.connect("activate", lambda _w, s=s: open_tab(s, "claude"))
        sub.append(si)
    mi = Gtk.MenuItem(label="Abrir sesion existente" if ES else "Open existing session")
    mi.set_submenu(sub)
    menu.append(mi)
    menu.append(Gtk.SeparatorMenuItem())
    append_work_mark_menu(menu, cur_sess, pane_id)
    key = getattr(box, "_key", None)
    item("Renombrar pestana..." if ES else "Rename tab...", lambda: rename_tab(key), sensitive=key is not None)
    item("Cerrar pestana" if ES else "Close tab", lambda: close_tab(key), sensitive=key is not None, danger=True)
    menu.show_all()
    menu.popup_at_pointer(event)
    term._menu = menu
    return True


win = Gtk.Window(title="ComandOS")
win.set_wmclass("comandos", "comandos")
win.set_default_size(1600, 880)
win.set_icon_name("centro-claude")

# HeaderBar custom — reemplaza el titlebar del WM. Los botones min/max/close
# los dibujamos NOSOTROS con el mismo helper de icon-button que el resto de
# los controles, así todo el header comparte tamaño/padding/hover (lo del WM
# se ve inconsistente porque usa un widget aparte, `titlebutton`).
_headerbar = Gtk.HeaderBar()
_headerbar.set_show_close_button(False)
_headerbar.get_style_context().add_class("cc-headerbar")
# Marca ComandOS a la izquierda del headerbar.
_hb_brand = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
_hb_dot = Gtk.Label()
_hb_dot.set_markup(f'<span size="10500" foreground="{THEME["brand"]}">●</span>')
_hb_brandlbl = Gtk.Label(label="COMANDOS")
_hb_brandlbl.get_style_context().add_class("cc-brand")
_hb_brand.pack_start(_hb_dot, False, False, 0)
_hb_brand.pack_start(_hb_brandlbl, False, False, 0)
_headerbar.pack_start(_hb_brand)
# set_decorated(False) = sin decoration del WM = Windows DWM no dibuja sombra
# externa. Trade-off: perdemos el drag del headerbar automático, así que lo
# cablamos a mano abajo (button-press → begin_move_drag).
win.set_decorated(False)
# Ya NO hacemos set_titlebar — el headerbar se agrega como widget del layout
# principal en el bootstrap del content (junto con `paned`).

# CSS del headerbar — mono tracked wordmark + fondo del theme para que empate
# con el resto de la app (evita el gradient default del theme del sistema).
_HB_CSS = Gtk.CssProvider()

def _build_hb_css():
    """Genera el CSS de la app usando el theme actual. Se llama al arrancar y
    de nuevo desde apply_theme() cuando el user cambia noche/dia/calido/termius,
    así el headerbar, menús, paned separator, etc. cambian con el tema."""
    return (
    b".pane-pill{background:" + THEME["bg"].encode() + b";"
