# Pomodoro · Notificaciones · Ajustes: viven AQUÍ, a la altura de min/max
# (es la barra siempre visible). Cada uno dispara su control del tablero.
def _dash_click(elem_id):
    def go(*_):
        try:
            # el tablero es el panel izquierdo del paned: si está plegado, se abre
            try:
                if _SIDE.get("leftHidden"):     # oculto: se muestra a TU ancho, sin ensancharlo
                    _left_panel_set(False)
            except Exception:
                pass
            wv.run_javascript(f"try{{document.getElementById('{elem_id}').click()}}catch(e){{}}", None, None, None)
        except Exception:
            pass
    return go

_POPOVERS = {}


def _panel_popover(btn, panel, width, height):
    """Popover nativo pegado al icono con el MISMO panel del tablero
    (index.html?panel=...): mismo tema y mismo código, pero junto al botón."""
    def go(*_):
        pop = _POPOVERS.get(panel)
        if pop is None:
            pop = Gtk.Popover.new(btn)
            pop.set_position(Gtk.PositionType.BOTTOM)
            pop.get_style_context().add_class("cc-popover")
            pv = WebKit2.WebView()
            pv.set_size_request(width, height)
            try:
                pv.set_background_color(Gdk.RGBA(0, 0, 0, 0))
            except Exception:
                pass
            pv.get_settings().set_property("enable-webaudio", True)
            pop.add(pv)
            pop._pv = pv
            _POPOVERS[panel] = pop
        if not getattr(pop, "_loaded", False):
            pop._pv.load_uri(f"{BASE_URL}/?panel={panel}&v={_DASH_V}")
            pop._loaded = True
        else:
            # El Pomodoro vive en el backend (GET/POST /pomodoro); refrescar basta.
            pop._pv.run_javascript("try{typeof pomoRender==='function'&&pomoRender();typeof notifRender==='function'&&notifRender()}catch(e){}", None, None, None)
        pop.show_all()
        pop.popup()
    return go


# Reloj de arena de Davitheoles (grill 29-sep): 27 cuadros originales de 32 px.
# La arena ES el tiempo del bloque (cuadros 0-20), con un goteo de +1 cuadro
# mientras corre; en pausa se congela atenuado y al terminar gira (21-26).
# Mismo cálculo que P.hourglassFrame en dash/pomodoro.js.
HOURGLASS_SHEET = os.path.join(CC_REPO, "assets", "pomodoro", "comandos", "hourglass.png")
HOURGLASS_FRAME_PX, HOURGLASS_FPS = 32, 9


def hourglass_sheet_frames(sheet_width, sheet_height, scale=1.0):
    """Source rectangles (x, y, w, h) of each native frame in the strip."""
    n = max(1, sheet_width // HOURGLASS_FRAME_PX)
    return [(i * HOURGLASS_FRAME_PX, 0, HOURGLASS_FRAME_PX, min(HOURGLASS_FRAME_PX, sheet_height)) for i in range(n)]


def hourglass_frame(block, now_ms, flip_start_ms):
    """Cuadro del reloj (grill 30-sep: siempre animado con sus sprites): la arena cae
    cuadro a cuadro y el vidrio se voltea, en bucle; flip_start_ms repite el giro al
    terminar un bloque. Igual que P.hourglassFrame en dash/pomodoro.js."""
    if flip_start_ms is not None and 0 <= now_ms - flip_start_ms < 6 * 110:
        return 21 + int((now_ms - flip_start_ms) // 110)
    fill = 21 * 350
    t = now_ms % (fill + 6 * 110)
    return int(t // 350) if t < fill else 21 + int((t - fill) // 110)


_HOURGLASS = {"frames": [], "dim": [], "index": -1, "image": None, "source": None,
              "block": None, "offset": 0, "flip": None, "seen": None, "fetching": False, "polled": 0.0}


def _hourglass_frames(scale=0.75):
    if not _HOURGLASS["frames"]:
        try:
            sheet = GdkPixbuf.Pixbuf.new_from_file(HOURGLASS_SHEET)
            px = int(HOURGLASS_FRAME_PX * scale)
            for (x, y, w, h) in hourglass_sheet_frames(sheet.get_width(), sheet.get_height()):
                pb = sheet.new_subpixbuf(x, y, w, h).scale_simple(px, px, GdkPixbuf.InterpType.NEAREST)
                dim = pb.copy()
                pb.saturate_and_pixelate(dim, 0.45, False)
                _HOURGLASS["frames"].append(pb)
                _HOURGLASS["dim"].append(dim)
        except Exception as exc:
            print(f"hourglass: {exc}", file=sys.stderr)
    return _HOURGLASS["frames"]


def _hourglass_poll():
    """El bloque vive en el backend: se lee /pomodoro cada 2 s en otro hilo."""
    if _HOURGLASS["fetching"] or time.time() - _HOURGLASS["polled"] < 2:
        return
    _HOURGLASS["fetching"], _HOURGLASS["polled"] = True, time.time()

    def run():
        try:
            with urllib.request.urlopen(BASE_URL + "/pomodoro", timeout=3) as r:
                data = json.loads(r.read().decode())
            GLib.idle_add(_hourglass_adopt, data)
        except Exception:
            pass
        finally:
            _HOURGLASS["fetching"] = False
    threading.Thread(target=run, daemon=True).start()


def _hourglass_adopt(data):
    block = data.get("block") if isinstance(data, dict) else None
    _HOURGLASS["offset"] = int(data.get("serverNowMs") or time.time() * 1000) - int(time.time() * 1000)
    if block and block.get("status") == "completed" and _HOURGLASS["seen"] not in (None, block.get("blockId")):
        _HOURGLASS["flip"] = int(time.time() * 1000) + _HOURGLASS["offset"]   # gira una vez al terminar
    if block:
        _HOURGLASS["seen"] = block.get("blockId") if block.get("status") == "completed" else _HOURGLASS["seen"] or ""
    _HOURGLASS["block"] = block
    return False


def _hourglass_tick():
    frames = _HOURGLASS["frames"]
    if frames and _PRESENCE.get("visible", True):
        _hourglass_poll()
        now = int(time.time() * 1000) + _HOURGLASS["offset"]
        block = _HOURGLASS["block"]
        i = hourglass_frame(block, now if _animations_enabled() else 0, _HOURGLASS["flip"])
        paused = bool(block) and block.get("status") == "paused"
        key = (i, paused)
        if key != _HOURGLASS["index"]:
            _HOURGLASS["index"] = key
            _HOURGLASS["image"].set_from_pixbuf((_HOURGLASS["dim"] if paused else frames)[min(i, len(frames) - 1)])
    return True


def _hourglass_button(tooltip):
    frames = _hourglass_frames()
    if not frames:
        return _icon_btn("timer", tooltip, lambda *_: None)
    b = Gtk.Button()
    _HOURGLASS["image"] = Gtk.Image.new_from_pixbuf(frames[0])
    b.set_image(_HOURGLASS["image"])
    b.set_always_show_image(True)
    b.get_style_context().add_class("tabplus")
    b.set_relief(Gtk.ReliefStyle.NONE)
    b.set_tooltip_text(tooltip)
    # El reloj visible es el de la cabecera web (mismo asset); este botón solo
    # queda para el atajo, así que no arranca el ticker de cuadros.
    return b


