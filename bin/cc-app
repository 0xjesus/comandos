def _side_head_button(label, cls, tip, cb):
    b = Gtk.Button(label=label) if label else Gtk.Button()
    b.set_relief(Gtk.ReliefStyle.NONE)
    b.set_can_focus(False)
    for c in ("side-btn",) + tuple(cls):
        b.get_style_context().add_class(c)
    if tip:
        b.set_tooltip_text(tip)
    b.connect("clicked", cb)
    # la cabecera muestra el cursor de arrastre; sobre los botones, el de clic
    b.connect("realize", lambda w: w.get_event_window() and w.get_event_window().set_cursor(
        Gdk.Cursor.new_from_name(w.get_display(), "pointer")))
    return b


def _side_term_action(kind, tab=""):
    _dash_js_quiet(f"window.sidebarTermAction&&sidebarTermAction({json.dumps(kind)},{json.dumps(tab)})")


