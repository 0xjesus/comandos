APP_LAYOUT_FILE = os.path.expanduser("~/.claude/hooks/app-layout.json")


def _layout_load():
    try:
        with open(APP_LAYOUT_FILE) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


_SIDE = {"sess": "", "box": None, "boxes": {}, "hidden": False, "last_side_focus": False,
         **{k: v for k, v in _layout_load().items() if k in ("leftHidden", "leftPos", "termShare")}}


def _layout_save():
    try:
        tmp = APP_LAYOUT_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({k: _SIDE.get(k) for k in ("leftHidden", "leftPos", "termShare") if _SIDE.get(k) is not None}, f)
        os.replace(tmp, APP_LAYOUT_FILE)
    except Exception:
        pass


def _dash_js_quiet(code):
    """Como _dash_js pero sin desplegar el panel izquierdo si el usuario lo escondió."""
    try:
        wv.run_javascript(f"try{{{code}}}catch(e){{}}", None, None, None)
    except Exception:
        pass


def _side_term_box(sess):
    """Terminal de sesión para la barra: la misma receta que open_tab (VTE con tmux
    attach + cabecera de pane y marcos), sin pestaña propia en la tira."""
    box = _SIDE["boxes"].get(sess)
    if box is not None:
        return box
    target = shlex.quote("=" + sess)
    box = make_term(f"tmux attach -t {target} || {{ echo '[sesion terminada]'; exec cat; }}", session=sess)
    box._key = sess
    box._side = True
    box._term._session_hint = sess
    box._term._side = True
    _attach_model_bar(box, sess)
    box._label = sess
    _SIDE["boxes"][sess] = box
    return box


def _side_pin_pos():
    """Panel de la barra cerrado: el WebView mide justo hasta la fila de la barra
    (Comandos · Cadenas · Servidores) y la terminal nativa toma el resto. None si no
    aplica (panel abierto, sin terminal o sin alto)."""
    if not _SIDE.get("cmds_closed") or _SIDE.get("collapsed") or not _side_term_host.get_visible():
        return None
    h = int(_SIDE.get("cmds_h") or 0)
    if h < 40:
        return None
    try:
        h = int(round(h * (wv.get_zoom_level() or 1.0)))
    except Exception:
        pass
    lo, hi = _side_paned.get_property("min-position"), _side_paned.get_property("max-position")
    return max(lo, min(hi, h))


def _side_apply_pin():
    pos = _side_pin_pos()
    if pos is not None and _side_paned.get_position() != pos:
        _side_paned.set_position(pos)
    _SIDE["pin_queued"] = False
    return False


def _side_keep_layout():
    """Tras cada cambio de tamaño: plegada (sin terminal) o persiana fijada."""
    _side_term_keep_collapsed()
    if _side_pin_pos() is not None and not _SIDE.get("pin_queued"):
        _SIDE["pin_queued"] = True
        GLib.idle_add(_side_apply_pin)


def _side_term_apply_share():
    total = _side_paned.get_allocated_height()
    if _side_pin_pos() is not None:
        return _side_apply_pin()
    if total > 120 and _side_term_host.get_visible() and not _SIDE.get("collapsed"):
        share = float(_SIDE.get("termShare") or 0.42)
        _side_paned.set_position(int(total * (1 - min(0.85, max(0.15, share)))))
    return False


def _side_term_collapse(*_):
    """Sin terminal visible (escondidas con ▾ o ninguna): queda solo la cabecera."""
    if _SIDE.get("collapsed") and _side_term_host.get_visible():
        top = _side_paned.get_property("max-position")
        if _side_paned.get_position() != top:
            _side_paned.set_position(top)
    _SIDE["collapse_queued"] = False
    return False


def _side_term_keep_collapsed(*_):
    if _SIDE.get("collapsed") and not _SIDE.get("collapse_queued"):
        _SIDE["collapse_queued"] = True
        GLib.idle_add(_side_term_collapse)


def _side_tab_widget(t, hidden):
    """Pestaña = forma (EventBox .side-tab) con su nombre y su ✕; la ✕ pide
    «¿Cerrar?» antes (el estado lo lleva la barra web: t["closing"])."""
    ev = Gtk.EventBox()
    ev.set_valign(Gtk.Align.CENTER)       # el margen CSS no aplica a un EventBox: va por código
    ev.set_margin_start(3)
    ev.set_margin_end(3)
    ctx = ev.get_style_context()
    for c in ("side-tab",) + (("cur",) if t["on"] and not hidden else ()) + (("sel",) if t["sel"] else ()):
        ctx.add_class(c)
    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
    ev.add(row)
    k = t["id"]
    name = _side_head_button("", ("side-name",), t["title"], lambda *_a: _side_term_action("focus", k))
    inner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
    dot = Gtk.Label(label="●")
    dot.get_style_context().add_class("side-dot")
    inner.pack_start(dot, False, False, 0)
    inner.pack_start(Gtk.Label(label=t["label"]), False, False, 0)
    name.add(inner)
    row.pack_start(name, False, False, 0)
    closing = bool(t.get("closing"))
    row.pack_start(_side_head_button("¿Cerrar?" if closing else "✕", ("side-x",) + (("armed",) if closing else ()),
                                     "Otro clic la cierra" if closing else "Cerrar esta terminal",
                                     lambda *_a: _side_term_action("close", k)), False, False, 0)
    return ev


def _side_reveal_tab(w):
    """La píldora activa entra a la vista de la pista (al cambiar de terminal)."""
    a, adj = w.get_allocation(), _side_tabs_sw.get_hadjustment()
    if a.width > 1:
        if a.x < adj.get_value():
            adj.set_value(a.x)
        elif a.x + a.width > adj.get_value() + adj.get_page_size():
            adj.set_value(a.x + a.width - adj.get_page_size())
    return False


def _side_head_render():
    for c in _side_tabs.get_children():
        _side_tabs.remove(c)
        c.destroy()
    hidden = bool(_SIDE["hidden"])
    on_widget = None
    for t in _SIDE.get("tabs") or []:
        w = _side_tab_widget(t, hidden)
        _side_tabs.pack_start(w, False, False, 0)
        if t["on"]:
            on_widget = w
    on_id = next((t["id"] for t in _SIDE.get("tabs") or [] if t["on"]), "")
    if on_widget is not None and on_id != _SIDE.get("shown_tab"):
        GLib.idle_add(_side_reveal_tab, on_widget)
    _SIDE["shown_tab"] = on_id
    _side_tog.set_image(_themed_icon_image("chevron-up" if hidden else "chevron-down", 18))
    _side_tog.get_image().show()          # el botón es no_show_all: show_all no llega a su imagen
    _side_tog.set_tooltip_text("Mostrar las terminales" if hidden else "Esconder las terminales")
    _side_tog.set_visible(bool(_SIDE.get("tabs")))
    ctx = _side_head_ev.get_style_context()
    (ctx.add_class if hidden and _SIDE.get("tabs") else ctx.remove_class)("closed")
    _side_head_ev.show_all()
    GLib.idle_add(lambda: (_side_sync_arrows(), False)[1])


def _side_tabs_from_web(tabs):
    """Pestañas que manda la barra web (las mismas de .cs-terms en el remoto)."""
    out = []
    for t in (tabs if isinstance(tabs, list) else [])[:40]:
        if not isinstance(t, dict) or not SESSION_RE.match(str(t.get("id") or "")):
            continue
        out.append({"id": str(t["id"]), "label": str(t.get("label") or t["id"])[:40],
                    "title": str(t.get("title") or t["id"])[:120], "on": bool(t.get("on")), "sel": bool(t.get("sel")),
                    "closing": bool(t.get("closing"))})
    return out


def _side_term_show(sess):
    """Cabecera siempre visible; debajo, la terminal elegida (o nada, plegada)."""
    if sess and not SESSION_RE.match(sess):
        sess = ""
    cur = _SIDE["box"]
    want = sess if sess and not _SIDE["hidden"] and tmuxc("has-session", "-t", "=" + sess).returncode == 0 else ""
    box = _side_term_box(want) if want else None
    if cur is not None and cur is not box and cur.get_parent() is _side_term_host:
        _side_term_host.remove(cur)
    if box is not None and box.get_parent() is not _side_term_host:
        _side_term_host.pack_start(box, True, True, 0)
    was_open = _side_term_host.get_visible() and not _SIDE.get("collapsed")
    pinned_before = _SIDE.get("pinned", False)
    _SIDE["box"], _SIDE["sess"], _SIDE["collapsed"] = box, sess, box is None
    _side_head_render()
    _side_term_host.show()
    if _SIDE.get("sheet_open"):
        # el panel de la barra flota encima de la terminal: en el escritorio el WebView
        # ocupa la columna y la terminal nativa se aparta hasta que se cierre
        _side_term_host.hide()
        _SIDE["pinned"] = False
    elif box is not None:
        box.show_all()
        _SIDE["pinned"] = bool(_SIDE.get("cmds_closed"))
        # con el panel de la barra cerrado, el WebView se ajusta a la fila de la barra
        if not was_open or pinned_before != _SIDE["pinned"] or _SIDE["pinned"]:
            GLib.idle_add(_side_term_apply_share)
    else:
        _SIDE["pinned"] = False
        _side_term_keep_collapsed()
    # pestañas de la barra cerradas: soltar las terminales que ya no existen
    for k, b in list(_SIDE["boxes"].items()):
        if k != sess and tmuxc("has-session", "-t", "=" + k).returncode != 0:
            _SIDE["boxes"].pop(k, None)
            try:
                b.destroy()
            except Exception:
                pass


def _side_term_save_share(*_):
    total = _side_paned.get_allocated_height()
    if _side_pin_pos() is not None:      # con la persiana plegada el reparto no es del usuario
        return
    if total > 120 and _side_term_host.get_visible() and not _SIDE.get("collapsed"):
        _SIDE["termShare"] = round(1 - _side_paned.get_position() / total, 3)
        _layout_save()


def _side_paned_moved(*_):
    if _SIDE.get("collapsed"):
        _side_term_keep_collapsed()
    elif _side_pin_pos() is not None:
        _side_keep_layout()
    else:
        GLib.timeout_add(600, lambda: (_side_term_save_share(), False)[1])


_side_paned.connect("notify::position", _side_paned_moved)
_side_paned.connect("size-allocate", lambda *_: _side_keep_layout())


def _side_head_press(_w, ev):
    if ev.button != 1 or ev.type != Gdk.EventType.BUTTON_PRESS or _SIDE.get("collapsed") or _side_pin_pos() is not None:
        return False
    _SIDE["drag"] = (ev.y_root, _side_paned.get_position())
    _side_head_ev.get_style_context().add_class("dragging")
    return True


def _side_head_motion(_w, ev):
    d = _SIDE.get("drag")
    if not d:
        return False
    lo, hi = _side_paned.get_property("min-position"), _side_paned.get_property("max-position")
    _side_paned.set_position(max(lo, min(hi, int(d[1] + ev.y_root - d[0]))))
    return True


def _side_head_release(_w, ev):
    if not _SIDE.pop("drag", None):
        return False
    _side_head_ev.get_style_context().remove_class("dragging")
    _side_term_save_share()
    return True


_side_head_ev.connect("button-press-event", _side_head_press)
_side_head_ev.connect("motion-notify-event", _side_head_motion)
_side_head_ev.connect("button-release-event", _side_head_release)


def _side_term_focused(term):
    """Clic dentro de una terminal: si es la de la barra, la barra manda ahí; si es
    una pestaña, deja de mandar a la de la barra (el destino vuelve a la pestaña)."""
    side = bool(getattr(term, "_side", False))
    if side:
        _SIDE["last_side_focus"] = True
        _dash_js_quiet(f"window.sidebarTermFocused&&sidebarTermFocused({json.dumps(_SIDE['sess'])})")
    elif _SIDE["last_side_focus"]:
        _SIDE["last_side_focus"] = False
        _dash_js_quiet("window.sidebarTermFocused&&sidebarTermFocused('')")
    return False


_LEFT_FX = {"snap": None, "da": None}
LEFT_FX_MS = 220


def _left_fx_clear():
    da = _LEFT_FX.get("da")
    _LEFT_FX["da"] = None
    if da is not None:
        try:
            modal_overlay.remove(da)
            da.destroy()
        except Exception:
            pass


def _left_fx_snapshot():
    """El panel tal como se ve ahora (del framebuffer de la ventana), o None."""
    try:
        a = _side_paned.get_allocation()
        if not _side_paned.get_mapped() or a.width < 40 or a.height < 40:
            return None
        pb = Gdk.pixbuf_get_from_window(_side_paned.get_window(), a.x, a.y, a.width, a.height)
        xy = _side_paned.translate_coordinates(modal_overlay, 0, 0)   # (x, y) o None; PyGObject no da «ok»
        return (pb, xy[-2], xy[-1], a.width, a.height) if pb is not None and xy else None
    except Exception:
        return None


def _left_fx_run(hiding, snap, width):
    """Desliza el panel (1-oct): las terminales cambian de tamaño UNA vez y lo que
    se anima es la imagen del panel encima. Animar la posición del paned las
    redimensionaría en cada cuadro y tmux haría redibujar a Claude Code cada vez."""
    _left_fx_clear()
    if not _animations_enabled():
        return
    if snap:
        x0, y0, h = snap[1], snap[2], snap[4]
    else:                                              # sin imagen: el hueco del panel dentro del paned
        xy = paned.translate_coordinates(modal_overlay, 0, 0)
        if not xy:
            return
        x0, y0 = xy[-2], xy[-1]
        h = paned.get_allocated_height()
    bar = Gdk.RGBA()
    bar.parse(THEME.get("bar", "#0a121b"))
    state = {"e": 0.0}
    da = Gtk.DrawingArea()
    da.set_halign(Gtk.Align.FILL)
    da.set_valign(Gtk.Align.FILL)

    def draw(_w, cr):
        e = state["e"]
        k = e if hiding else 1 - e                     # 0 = en su sitio, 1 = fuera por la izquierda
        off = -width * k
        if not hiding:                                 # lo que aún no entra se tapa: nada de doble panel
            start = max(x0, x0 + width + off)
            cr.set_source_rgba(bar.red, bar.green, bar.blue, 1)
            cr.rectangle(start, y0, x0 + width - start, h)
            cr.fill()
        if snap:
            cr.save()
            cr.rectangle(x0, y0, width, h)
            cr.clip()
            Gdk.cairo_set_source_pixbuf(cr, snap[0], x0 + off, y0)
            cr.paint_with_alpha(1 - 0.45 * k)
            cr.restore()
        edge = x0 + width + off                        # sombra suave en el borde que se mueve
        if 0 < k < 1 and edge > x0:
            g = cairo.LinearGradient(edge, 0, edge + 18, 0)
            g.add_color_stop_rgba(0, 0, 0, 0, 0.28 * (1 - k))
            g.add_color_stop_rgba(1, 0, 0, 0, 0)
            cr.rectangle(edge, y0, 18, h)
            cr.set_source(g)
            cr.fill()
        return False

    da.connect("draw", draw)
    modal_overlay.add_overlay(da)
    modal_overlay.set_overlay_pass_through(da, True)
    da.show()
    _LEFT_FX["da"] = da

    def step(v):
        state["e"] = v
        da.queue_draw()

    _tween(da, step, 0.0, 1.0, ms=LEFT_FX_MS, done=lambda: (da is _LEFT_FX.get("da")) and _left_fx_clear())


def _left_panel_set(hidden, animate=True):
    """Panel izquierdo (tablero + terminal de la barra) oculto DEL TODO, como el
    remoto (grill 1-oct: «oculto del todo»). Antes se plegaba con set_position(0),
    pero el panel va con shrink=False y GTK lo dejaba en su ancho mínimo (~98 px):
    una tira con media rejilla. ``leftHidden`` es la verdad, no la posición."""
    hidden = bool(hidden)
    was_hidden = not _side_paned.get_visible()
    if hidden:
        pos = paned.get_position()
        if _side_paned.get_visible() and pos >= 200:
            _SIDE["leftPos"] = pos
        snap = _left_fx_snapshot() if animate and not was_hidden else None
        if snap:
            _LEFT_FX["snap"] = snap
            _left_fx_run(True, snap, snap[3])          # la imagen tapa el hueco antes del primer cuadro
        _side_paned.hide()
    else:
        target = max(280, int(_SIDE.get("leftPos") or 620))
        if animate and was_hidden:
            snap = _LEFT_FX.get("snap")
            if snap and abs(snap[3] - target) > 2:
                snap = None                            # otra anchura: barrido sin imagen
            _left_fx_run(False, snap, target)
        _side_paned.show()
        paned.set_position(target)
    _SIDE["leftHidden"] = hidden
    _left_btn_paint()
    _layout_save()
    _dash_js_quiet(f"window.appLeftPanel&&appLeftPanel({'true' if hidden else 'false'})")


def _left_panel_toggle(*_):
    _left_panel_set(not _SIDE.get("leftHidden"))


def _left_btn_paint():
    # Oculto = icono en el acento, como #tab-left[aria-pressed=true] en el remoto.
    _left_btn.set_image(_themed_icon_image("panel-left", 18, THEME.get("brand") if _SIDE.get("leftHidden") else None))
    _left_btn.set_tooltip_text(("Mostrar el panel izquierdo" if _SIDE.get("leftHidden") else "Ocultar el panel izquierdo")
                               if ES else ("Show the left panel" if _SIDE.get("leftHidden") else "Hide the left panel"))


_READER = {"wv": None, "open": False, "terminal": False, "share": 0.58}


def reader_layout_state(open, terminal):
    """Qué se ve: sin terminal el resumen ocupa el área; con terminal, ella a la izquierda."""
    return {"terminals": bool(terminal) or not open, "reader": bool(open)}


def _reader_apply():
    st = reader_layout_state(_READER["open"], _READER["terminal"])
    _shelf_paned.set_visible(st["terminals"])
    if st["reader"]:
        _reader_host.show()
        if _READER["wv"] is not None:
            _READER["wv"].show()
        if st["terminals"]:
            GLib.idle_add(lambda: (_reader_paned.set_position(
                int(_reader_paned.get_allocated_width() * (1 - _READER["share"]))), False)[1])
    else:
        _reader_host.hide()
    return False


def reader_open(edition_id=""):
    if _READER["wv"] is None:
        view = WebKit2.WebView.new_with_user_content_manager(ucm)
        _reader_host.pack_start(view, True, True, 0)
        _READER["wv"] = view
    if not _READER["open"] or edition_id or _READER["wv"].get_uri() is None:
        extra = f"&news={quote(edition_id)}" if edition_id else ""
        _READER["wv"].load_uri(f"{BASE_URL}/?panel=news&v={_DASH_V}{extra}")
    _READER["open"] = True
    _reader_apply()
    _READER["wv"].grab_focus()
    return False


def reader_close():
    _READER["open"] = False
    return _reader_apply()


def reader_toggle():
    return reader_close() if _READER["open"] else reader_open()


def reader_terminal(on):
    _READER["terminal"] = bool(on)
    return _reader_apply()
nb.connect("switch-page", _close_extension_shelf)
nb.get_style_context().add_class("cc-notebook")
