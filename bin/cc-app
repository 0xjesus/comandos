#!/usr/bin/env python3
"""Centro Claude: tablero + MULTIPLES terminales embebidas en pestanas.

Izquierda: el tablero. Derecha: pestanas de terminal (VTE, motor de Tilix):
  - Pestana "hub": cliente tmux libre (lo mueven Super+N y los popups).
  - UNA pestana por sesion tmux: "Abrir" la enfoca (ventana claude) y
    "Consola" enfoca la MISMA pestana cambiando a la ventana shell — puedes
    tener LifeOS, Merauto y las que quieras a la vez, sin duplicados.
  - Click derecho -> "Renombrar pestana...": el nombre persiste al reiniciar.

Teclas:
  F12                    mostrar/ocultar terminales
  F5                     recargar tablero
  Ctrl+PgUp / Ctrl+PgDn  cambiar de pestana
  Ctrl+G                 mosaico: TODAS las sesiones en una pantalla
  Ctrl+Shift + / - / 0   zoom de letra (pestana actual)
  Ctrl+Q                 salir
"""
import contextlib, glob, json, os, re, secrets, shlex, shutil, subprocess, sys, tempfile, threading, time, urllib.request
from concurrent.futures import ThreadPoolExecutor
from urllib.parse import quote, unquote, urlencode, urlparse
# Cada pestaña es un VTE que corre `tmux attach`. Si cc-app se lanza DESDE dentro
# de una sesión tmux (p.ej. un dev relanzándolo en su terminal), $TMUX se hereda y
# TODOS los attach fallan con "sessions should be nested with care" → "no se ve
# nada". Limpiarlo aquí, una vez, blinda al app pase lo que pase con quien lo lance.
os.environ.pop("TMUX", None)
os.environ.pop("TMUX_PANE", None)
# This is an interactive terminal, even when launched from an automation CLI.
os.environ.pop("NO_COLOR", None)
# macOS no tiene GTK/VTE: despachamos a la app nativa (PyObjC + WKWebView) ANTES
# de tocar `gi`. os.execv reemplaza el proceso pasando argv intacto; el symlink
# de ~/.local/bin ya resolvio a este archivo real dentro del repo, asi que el
# hermano cc-app-mac vive junto a nosotros.
if sys.platform == "darwin":
    _mac = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cc-app-mac")
    os.execv(_mac, [_mac, *sys.argv[1:]])

# INSTANCIA ÚNICA: dos cc-app a la vez = ventanas duplicadas donde una corre
# código viejo y "los fixes no se ven" (nos pasó varias veces). flock exclusivo
# sobre un lockfile por usuario+display; si ya hay uno vivo, activamos su
# ventana (best-effort) y salimos SIN tocar al otro proceso.
import fcntl as _fcntl
_LOCK_NAME = f"cc-app-{(os.environ.get('DISPLAY') or 'x').replace('/', '_').replace(':', '')}.lock"
# El lockfile prefiere XDG_RUNTIME_DIR, pero ese dir puede quedar inaccesible
# (p.ej. /run/user/1000 remontado como root): NUNCA crashear por el candado —
# cae a /tmp. El singleton es una comodidad, no un requisito para arrancar.
_LOCK_FH = None
for _base in (os.environ.get("XDG_RUNTIME_DIR"), f"/tmp/comandos-{os.getuid()}", "/tmp"):
    if not _base:
        continue
    try:
        os.makedirs(_base, exist_ok=True)
        _LOCK_FH = open(os.path.join(_base, _LOCK_NAME), "w")
        break
    except OSError:
        continue
if _LOCK_FH is None:                        # sin lockfile posible: seguir sin singleton
    class _NullLock:
        def write(self, *_a): pass
        def flush(self): pass
    _LOCK_FH = _NullLock()
if hasattr(_LOCK_FH, "fileno"):
    try:
        _fcntl.flock(_LOCK_FH, _fcntl.LOCK_EX | _fcntl.LOCK_NB)
        _LOCK_FH.write(str(os.getpid())); _LOCK_FH.flush()
    except OSError:
        print("ComandOS ya está corriendo; activando la ventana existente.")
        try:
            import subprocess as _sp
            _sp.run(["wmctrl", "-a", "ComandOS"], timeout=5,
                    stdout=_sp.DEVNULL, stderr=_sp.DEVNULL)
        except Exception:
            pass
        sys.exit(0)
import cairo
import gi
gi.require_version("Gtk", "3.0")
# WebKit2 4.1 en Ubuntu 24.04 (noble), 4.0 en 22.04 (jammy). Intenta 4.1 primero.
