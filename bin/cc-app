def show_new_tab_menu(btn):
    """Menú del botón '+': elegir motor de terminal.
    VTE (por defecto) es el estable; xterm.js es el experimental con ligas."""
    menu = Gtk.Menu()

    def add(label, cb):
        it = Gtk.MenuItem(label=label)
        it.connect("activate", lambda *_: cb())
        menu.append(it)

    if ES:
        add("Nueva terminal aquí (VTE)  ·  Ctrl+T", new_local_tab)
        add("Terminal experimental (xterm.js, con ligaduras)  ·  Ctrl+Shift+T",
            lambda: open_xterm_tab("local"))
    else:
        add("New terminal here (VTE)  ·  Ctrl+T", new_local_tab)
        add("Experimental terminal (xterm.js, with ligatures)  ·  Ctrl+Shift+T",
            lambda: open_xterm_tab("local"))
    menu.show_all()
    menu.popup_at_widget(btn, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)


