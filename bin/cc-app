def _term_line_scale(term):
    try:
        term.set_cell_height_scale(TERM_LINE_SCALE)
    except Exception:
        pass


def _ui_lang():
    """Idioma resuelto por cc-dash (CC_LANG en cc-notify.conf, o auto por $LANG)."""
    try:
        with urllib.request.urlopen(BASE_URL + "/conf", timeout=2) as r:
            l = json.loads(r.read().decode()).get("_lang")
            if l in ("es", "en"):
                return l
    except Exception:
        pass
    return "es" if os.environ.get("LANG", "").lower().startswith("es") else "en"


UI_LANG = _ui_lang()
ES = UI_LANG == "es"

