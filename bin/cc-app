Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), _HB_CSS, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def button_style_css(style, theme):
    """Botones de la cabecera (grill 29-sep): mismo tamaño y un estilo 3D elegible
    en Ajustes → Apariencia (sutil | arcade | tecla | pixel | consola). GTK no
    tiene transform: el «hundirse» se hace moviendo el margen y la sombra."""
    face, line, text, dim, bar = (theme.get(k, "#222A3A") for k in ("line", "line", "text", "dim", "bar"))
    face = theme.get("line2", face)
    edge = theme.get("bg", "#0A0D13")
    sel = "button.cc-key"      # teclas de acción: cabecera y lado derecho de la barra de pestañas
    base = (f"{sel}{{min-width:34px;min-height:34px;padding:0;margin:4px 3px 6px;"
            f"background-image:none;background-color:{face};color:{text};border:0;}}")
    styles = {
        "sutil": (f"{sel}{{border-radius:10px;background-color:{bar};border:1px solid {line};color:{dim};"
                  f"box-shadow:0 3px 0 {line};}}"
                  f"{sel}:hover{{color:{text};}}"
                  f"{sel}:active{{margin-top:6px;margin-bottom:4px;box-shadow:none;}}"),
        "arcade": (f"{sel}{{border-radius:999px;background-image:radial-gradient(circle at 50% 30%,shade({face},1.45),{face} 65%);"
                   f"box-shadow:0 0 0 3px {edge},0 5px 0 3px {edge},inset 0 -3px 0 rgba(0,0,0,0.25);}}"
                   f"{sel}:hover{{background-image:radial-gradient(circle at 50% 30%,shade({face},1.6),shade({face},1.1) 65%);}}"
                   f"{sel}:active{{margin-top:8px;margin-bottom:2px;box-shadow:0 0 0 3px {edge},0 1px 0 3px {edge};}}"),
        "tecla": (f"{sel}{{border-radius:10px;background-image:linear-gradient(to bottom,shade({face},1.25),{face});"
                  f"box-shadow:inset 0 1px 0 rgba(255,255,255,0.14),0 5px 0 {edge};}}"
                  f"{sel}:active{{margin-top:9px;margin-bottom:1px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.1);}}"),
        "pixel": (f"{sel}{{border-radius:0;border:3px solid #000;"
                  f"box-shadow:inset 3px 3px 0 rgba(255,255,255,0.16),inset -3px -3px 0 rgba(0,0,0,0.3),4px 4px 0 rgba(0,0,0,0.55);}}"
                  f"{sel}:active{{margin-top:8px;margin-bottom:2px;box-shadow:inset 3px 3px 0 rgba(0,0,0,0.3);}}"),
        "consola": (f"{sel}{{border-radius:12px;color:#ffffff;background-image:linear-gradient(to bottom,shade({face},1.35),{face});"
                    f"box-shadow:0 5px 0 {edge},inset 0 2px 0 rgba(255,255,255,0.3);}}"
                    f"{sel}:active{{margin-top:9px;margin-bottom:1px;box-shadow:inset 0 2px 0 rgba(255,255,255,0.2);}}"
                    + "".join(f"{sel}.{cls}{{background-color:{c};background-image:linear-gradient(to bottom,shade({c},1.3),{c});"
                              f"box-shadow:0 5px 0 shade({c},0.5),inset 0 2px 0 rgba(255,255,255,0.3);}}"
                              f"{sel}.{cls}:active{{box-shadow:inset 0 2px 0 rgba(255,255,255,0.2);}}"
                              for cls, c in (("cc-key-pomo", "#e8a21a"), ("cc-key-notif", "#e2485a"),
                                             ("cc-key-news", "#7c4dff"), ("cc-key-term", "#56627a"),
                                             ("cc-key-plus", "#2f7de0"), ("cc-key-settings", "#56627a")))),
    }
    # El resto de los botones de la app (pestañas, diálogos, píldoras de pane,
    # atajos…): misma superficie 3D sin cambiar su tamaño. Hundirse = sombra
    # interior (sin mover márgenes, así las listas no bailan). Fuera quedan
    # los controles de ventana y las flechas de scroll.
    gen = "button:not(.cc-key):not(.cc-winctl):not(.titlebutton):not(.tabfav):not(.tabclose):not(.tab-suggest):not(.tabnav):not(.side-btn)"
    generic = {
        "sutil": (f"{gen}{{border:1px solid {line};box-shadow:0 2px 0 {theme.get('line2', line)};}}"
                  f"{gen}:active,{gen}:checked{{box-shadow:inset 0 2px 0 rgba(0,0,0,0.3);}}"),
        "arcade": (f"{gen}{{border:0;border-radius:999px;background-image:radial-gradient(circle at 50% 30%,shade({face},1.4),{face} 65%);"
                   f"box-shadow:0 0 0 2px {edge},0 3px 0 2px {edge};}}"
                   f"{gen}:active,{gen}:checked{{box-shadow:0 0 0 2px {edge},inset 0 3px 0 rgba(0,0,0,0.35);}}"),
        "tecla": (f"{gen}{{border:0;border-radius:8px;background-image:linear-gradient(to bottom,shade({face},1.25),{face});"
                  f"box-shadow:inset 0 1px 0 rgba(255,255,255,0.14),0 3px 0 {edge};}}"
                  f"{gen}:active,{gen}:checked{{box-shadow:inset 0 3px 0 rgba(0,0,0,0.35);}}"),
        "pixel": (f"{gen}{{border:2px solid #000;border-radius:0;background-image:none;background-color:{face};"
                  f"box-shadow:inset 2px 2px 0 rgba(255,255,255,0.16),inset -2px -2px 0 rgba(0,0,0,0.3),3px 3px 0 rgba(0,0,0,0.55);}}"
                  f"{gen}:active,{gen}:checked{{box-shadow:inset 3px 3px 0 rgba(0,0,0,0.35);}}"),
        "consola": (f"{gen}{{border:0;border-radius:12px;background-image:linear-gradient(to bottom,shade({face},1.35),{face});"
                    f"box-shadow:0 3px 0 {edge},inset 0 2px 0 rgba(255,255,255,0.25);}}"
                    f"{gen}:active,{gen}:checked{{box-shadow:inset 0 3px 0 rgba(0,0,0,0.35);}}"),
    }
    reset = "scrollbar button{border:0;box-shadow:none;background-image:none;}"
    key = style if style in styles else "sutil"
    return (base + styles[key] + generic[key] + reset).encode()


_KEY_CSS = Gtk.CssProvider()
BUTTON_STYLE = (PREFS.get("button_style") if isinstance(PREFS, dict) else None) or "sutil"


def apply_button_style(style=None):
    global BUTTON_STYLE
    if style:
        BUTTON_STYLE = style
    try:
        _KEY_CSS.load_from_data(button_style_css(BUTTON_STYLE, THEME))
    except Exception as exc:
        print(f"button style: {exc}", file=sys.stderr)
    return False


apply_button_style()
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), _KEY_CSS, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

# Visual RGBA — habilita transparencia del fondo de VTE. Si el compositor no
# soporta, VTE cae elegantemente a fondo opaco (nada rompe).
if TERM_OPACITY < 1.0:
    scr = win.get_screen()
    vis = scr.get_rgba_visual() if scr else None
    if vis is not None:
        win.set_visual(vis)

nb = gtk_tabstrip.TabStripNotebook()   # cabecera propia: pestañas del ancho de su contenido
tabs = {}   # clave ("sess" o "sess:shell") -> box
TABS_FILE = os.path.expanduser("~/.claude/hooks/app-tabs.json")
TAB_HISTORY_FILE = os.path.expanduser("~/.claude/hooks/app-tabs-history.json")
TAB_FAVORITES = set(PREFS.get("favorites") or []) - {"local"}
_TAB_REORDERING = False
_FAVORITE_PENDING = {}
_FAVORITE_GENERATION = 0
_FAVORITE_REQUEST_LOCK = threading.Lock()


def tab_hb(box):
    """Strip label of a tab, or None while it is docked inside a group page."""
    page_num = getattr(nb, "page_num", None)
    if box is None or (page_num is not None and page_num(box) < 0):
        return None
    return nb.get_tab_label(box)


def notebook_pages():
    for i in range(nb.get_n_pages()):
        yield nb.get_nth_page(i)


def current_tab_order():
    out = []
    for page in notebook_pages():
        # A docked group holds several tabs: all of them stay registered.
        view = globals().get("WS_VIEW")
        keys = view.member_keys(page) if view is not None else [getattr(page, "_key", None)]
        for key in keys:
            if key in tabs and key not in out:
                out.append(key)
    return out


def enforce_tab_order():
    global _TAB_REORDERING
    if _TAB_REORDERING:
        return
    if globals().get("_WS", {}).get("doc") is not None:
        return   # el workspace compartido decide el orden (igual en remoto)
    _TAB_REORDERING = True
    try:
        pages = {getattr(p, "_key", None): p for p in notebook_pages()}
        active = nb.get_nth_page(nb.get_current_page())
        for index, key in enumerate(ordered_tab_keys(pages, TAB_FAVORITES)):
            page = pages[key]
            if nb.page_num(page) != index:
                nb.reorder_child(page, index)
        if active is not None and nb.get_nth_page(nb.get_current_page()) is not active:
            nb.set_current_page(nb.page_num(active))
    finally:
        _TAB_REORDERING = False


def _paint_favorite_button(button, favorite):
    """Enabled star = the looping twinkle of the web; disabled = outline glyph."""
    if favorite:
        image = getattr(button, "_star", None)
        if image is None:
            image = button._star = Gtk.Image.new_from_pixbuf(_indicator_pixbuf("favorite", None, 0))
        image._frame = 0
        button.set_image(image)
        button.set_always_show_image(True)
        button.set_label("")
        button._favorite_image = image
    else:
        button.set_image(None)
        button.set_label("☆")
        button._favorite_image = None
    hb = button.get_parent()
    if hb is not None:
        hb._favorite_image = button._favorite_image
        if favorite:
            _indicator_animate(hb)


def refresh_favorite_buttons():
    for key, page in tabs.items():
        button = getattr(tab_hb(page), "_favorite", None)
        if button is None:
            continue
        favorite = key in TAB_FAVORITES
        signature = (favorite, key not in _FAVORITE_PENDING, ES)
        if getattr(button, "_favorite_signature", None) == signature:
            continue
        _paint_favorite_button(button, favorite)
        style = button.get_style_context()
        (style.add_class if favorite else style.remove_class)("favorite")
        button.set_sensitive(key not in _FAVORITE_PENDING)
        button.set_tooltip_text(("Quitar de favoritos" if favorite else "Marcar como favorita") if ES
                                else ("Remove from favorites" if favorite else "Add to favorites"))
        button._favorite_signature = signature


def apply_tab_favorites(favorites, generation=None):
    if generation is not None and generation != _FAVORITE_GENERATION:
        return False
    updated = set(favorites or []) - {"local"}
    for key, enabled in _FAVORITE_PENDING.items():
        (updated.add if enabled else updated.discard)(key)
    changed = updated != TAB_FAVORITES
    TAB_FAVORITES.clear()
    TAB_FAVORITES.update(updated)
    refresh_favorite_buttons()
    if changed:
        save_tabs()
    return False


def toggle_tab_favorite(key):
    global _FAVORITE_GENERATION
    if not key or key == "local" or key in _FAVORITE_PENDING:
        return
    before = key in TAB_FAVORITES
    _FAVORITE_PENDING[key] = not before
    _FAVORITE_GENERATION += 1
    apply_tab_favorites(TAB_FAVORITES)

    def finish(favorites, error):
        global _FAVORITE_GENERATION
        _FAVORITE_PENDING.pop(key, None)
        _FAVORITE_GENERATION += 1
        if error:
            favorites = set(TAB_FAVORITES)
            (favorites.add if before else favorites.discard)(key)
        apply_tab_favorites(favorites)
        if error:
            message = "No se pudo guardar el favorito. Inténtalo de nuevo." if ES else "Could not save favorite. Try again."
            notify_popup("Favoritos" if ES else "Favorites", message)
        return False

    def persist():
        with _FAVORITE_REQUEST_LOCK:
            try:
                request = urllib.request.Request(BASE_URL + "/prefs-set",
                    data=json.dumps({"favorite": {"session": key, "enabled": not before}}).encode(),
                    headers={"Content-Type": "application/json"}, method="POST")
                with urllib.request.urlopen(request, timeout=5) as response:
                    result = json.loads(response.read().decode())
                GLib.idle_add(finish, result["favorites"], False)
            except Exception:
                GLib.idle_add(finish, None, True)
    threading.Thread(target=persist, daemon=True).start()


# ---- E1: marcas de trabajo (las mismas que la web, via cc-dash /work-marks) ----
WORK_MARKS = {"rows": {}, "panes": [], "fetching": False}
_WORK_MARK_PIXBUFS = {}


def work_mark_row(scope, key):
    return WORK_MARKS["rows"].get((scope, key)) or {
        "scope": scope, "key": key, "mark": "none", "favorite": False, "revision": 0}


def _work_mark_pixbuf(name):
    """Resting frame of a mark (context menus)."""
    return _indicator_pixbuf(name, None, 0)


_INDICATOR_PIXBUFS = {}
_INDICATOR = {"source": None, "t0": None}


def ai_frame_pixbuf(state, frame, scale=1, px_out=None):
    """Cuadro ``frame`` del punto de estado (lib/work_marks.ai_dot_svg, el mismo
    color que el remoto) rasterizado al tamaño de pestaña × factor HiDPI; solo
    «te necesita» tiene más de un cuadro (el halo del latido)."""
    size = int((px_out or work_mark_state.AI_DOT_PX) * scale)
    phase = (frame / work_mark_state.AI_PULSE_FRAMES) if work_mark_state.ai_cycle(state) else None
    loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
    loader.write(work_mark_state.ai_dot_svg(state, size, phase).encode())
    loader.close()
    return loader.get_pixbuf()


def _indicator_pixbuf(icon, color, frame=0, scale=1, px_out=None):
    """Frame ``frame`` of the icon's loop, rendered once and cached. ``ai:<n>``
    is the AI state dot (1-oct, no more sprites); the rest are the E1 line icons."""
    key = (icon, color, frame, scale, px_out)
    if key not in _INDICATOR_PIXBUFS:
        if icon.startswith("ai:"):
            _INDICATOR_PIXBUFS[key] = ai_frame_pixbuf(icon[3:], frame, scale, px_out)
            return _INDICATOR_PIXBUFS[key]
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        n = work_mark_state.frame_count(icon)
        loader.write(work_mark_state.icon_svg(icon, color=color, size=14,
                                              phase=None if n <= 1 else frame / n).encode())
        loader.close()
        _INDICATOR_PIXBUFS[key] = loader.get_pixbuf()
    return _INDICATOR_PIXBUFS[key]


def _set_indicator_frame(image, icon, color, frame):
    """Pone el cuadro en la imagen; el punto va como superficie con el factor
    de escala de la pantalla para que no se vea borroso en HiDPI."""
    if icon.startswith("ai:"):
        scale = max(1, image.get_scale_factor())
        pb = _indicator_pixbuf(icon, color, frame, scale, getattr(image, "_px", None))
        image.set_from_surface(Gdk.cairo_surface_create_from_pixbuf(pb, scale, image.get_window()))
    else:
        image.set_from_pixbuf(_indicator_pixbuf(icon, color, frame))


def tab_indicator_display(mark, state):
    """(icon, colour, animated): el punto de color de lo que sabe la IA. La
    marca humana ya no lo tapa: va aparte como sticker (dos canales, grill 30-sep)."""
    ai = work_mark_state.ai_status(state)
    return "ai:" + ai, None, bool(work_mark_state.ai_cycle(ai))


def paint_tab_mark(hb, key):
    """One indicator per tab (the old status dot): mark, activity or neutral.
    Animated icons loop continuously while the window is visible (E1)."""
    image = getattr(hb, "_dot", None)
    if image is None:
        return
    mark = work_mark_row("session", key)["mark"]
    icon, color, animated = tab_indicator_display(mark, STATE_CACHE.get(key, ""))
    _paint_tab_sticker(hb, mark, icon == "ai:done")
    if getattr(image, "_ind", None) == (icon, color):
        return
    image._ind, image._frame = (icon, color), 0
    hb._ind_icon = icon
    try:
        _set_indicator_frame(image, icon, color, 0)
    except Exception:
        return
    image.set_tooltip_text("IA: " + work_mark_state.AI_LABELS[icon[3:]][0 if ES else 1])
    image.show()
    if animated:
        _indicator_animate(hb)


def _paint_tab_sticker(hb, mark, finished):
    """Tu canal: sticker con tu marca y, si la IA terminó sin marca, «¿Hecho? ✓»."""
    sticker, suggest = getattr(hb, "_sticker", None), getattr(hb, "_suggest", None)
    text = work_mark_state.STICKERS.get(mark)
    if sticker is not None:
        if text:
            sticker.set_text(text)
            ctx = sticker.get_style_context()
            for m in work_mark_state.STICKERS:
                ctx.remove_class("st-" + m)
            ctx.add_class("st-" + mark)
            sticker.show()
        else:
            sticker.hide()
    if suggest is not None:
        (suggest.show if finished and not text else suggest.hide)()


def _animations_enabled():
    try:
        return bool(Gtk.Settings.get_default().get_property("gtk-enable-animations"))
    except Exception:
        return True


def _indicator_animate(hb):
    """Start the single ticker that advances every looping indicator; it stops
    itself when nothing loops any more."""
    if _INDICATOR["source"] is None:
        _INDICATOR["t0"] = _INDICATOR["t0"] or time.monotonic()
        _INDICATOR["source"] = GLib.timeout_add(int(work_mark_state.FRAME_S * 1000), _indicator_tick)


def _indicator_tick():
    if not _PRESENCE.get("visible", True) or not _animations_enabled():
        return True                      # hidden or reduced motion: rest on the current frame
    t = time.monotonic() - _INDICATOR["t0"]
    looping = False
    for key, box in tabs.items():
        hb = tab_hb(box)
        if hb is None:
            continue
        image = getattr(hb, "_dot", None)
        icon = getattr(hb, "_ind_icon", None)
        ai = icon[3:] if isinstance(icon, str) and icon.startswith("ai:") else None
        if image is not None and (icon in work_mark_state.CYCLE_S or (ai and work_mark_state.ai_cycle(ai))):
            looping = True
            frame = work_mark_state.ai_frame_index(ai, t) if ai else work_mark_state.frame_index(icon, t)
            if getattr(image, "_frame", 0) != frame:
                image._frame = frame
                _set_indicator_frame(image, icon, image._ind[1], frame)
        for pill in getattr(box, "_pills", []) or []:
            card_ai = getattr(pill, "_ai", None)
            card_icon = getattr(card_ai, "_ai_icon", "") if card_ai is not None else ""
            if card_icon.startswith("ai:") and work_mark_state.ai_cycle(card_icon[3:]):
                looping = True
                frame = work_mark_state.ai_frame_index(card_icon[3:], t)
                if getattr(card_ai, "_frame", 0) != frame:
                    card_ai._frame = frame
                    _set_indicator_frame(card_ai, card_icon, None, frame)
        star = getattr(hb, "_favorite_image", None)
        if star is not None and key in TAB_FAVORITES:
            looping = True
            frame = work_mark_state.frame_index("favorite", t)
            if getattr(star, "_frame", 0) != frame:
                star._frame = frame
                star.set_from_pixbuf(_indicator_pixbuf("favorite", None, frame))
    if not looping:
        _INDICATOR["source"] = None
        return False
    return True


def _paint_all_tab_marks():
    for key, box in tabs.items():
        paint_tab_mark(tab_hb(box), key)
    return False


def apply_work_marks(payload):
    payload = payload if isinstance(payload, dict) else {}
    WORK_MARKS["rows"] = {(r.get("scope"), r.get("key")): r for r in payload.get("marks") or []
                          if isinstance(r, dict)}
    WORK_MARKS["panes"] = [p for p in payload.get("panes") or [] if isinstance(p, dict)]
    return _paint_all_tab_marks()


def adopt_work_mark(row):
    if isinstance(row, dict) and row.get("scope") and row.get("key"):
        WORK_MARKS["rows"][(row["scope"], row["key"])] = row
    return _paint_all_tab_marks()


def start_work_marks_fetch():
    if WORK_MARKS["fetching"]:
        return
    WORK_MARKS["fetching"] = True

    def run():
        try:
            with urllib.request.urlopen(BASE_URL + "/work-marks", timeout=3) as r:
                payload = json.loads(r.read().decode())
            GLib.idle_add(apply_work_marks, payload)
        except Exception:
            pass
        finally:
            WORK_MARKS["fetching"] = False
    threading.Thread(target=run, daemon=True).start()


def set_work_mark(scope, key, value):
    """POST con la revision conocida; si otro cliente cambio la marca, se
    adopta la actual (nunca se pisa) y se avisa."""
    body = {"scope": scope, "key": key, "value": value,
            "expectedRevision": work_mark_row(scope, key)["revision"]}
    title = "Marcas" if ES else "Marks"

    def run():
        request = urllib.request.Request(BASE_URL + "/work-marks", data=json.dumps(body).encode(),
                                         headers={"Content-Type": "application/json"}, method="POST")
        try:
            with urllib.request.urlopen(request, timeout=5) as response:
                GLib.idle_add(adopt_work_mark, json.loads(response.read().decode()).get("mark"))
        except urllib.error.HTTPError as exc:
            try:
                answer = json.loads(exc.read().decode())
            except Exception:
                answer = {}
            if exc.code == 409 and isinstance(answer.get("current"), dict):
                GLib.idle_add(adopt_work_mark, answer["current"])
                message = ("Otro dispositivo cambió esta marca; se muestra la actual." if ES
                           else "Another device changed this mark; showing the current one.")
            else:
                message = answer.get("error") or str(exc)
            GLib.idle_add(notify_popup, title, message)
        except Exception as exc:
            GLib.idle_add(notify_popup, title, str(exc))
    threading.Thread(target=run, daemon=True).start()


def append_work_mark_menu(menu, session, pane_id):
    """Submenu Marca: la pestana (sesion) y, si W1 lo identifica, este pane."""
    sections = []
    if session and session != "local":
        sections.append(("session", session, "Esta pestaña", "This tab"))
    pane_key = work_mark_state.pane_key_for(WORK_MARKS["panes"], session, pane_id) if pane_id else None
    if pane_key:
        sections.append(("pane", pane_key, "Este pane", "This pane"))
    if not sections:
        return
    sub = Gtk.Menu()
    for i, (scope, key, es, en) in enumerate(sections):
        if i:
            sub.append(Gtk.SeparatorMenuItem())
        header = Gtk.MenuItem(label=es if ES else en)
        header.set_sensitive(False)
        sub.append(header)
        row = work_mark_row(scope, key)
        for mark in work_mark_state.MARKS:
            item = Gtk.CheckMenuItem(label=work_mark_state.LABELS[mark][0 if ES else 1])
            item.set_draw_as_radio(True)
            item.set_active(row["mark"] == mark)
            item.connect("activate", lambda _w, s=scope, k=key, m=mark: set_work_mark(s, k, m))
            sub.append(item)
        if scope == "pane":
            fav = Gtk.CheckMenuItem(label=work_mark_state.LABELS["favorite"][0 if ES else 1])
            fav.set_active(bool(row["favorite"]))
            fav.connect("activate", lambda _w, k=key, v=not row["favorite"]:
                        set_work_mark("pane", k, {"favorite": v}))
            sub.append(fav)
    root = Gtk.MenuItem(label="Marca" if ES else "Mark")
    root.set_submenu(sub)
    menu.append(root)


def _mark_menu_item(mark, label, active, on_activate):
    """Radio row with the state's icon and its name (the grill's icon + text menu)."""
    # = menú web (.wm-item): icono + nombre, el elegido en negrita con un punto del acento a la
    # derecha; sin el círculo de radio de GTK (1-oct).
    item = Gtk.MenuItem()
    item.get_style_context().add_class("wm-item")
    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    row.pack_start(Gtk.Image.new_from_pixbuf(_indicator_pixbuf(mark, None, 0)), False, False, 0)
    name = Gtk.Label(label=label)
    name.set_xalign(0.0)
    name.set_hexpand(True)
    if active:
        name.get_style_context().add_class("wm-on")
    row.pack_start(name, True, True, 0)
    if active:
        dot = Gtk.Label(label="●")
        dot.get_style_context().add_class("wm-dot")
        row.pack_end(dot, False, False, 0)
    item.add(row)
    item._active = active
    item.connect("activate", on_activate)
    return item


def tab_indicator_menu(session, pane_id=None):
    """Menu opened by tapping a tab's indicator: this tab's state and, when the
    pane is identified, that pane's state and favourite. Same scopes as the web."""
    menu = Gtk.Menu()
    sections = []
    if session and session != "local":
        sections.append(("session", session, "Esta pestaña" if ES else "This tab"))
    pane_key = work_mark_state.pane_key_for(WORK_MARKS["panes"], session, pane_id) if pane_id else None
    if pane_key:
        sections.append(("pane", pane_key, "Este pane" if ES else "This pane"))
    for i, (scope, key, title) in enumerate(sections):
        if i:
            menu.append(Gtk.SeparatorMenuItem())
        if len(sections) > 1:
            header = Gtk.MenuItem(label=title)
            header.set_sensitive(False)
            menu.append(header)
        row = work_mark_row(scope, key)
        for mark in work_mark_state.MARKS:
            menu.append(_mark_menu_item(mark, work_mark_state.LABELS[mark][0 if ES else 1], row["mark"] == mark,
                                        lambda _w, s=scope, k=key, m=mark: set_work_mark(s, k, m)))
        menu.append(Gtk.SeparatorMenuItem())          # = .wm-sep antes de Favorita
        if scope == "pane":
            menu.append(_mark_menu_item("favorite", work_mark_state.LABELS["favorite"][0 if ES else 1], bool(row["favorite"]),
                                        lambda _w, k=key, v=not row["favorite"]: set_work_mark("pane", k, {"favorite": v})))
        else:   # la favorita de la pestaña (la misma estrella ☆ de la tab)
            menu.append(_mark_menu_item("favorite", "Favorita" if ES else "Favorite", key in TAB_FAVORITES,
                                        lambda _w, k=key: toggle_tab_favorite(k)))
    menu.show_all()
    return menu


def ordered_tab_labels(page_keys, labels):
    out = {}
    for key in page_keys:
        if isinstance(key, str) and key in labels:
            out[key] = labels[key]
    for key, label in labels.items():
        if key not in out:
            out[key] = label
    return out


@contextlib.contextmanager
def _file_lock(path):
    """Candado compartido con cc-dash: flock exclusivo sobre <archivo>.lock."""
    with open(path + ".lock", "a") as fh:
        _fcntl.flock(fh, _fcntl.LOCK_EX)
        try:
            yield
        finally:
            _fcntl.flock(fh, _fcntl.LOCK_UN)


def save_tabs():
    if _TAB_REORDERING:
        return
    enforce_tab_order()
    if not globals().get("_LAYOUT_RESTORE_READY", False):
        return
    tmp = None
    try:
        labels = {k: getattr(b, "_label", None) for k, b in tabs.items()}
        data = ordered_tab_labels(current_tab_order(), labels)
        with _file_lock(TABS_FILE):
            fd, tmp = tempfile.mkstemp(prefix="app-tabs.", suffix=".tmp", dir=os.path.dirname(TABS_FILE))
            with os.fdopen(fd, "w") as f:
                json.dump(data, f)
            os.replace(tmp, TABS_FILE)
    except Exception:
        pass
    finally:
        if tmp and os.path.exists(tmp):
            os.unlink(tmp)


def on_tab_reordered(_nb, _child, _page_num):
    save_tabs()


def saved_tab_label(key):
    try:
        with open(TABS_FILE) as f:
            data = json.load(f)
        if isinstance(data, dict) and isinstance(data.get(key), str) and data.get(key):
            return data[key]
    except Exception:
        pass
    return None


def archive_tab(key, reason="closed"):
    if not key:
        return
    box = tabs.get(key)
    label = getattr(box, "_label", key) if box is not None else key
    it = STATE_ITEMS.get(key, {})
    cwd = it.get("cwd", "")
    agent = it.get("agent", "")
    if not cwd:
        r = tmuxc("display-message", "-p", "-t", "=" + key + ":", "#{pane_current_path}")
        if r.returncode == 0:
            cwd = r.stdout.strip()
    if not agent:
        r = tmuxc("display-message", "-p", "-t", "=" + key + ":", "#{pane_current_command}")
        cmd = r.stdout.strip() if r.returncode == 0 else ""
        agent = "codex" if cmd == "node" else "acp" if cmd == "cc-acp" else cmd if cmd in {"claude", "grok", "opencode", "gemini", "agy", "aider", "acp"} else "claude"
    item = {"session": key, "label": label, "cwd": cwd, "agent": agent,
            "reason": reason, "ts": int(time.time())}
    with _file_lock(TAB_HISTORY_FILE):
        try:
            with open(TAB_HISTORY_FILE) as f:
                hist = json.load(f)
            if not isinstance(hist, list):
                hist = []
        except Exception:
            hist = []
        hist = [h for h in hist if not isinstance(h, dict) or h.get("session") != key]
        fd, tmp = tempfile.mkstemp(prefix="app-tabs-history.", suffix=".tmp",
                                   dir=os.path.dirname(TAB_HISTORY_FILE))
        try:
            with os.fdopen(fd, "w") as f:
                json.dump([item] + hist[:79], f)
            os.replace(tmp, TAB_HISTORY_FILE)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)



# ---- Snapshot de resurreccion: para que un reinicio de la compu no pierda nada.
# Cada ~30s se guarda, por pestana term-*, su cwd + agente + session-id EXACTO
# (claude: ~/.claude/sessions/<pid>.json trae pid/sessionId/pane tmux;
#  codex: el binario mantiene abierto su rollout-*.jsonl -> uuid del nombre).
# restore_tabs() usa esto para revivir cada tab en su directorio y retomar la
# conversacion precisa con `claude --resume <id>` / `codex resume <id>`.
SNAPSHOT_FILE = os.path.expanduser("~/.claude/hooks/app-tabs-snapshot.json")
CLAUDE_SESS_DIR = os.path.expanduser("~/.claude/sessions")
CLAUDE_PROJ_DIR = os.path.expanduser("~/.claude/projects")
CODEX_SESS_DIR = os.path.expanduser("~/.codex/sessions")
GROK_HOME_DEFAULT = os.path.expanduser("~/.grok")
_ROLLOUT_RE = re.compile(
    r"rollout-.*-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$")
_RESUME_SKIP_FLAGS = {"--resume", "--continue", "-r", "-c", "--last"}
# Flags que llevan valor: hay que conservar el PAR flag+valor. Guardar solo el
# flag produce comandos rotos tipo `claude --model --effort` (claude toma
# "--effort" como nombre de modelo y toda la sesion revive inservible).
_VALUE_FLAGS = {"--model", "--effort", "--permission-mode", "--add-dir",
                "--settings", "--session-id", "--agents", "--mcp-config"}


def _which_cli(name):
    """shutil.which + bins de usuario. Lanzada desde el escritorio, la app
    hereda un PATH sin ~/.bun/bin (codex) o ~/.local/bin: la deteccion de CLIs
    instalados no puede depender del entorno (mismo criterio que lib/providers)."""
    hit = shutil.which(name)
    if hit:
        return hit
    for directory in ("~/.local/bin", "~/.bun/bin", "~/.cargo/bin",
                      "~/.npm-global/bin", "~/bin", "/usr/local/bin"):
        candidate = os.path.join(os.path.expanduser(directory), name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def _sane_flags(raw, agent="claude"):
    """Normaliza una lista de args a flags relanzables: conserva flag+valor de
    los _VALUE_FLAGS, descarta value-flags huerfanos (snapshots viejos rotos) y
    omite los flags de reanudacion junto con su id."""
    # Codex usa -c para configuracion, no para continuar como Claude.
    # Conservar solo los permisos originales, sin inventar valores ni defaults.
    skip_flags, value_flags = _RESUME_SKIP_FLAGS, _VALUE_FLAGS
    if agent == "codex":
        skip_flags = _RESUME_SKIP_FLAGS - {"-c"}
        value_flags = {"--model", "-m", "--config", "-c", "--sandbox", "-s",
                       "--ask-for-approval", "-a", "--profile", "-p",
                       "--cd", "-C", "--add-dir", "--image", "-i",
                       "--enable", "--disable", "--local-provider"}
    out, i = [], 0
    raw = [a for a in raw if isinstance(a, str)]
    while i < len(raw):
        arg = raw[i]
        if not arg.startswith("-"):
            i += 1
            continue
        if arg in skip_flags:
            i += 1
            if arg in ("--resume", "-r") and i < len(raw) and not raw[i].startswith("-"):
                i += 1  # saltar el session-id del resume viejo
            continue
        if arg in value_flags:
            if i + 1 < len(raw) and not raw[i + 1].startswith("-"):
                out.extend((arg, raw[i + 1]))
                i += 2
            else:
                i += 1  # value-flag sin valor: descartarlo, no propagar el bug
            continue
        out.append(arg)
        i += 1
    return out


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False


def _proc_flags(pid, agent="claude"):
    """Flags (con su valor cuando lo llevan) con que corre el agente, para
    relanzarlo igual (p.ej. --model X --effort high --dangerously-skip-permissions)."""
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as f:
            argv = [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
    except Exception:
        return []
    return _sane_flags(argv[1:], agent=agent)


def _claude_by_tmux_session():
    """{sesion tmux: {id,pid,config_dir}} de TODOS los config-dirs Claude."""
    out = {}
    dirs = [CLAUDE_SESS_DIR] + glob.glob(os.path.expanduser("~/.claude-accounts/*/sessions"))
    files = []
    for directory in dirs:
        try:
            files.extend((directory, n) for n in os.listdir(directory) if n.endswith(".json"))
        except Exception:
            continue
    for directory, n in files:
        try:
            with open(os.path.join(directory, n)) as f:
                d = json.load(f)
        except Exception:
            continue
        if not isinstance(d, dict):
            continue
        pid, tm, sid = d.get("pid"), d.get("tmux") or "", d.get("sessionId")
        if not (isinstance(pid, int) and isinstance(tm, str) and isinstance(sid, str) and sid):
            continue
        sess = tm.partition(":")[0]
        if not sess or not _pid_alive(pid):
            continue
        prev = out.get(sess)
        if prev and prev.get("startedAt", 0) >= (d.get("startedAt") or 0):
            continue
        out[sess] = {"id": sid, "pid": pid, "startedAt": d.get("startedAt") or 0,
                     "config_dir": os.path.dirname(directory)}
    return out


def _ppid_map():
    kids = {}
    try:
        pids = [n for n in os.listdir("/proc") if n.isdigit()]
    except Exception:
        return kids
    for n in pids:
        try:
            with open(f"/proc/{n}/stat") as f:
                st = f.read()
            ppid = int(st.rsplit(")", 1)[1].split()[1])
            kids.setdefault(ppid, []).append(int(n))
        except Exception:
            continue
    return kids


def _codex_info_for_session(sess, kids):
    """Busca en los descendientes del pane un proceso con su rollout de codex
    abierto -> {id, flags}. None si no hay codex en esa sesion."""
    r = tmuxc("list-panes", "-s", "-t", "=" + sess + ":", "-F", "#{pane_pid}")
    if r.returncode != 0:
        return None
    stack = [int(x) for x in r.stdout.split() if x.isdigit()]
    seen = set()
    while stack:
        p = stack.pop()
        if p in seen:
            continue
        seen.add(p)
        stack.extend(kids.get(p, []))
    for p in seen:
        try:
            fds = os.listdir(f"/proc/{p}/fd")
        except Exception:
            continue
        for fd in fds:
            try:
                t = os.readlink(f"/proc/{p}/fd/{fd}")
            except Exception:
                continue
            m = _ROLLOUT_RE.search(t)
            if m:
                return {"id": m.group(1), "flags": _proc_flags(p, agent="codex")}
    return None


LAYOUT_SNAPSHOT_FILE = os.path.expanduser("~/.claude/hooks/app-sessions-v2.json")
_LAYOUT_LOCK = threading.Lock()
_LAYOUT_RESTORE_READY = False


def snapshot_layouts(wait=False):
    """Keep the last complete per-pane layout; never save a partial startup."""
    if not _LAYOUT_RESTORE_READY:
        return False
    if not _LAYOUT_LOCK.acquire(blocking=wait):
        return False
    try:
        keys = ["local"] + [k for k in list(tabs) if k.startswith("term-")]
        previous = layout_snapshot.read_snapshot(LAYOUT_SNAPSHOT_FILE)["sessions"]
        inspector = PaneInspector()
        # Las pestañas abiertas conservan su respaldo aunque tmux vuelva vacío
        # tras un crash. Solo cerrar la pestaña elimina su entrada de keys.
        data = {}
        for key in keys:
            try:
                captured = layout_snapshot.capture_session(tmuxc, key, inspector)
                # Un agente aun sin id hereda el previo solo en su mismo pane.
                data[key] = layout_snapshot.carry_pane_keys(
                    layout_snapshot.carry_resume_ids(captured, previous.get(key)), previous.get(key))
            except Exception as exc:
                if key in previous:
                    data[key] = previous[key]
                print(f"snapshot {key}: {exc}", file=sys.stderr)
        layout_snapshot.write_snapshot(LAYOUT_SNAPSHOT_FILE, data)
    except Exception as exc:
        print(f"snapshot layouts: {exc}", file=sys.stderr)
    finally:
        _LAYOUT_LOCK.release()
    return False


def exact_resume_command(pane):
    """A new per-pane snapshot must never resume another conversation via --last."""
    if not pane.get("resume_id") and not (pane.get("acp") or {}).get("sessionId"):
        return None
    cmd = resume_command(pane)
    if cmd and not {"--last", "--continue"}.intersection(shlex.split(cmd)):
        return cmd
    return None


def restore_saved_layout(sess):
    saved = layout_snapshot.read_snapshot(LAYOUT_SNAPSHOT_FILE)["sessions"].get(sess)
    if not saved or not saved.get("windows"):
        return False
    layout_snapshot.restore_session(tmuxc, sess, saved, exact_resume_command)
    return True


def prepare_local_terminal():
    """Recover local on every reconnect, before new-session can replace it."""
    with _LAYOUT_LOCK:
        restore_saved_layout("local")


def finish_startup_restore():
    def ready():
        global _LAYOUT_RESTORE_READY
        _LAYOUT_RESTORE_READY = True
        save_tabs()
    # El snapshot y save_tabs esperan a que el hilo de restauracion termine:
    # nunca se guarda un arranque parcial.
    try:
        restore_tabs(on_done=ready)
    except Exception as e:
        print(f"restore_tabs: {e}")
        ready()
    return False


_SNAPSHOT_LOCK = threading.Lock()


def snapshot_tabs():
    """Corre en hilo. Persiste el estado de resurreccion de las tabs term-*."""
    if not _SNAPSHOT_LOCK.acquire(blocking=False):
        return
    try:
        keys = [k for k in list(tabs.keys())
                if isinstance(k, str) and k.startswith("term-")]
        cl = _claude_by_tmux_session()
        kids = None
        data = {}
        for k in keys:
            it = STATE_ITEMS.get(k, {}) or {}
            cwd = it.get("cwd") or ""
            if not cwd:
                r = tmuxc("display-message", "-p", "-t", "=" + k + ":",
                          "#{pane_current_path}")
                cwd = r.stdout.strip() if r.returncode == 0 else ""
            ent = {"cwd": cwd, "agent": it.get("agent") or "", "ts": int(time.time())}
            if k in cl:
                ent["agent"] = "claude"
                ent["resume_id"] = cl[k]["id"]
                ent["flags"] = _proc_flags(cl[k]["pid"])
                ent["claude_config_dir"] = cl[k].get("config_dir") or os.path.expanduser("~/.claude")
            else:
                if kids is None:
                    kids = _ppid_map()
                info = _codex_info_for_session(k, kids)
                if info:
                    ent["agent"] = "codex"
                    ent["resume_id"] = info["id"]
                    ent["flags"] = info["flags"]
                else:
                    rcmd = tmuxc("display-message", "-p", "-t", "=" + k + ":", "#{pane_current_command}")
                    pane_cmd = rcmd.stdout.strip() if rcmd.returncode == 0 else ""
                    if pane_cmd == "cc-acp":
                        ent["agent"] = "acp"
                if ent["agent"] == "codex":
                    pass
                elif ent["agent"] == "grok":
                    sid = it.get("agentSessionId") or ""
                    if isinstance(sid, str) and re.fullmatch(r"[0-9a-f-]{36}", sid):
                        ent["resume_id"] = sid
                    alias = it.get("account") or "main"
                    ent["account"] = alias
                    ent["grok_home"] = (GROK_HOME_DEFAULT if alias == "main" else
                                         os.path.expanduser(f"~/.grok-accounts/{alias}"))
                elif ent["agent"] == "acp":
                    # pane cliente ACP: cc-acp publica agente/modelo/cuenta y el
                    # sessionId en acp-panes.json por pane tmux
                    r = tmuxc("display-message", "-p", "-t", "=" + k + ":", "#{pane_id}")
                    pane_id = r.stdout.strip() if r.returncode == 0 else ""
                    try:
                        with open(os.path.expanduser("~/.claude/hooks/acp-panes.json")) as f:
                            acp_state = (json.load(f) or {}).get(pane_id) or {}
                    except Exception:
                        acp_state = {}
                    if acp_state.get("agent"):
                        ent["acp"] = {key: acp_state.get(key, "") for key in ("agent", "model", "effort", "account", "sessionId")}
                elif ent["agent"] in {"claude", "codex"}:
                    pass  # agente reportado pero sin id: quedara el fallback
                else:
                    ent["agent"] = ""  # shell puro: no relanzar nada
            data[k] = ent
        tmp = SNAPSHOT_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, SNAPSHOT_FILE)
    except Exception:
        pass
    finally:
        _SNAPSHOT_LOCK.release()


def load_tab_snapshot():
    try:
        with open(SNAPSHOT_FILE) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def resume_command(snap):
    """Comando para retomar el agente de una tab muerta; None = solo shell."""
    if not isinstance(snap, dict):
        return None
    agent = snap.get("agent") or ""
    # _sane_flags conserva pares --flag valor y tira value-flags huerfanos:
    # un snapshot viejo con ["--model","--effort"] jamas debe volver a generar
    # `claude --resume id --model --effort` (modelo invalido, sesion rota).
    flags = _sane_flags(snap.get("flags") if isinstance(snap.get("flags"), list) else [], agent=agent)
    fl = ("" if not flags else " " + " ".join(shlex.quote(f) for f in flags))
    sid = snap.get("resume_id") or ""
    sid = sid if isinstance(sid, str) and re.fullmatch(r"[0-9a-f-]{36}", sid) else ""
    if agent == "claude" and _which_cli("claude"):
        cfg = os.path.realpath(os.path.expanduser(snap.get("claude_config_dir") or "~/.claude"))
        projects = os.path.join(cfg, "projects")
        prefix = "" if cfg == os.path.realpath(os.path.expanduser("~/.claude")) else f"CLAUDE_CONFIG_DIR={shlex.quote(cfg)} "
        if sid and glob.glob(os.path.join(projects, "*", sid + ".jsonl")):
            return prefix + "claude --resume " + sid + fl
        return prefix + "claude --continue" + fl
    if agent == "codex" and _which_cli("codex"):
        codex_home = os.path.realpath(os.path.expanduser(snap.get("codex_home") or "~/.codex"))
        prefix = "" if codex_home == os.path.realpath(os.path.expanduser("~/.codex")) else f"CODEX_HOME={shlex.quote(codex_home)} "
        if sid and glob.glob(os.path.join(codex_home, "sessions", "*", "*", "*",
                                          "rollout-*" + sid + ".jsonl")):
            return prefix + "codex resume " + sid + fl
        return prefix + "codex resume --last" + fl
    if agent == "acp" and _which_cli("cc-acp"):
        st = snap.get("acp") if isinstance(snap.get("acp"), dict) else {}
        cmd = "cc-acp --agent " + shlex.quote(str(st.get("agent") or "claude"))
        for flag, key in (("--model", "model"), ("--effort", "effort"), ("--account", "account"), ("--resume", "sessionId")):
            value = str(st.get(key) or "")
            if value and not (key == "account" and value == "main"):
                cmd += f" {flag} " + shlex.quote(value)
        return cmd + fl
    if agent == "grok" and _which_cli("grok"):
        home = snap.get("grok_home") or GROK_HOME_DEFAULT
        home = os.path.realpath(os.path.expanduser(home))
        prefix = "" if home == os.path.realpath(GROK_HOME_DEFAULT) else f"GROK_HOME={shlex.quote(home)} "
        if sid and glob.glob(os.path.join(home, "sessions", "**", sid, "summary.json"), recursive=True):
            return prefix + "grok --resume " + sid + fl
        return prefix + "grok --continue" + fl
    return None


def _send_resume(sess, cmd):
    try:
        if subprocess.run(["tmux", "has-session", "-t", "=" + sess],
                          capture_output=True, timeout=5).returncode == 0:
            tmuxc("send-keys", "-t", "=" + sess + ":", cmd, "Enter")
    except Exception:
        pass
    return False


def _restore_one(sess, label, snap):
    """Hilo: revive la sesion si murio. Devuelve (sess, ventana, label, resume)."""
    cmd = None
    if subprocess.run(["tmux", "has-session", "-t", "=" + sess],
                      capture_output=True, timeout=5).returncode != 0:
        ssh_host = ssh_host_from_session(sess)
        if sess.startswith("term-") and restore_saved_layout(sess):
            pass
        elif sess.startswith("term-"):
            # terminal scratch: revivir en SU cwd y retomar el agente
            # exacto (claude --resume <id> / codex resume <id>) que
            # corria antes del apagado, segun el snapshot periodico.
            snap = snap if isinstance(snap, dict) else {}
            cwd = snap.get("cwd") or ""
            if not (isinstance(cwd, str) and os.path.isdir(cwd)):
                cwd = os.path.expanduser("~")
            subprocess.run(
                ["systemd-run", "--user", "--scope", "--collect", "--quiet",
                 "tmux", "new-session", "-d", "-s", sess, "-c", cwd],
                capture_output=True, timeout=12)
            # Solo la conversacion exacta: sin id el pane queda en shell y su
            # lugar se informa como no disponible (nunca --continue/--last).
            cmd = exact_resume_command(snap)
            if not cmd and snap.get("agent"):
                print(f"restore {sess}: conversacion exacta no disponible; queda shell", file=sys.stderr)
        elif ssh_host and sess.startswith("ssh-"):
            http_post("/ssh-connect", {"host": ssh_host}, timeout=20)
        elif ssh_host:
            res, e = http_post("/ssh-new-tab", {"host": ssh_host}, timeout=20)
            if e:
                raise RuntimeError(e)
            if isinstance(res, dict) and res.get("session"):
                sess = res["session"]
                label = res.get("label") or label
        else:
            http_post("/new", {"session": sess})
    current = tmuxc("display-message", "-p", "-t", "=" + sess + ":", "#{window_index}")
    return sess, current.stdout.strip() or "claude", label, cmd


def restore_tabs(on_done=None):
    """Al abrir la app, reabre las pestanas de la vez pasada (con su nombre);
    si una sesion murio (p.ej. reinicio), la revive (claude --continue /
    reconexion ssh). Lo lento (tmux, systemd-run, cc-dash) va en un hilo y
    cada pestana se abre en GTK, en orden, por idle_add."""
    def finish():
        if on_done:
            on_done()
        return False
    try:
        with open(TABS_FILE) as f:
            data = json.load(f)
    except Exception:
        return finish()
    if isinstance(data, list):    # formato viejo: lista de claves sin etiqueta
        data = {k: None for k in data if isinstance(k, str)}
    if not isinstance(data, dict):
        return finish()
    items = [(k, v) for k, v in data.items() if isinstance(k, str) and k]
    already = set(tabs)

    def open_xterm(key):
        if key not in tabs:
            try:
                open_xterm_tab(key[len("xterm-"):] or "local")
            except Exception as e:
                print(f"no pude restaurar {key}: {e}")
        return False

    def open_restored(sess, win_name, label, cmd):
        if sess not in tabs:
            open_tab(sess, win_name, label=label if isinstance(label, str) and label else None)
        if cmd:
            GLib.timeout_add(1500, lambda: (threading.Thread(target=_send_resume, args=(sess, cmd),
                                                             daemon=True).start(), False)[1])
        return False

    def work():
        snaps = load_tab_snapshot()
        seen = set(already)
        for key, label in items:
            # Pestana experimental xterm.js — no es sesion tmux, no revive nada,
            # solo remonta la WebView contra cc-webterm.
            if key.startswith("xterm-"):
                GLib.idle_add(open_xterm, key)
                continue
            # claves viejas "sesion:ventana" colapsan a la sesion (una pestana por sesion)
            sess = key.partition(":")[0]
            if sess in seen:
                continue
            seen.add(sess)
            try:
                GLib.idle_add(open_restored, *_restore_one(sess, label, snaps.get(sess) if isinstance(snaps, dict) else None))
            except Exception as e:
                print(f"no pude restaurar {key}: {e}")
        GLib.idle_add(finish)
    threading.Thread(target=work, daemon=True).start()
    return False


# Punto de estado por pestana: el color se procesa ANTES de leer el nombre
# (ambar: espera tu respuesta / azul: trabajando / verde: listo)
# Semaforo refinado: tonos suaves y armonicos, mismos en tabs y cards GTK
# Semaforo "aurora": tonos apagados y elegantes que no pelean con Bruno
DOT_COLORS = {"waiting": "#D08770", "working": "#81A1C1",
              "done": "#A3BE8C", "dead": "#BF616A"}
DOT_IDLE = "#4B5568"
STATE_CACHE = {}   # session -> status (lo alimenta el poller de /state)
STATE_ITEMS = {}   # session -> item completo de /state para el switcher


_TAB_RENAME_CSS = None
def _apply_tab_rename_css(entry):
    """Estilo oscuro compacto para el Entry inline de renombre de pestaña.
    Provee color/bg del tema noche + border sutil. Aplicado por widget para no
    afectar Entries de otros lados de la app."""
    global _TAB_RENAME_CSS
    if _TAB_RENAME_CSS is None:
        _TAB_RENAME_CSS = Gtk.CssProvider()
        _TAB_RENAME_CSS.load_from_data((
            b"entry.tab-rename{"
            b" background:" + THEME["bg"].encode() + b";"
            b" color:" + THEME["text"].encode() + b";"
            b" border:1px solid " + THEME["brand"].encode() + b";"
            b" border-radius:4px;"
            b" padding:1px 6px;"
            b" min-height:20px;"
            b" font-family:'JetBrainsMono Nerd Font Mono',monospace;"
            b" font-size:11px;"
            b" caret-color:" + THEME["cursor"].encode() + b";"
            b"}"
            b"entry.tab-rename selection{"
            b" background:" + THEME["line2"].encode() + b";"
            b"}"
        ))
    entry.get_style_context().add_provider(
        _TAB_RENAME_CSS, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def tab_label(text, key=None, closable=True, on_close=None):
    hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    # E1: one 14 px indicator per tab (mark / working ring / neutral ring); it
    # replaces the coloured dot and keeps fixed bounds while it animates.
    dot = Gtk.Image.new_from_pixbuf(_indicator_pixbuf("none", DOT_IDLE, 0))
    dot_box = Gtk.EventBox()
    dot_box.set_visible_window(False)
    dot_box.add(dot)
    dot_box.set_tooltip_text("Estado de la pestaña: clic para cambiarlo" if ES else "Tab state: click to change it")
    hb.pack_start(dot_box, False, False, 0)
    hb._work_mark = dot
    if key and key != "local":
        def _open_state_menu(widget, event):
            if event.button != 1:
                return False
            menu = tab_indicator_menu(key, None)
            menu.popup_at_widget(widget, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, event)
            return True   # the tab itself is selected by its name, not by the indicator
        dot_box.connect("button-press-event", _open_state_menu)
    lbl = Gtk.Label(label=text)
    lbl.set_xalign(0.0)
    lbl.get_style_context().add_class("tab-name")
    # EventBox permite recibir clicks (Label no los captura por default).
    # Doble-click = renombrar inline; sin bloquear el single-click que
    # GtkNotebook usa para cambiar de pestaña.
    lbl_box = Gtk.EventBox()
    lbl_box.set_visible_window(False)
    lbl_box.add(lbl)
    hb.pack_start(lbl_box, False, False, 0)
    micon = Gtk.Image()
    micon.set_no_show_all(True)            # vacía no ocupa: un show_all (ws_tab_label) la revivía y dejaba un hueco
    hb.pack_start(micon, False, False, 0)
    model_lbl = Gtk.Label(label="")
    model_lbl.set_xalign(0.0)              # el texto arranca a 8 px del nombre, sin centrarse en su caja
    model_lbl.get_style_context().add_class("tab-model")
    hb.pack_start(model_lbl, False, False, 0)
    hb._dot = dot
    hb._text = lbl
    hb._micon = micon
    hb._model = model_lbl
    hb._text_box = lbl_box
    globals().get("ws_drag_source", lambda *a: None)(lbl_box, key)
    if key and key != "local":
        # Tu canal (grill 30-sep): sticker con tu marca y «¿Hecho? ✓» cuando la IA terminó.
        sticker = Gtk.Label(label="")
        sticker.set_valign(Gtk.Align.CENTER)
        sticker.get_style_context().add_class("tab-sticker")
        sticker.set_no_show_all(True)
        hb.pack_start(sticker, False, False, 0)
        hb._sticker = sticker
        suggest = Gtk.Button(label="¿Hecho? ✓" if ES else "Done? ✓")
        suggest.set_relief(Gtk.ReliefStyle.NONE)
        suggest.set_focus_on_click(False)
        suggest.get_style_context().add_class("tab-suggest")
        suggest.set_tooltip_text("La IA terminó y no preguntó nada: márcala como hecha" if ES
                                 else "The AI finished without asking: mark it done")
        suggest.set_no_show_all(True)
        suggest.set_valign(Gtk.Align.CENTER)
        suggest.connect("clicked", lambda *_: set_work_mark("session", key, "resolved"))
        hb.pack_start(suggest, False, False, 0)
        hb._suggest = suggest
        favorite = Gtk.Button(label="☆")
        favorite.set_relief(Gtk.ReliefStyle.NONE)
        favorite.set_focus_on_click(False)
        favorite.get_style_context().add_class("tabfav")
        if key in TAB_FAVORITES:
            favorite.get_style_context().add_class("favorite")
        favorite.set_tooltip_text(("Quitar de favoritos" if key in TAB_FAVORITES else "Marcar como favorita") if ES
                                  else ("Remove from favorites" if key in TAB_FAVORITES else "Add to favorites"))
        favorite.set_valign(Gtk.Align.CENTER)
        favorite.connect("clicked", lambda *_: toggle_tab_favorite(key))
        hb.pack_start(favorite, False, False, 0)
        hb._favorite = favorite
        if key in TAB_FAVORITES:
            _paint_favorite_button(favorite, True)

    def begin_rename(*_):
        if getattr(hb, "_editing", False) or key is None:
            return
        box = tabs.get(key)
        if box is None:
            return
        hb._editing = True
        cur = lbl.get_text()
        entry = Gtk.Entry()
        entry.set_text(cur)
        # Ancho ajustado al contenido — no "brinca" la barra de pestañas.
        n = max(6, min(28, len(cur) + 1))
        entry.set_width_chars(n)
        entry.set_max_width_chars(n)
        entry.set_has_frame(False)
        entry.set_alignment(0.0)
        entry.get_style_context().add_class("tab-rename")
        _apply_tab_rename_css(entry)
        lbl_box.hide()
        hb.pack_start(entry, False, False, 0)
        hb.reorder_child(entry, 1)
        entry.show()
        entry.grab_focus()
        entry.select_region(0, -1)

        def finish(save):
            if not getattr(hb, "_editing", False):
                return
            hb._editing = False
            val = entry.get_text().strip()
            try:
                hb.remove(entry)
            except Exception:
                pass
            entry.destroy()
            lbl_box.show()
            if save and val and val != cur:
                set_tab_label(box, val)

        def on_key(_w, ev):
            if ev.keyval == Gdk.KEY_Return:
                finish(True); return True
            if ev.keyval == Gdk.KEY_Escape:
                finish(False); return True
            return False

        entry.connect("activate", lambda *_: finish(True))
        entry.connect("focus-out-event", lambda *_: (finish(True), False)[1])
        entry.connect("key-press-event", on_key)

    def on_click(_w, ev):
        if ev.type == Gdk.EventType._2BUTTON_PRESS and ev.button == 1:
            begin_rename()
            return True
        if ev.button == 3 and key and key != "local":   # clic derecho: estado y favorita
            menu = tab_indicator_menu(key, None)
            menu.popup_at_pointer(ev)
            return True
        return False

    lbl_box.connect("button-press-event", on_click)

    if closable:
        b = Gtk.Button()
        pb = GdkPixbuf.Pixbuf.new_from_file_at_size(
            os.path.join(_ICONS_DIR, "close.svg"), 12, 12)
        b.set_image(Gtk.Image.new_from_pixbuf(pb))
        b.set_always_show_image(True)
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.get_style_context().add_class("tabclose")
        b.set_valign(Gtk.Align.CENTER)
        b.connect("clicked", lambda *_: on_close() if on_close else close_tab(key))
        hb.pack_start(b, False, False, 0)
    hb.show_all()
    if key:
        paint_tab_mark(hb, key)
    return hb


def update_dots(states, items=None, notif_count=None):
    STATE_CACHE.clear()
    STATE_CACHE.update(states)
    if notif_count is not None:
        set_notif_badge(notif_count)
    if items is not None:
        STATE_ITEMS.clear()
        STATE_ITEMS.update({it.get("session"): it for it in items if it.get("session")})
    _paint_all_tab_marks()
    return False


def apply_terminal_prefs(p=None):
    """Re-aplica las prefs de terminal EN VIVO a TODAS las terminales
    abiertas (fuente, cursor, padding, opacidad). Con p=None re-aplica las
    globals actuales (util tras un cambio de tema, que resetea colores sin
    la opacidad). make_term usa estas mismas globals: las tabs nuevas nacen
    ya con los valores nuevos."""
    global _PF_FAMILY, _PF_SIZE, FONT_FAMILY, FONT_SIZE, FONT
    global TERM_PADDING, TERM_OPACITY, _CURSOR_SHAPE, _CURSOR_BLINK
    if p is not None:
        _PF_FAMILY = (p.get("font_family") or "").strip() or "Ubuntu Sans Mono"
        _PF_SIZE = int(p.get("font_size") or FONT_SIZE)
        FONT_FAMILY = f"{_PF_FAMILY},JetBrainsMono Nerd Font,JetBrains Mono,DejaVu Sans Mono,Monospace"
        FONT_SIZE = _PF_SIZE
        FONT = f"{FONT_FAMILY} {FONT_SIZE}"
        TERM_PADDING = max(0, min(40, int(p.get("terminal_padding", 8))))
        TERM_OPACITY = max(30, min(100, int(p.get("terminal_opacity", 100)))) / 100.0
        _CURSOR_SHAPE = (p.get("cursor_shape") or "block")
        _CURSOR_BLINK = bool(p.get("cursor_blink", True))
    for page in notebook_pages():
        term = getattr(page, "_term", None)
        if term is None:
            continue
        try:
            term.set_font(Pango.FontDescription(FONT)); _term_line_scale(term)
            term.set_colors(rgba(THEME["fg"]), _bg_rgba(), [rgba(c) for c in THEME["pal"]])
            term.set_color_cursor(rgba(THEME["cursor"]))
            term.set_cursor_shape(_CURSOR_SHAPE_MAP.get(_CURSOR_SHAPE, Vte.CursorShape.BLOCK))
            term.set_cursor_blink_mode(
                Vte.CursorBlinkMode.ON if _CURSOR_BLINK else Vte.CursorBlinkMode.OFF)
            term.set_margin_start(TERM_PADDING + 2)
            term.set_margin_end(max(0, TERM_PADDING - 4))
            term.set_margin_top(TERM_PADDING + HEADER_EXTRA)
            term.set_margin_bottom(max(0, TERM_PADDING - 2))
        except Exception:
            pass
    return False


# Prefs que, al cambiar en Ajustes (desde la app, Chrome O el celular),
# deben reflejarse EN TIEMPO REAL en las terminales abiertas.
_LIVE_PREF_KEYS = ("font_family", "font_size", "cursor_shape", "cursor_blink",
                   "terminal_padding", "terminal_opacity", "theme", "tabs_layout")


_POLL_UI_LOCK = threading.Lock()
_POLL_UI_PENDING = {}
_POLL_UI_QUEUED = False


def _queue_poll_update(callback, *args):
    """Keep only the latest polled value for each UI callback while GTK is busy."""
    global _POLL_UI_QUEUED
    with _POLL_UI_LOCK:
        # Preserve the order of the latest calls: terminal prefs must follow
        # a theme update even when an older font-only update was pending.
        _POLL_UI_PENDING.pop(callback, None)
        _POLL_UI_PENDING[callback] = args
        if _POLL_UI_QUEUED:
            return
        _POLL_UI_QUEUED = True
    GLib.idle_add(_drain_poll_updates)


def _drain_poll_updates():
    global _POLL_UI_QUEUED
    with _POLL_UI_LOCK:
        updates = list(_POLL_UI_PENDING.items())
        _POLL_UI_PENDING.clear()
        _POLL_UI_QUEUED = False
    for callback, args in updates:
        try:
            callback(*args)
        except Exception as exc:
            print(f"desktop poll update: {exc}", file=sys.stderr)
    return False


def notices_watch_loop():
    """Campana sincronizada al instante (1-oct): espera abierta contra /notices/watch,
    que responde en cuanto llega un aviso o se lee alguno en cualquier equipo."""
    rev = ""
    while True:
        try:
            q = urlencode({"rev": rev, "wait": 25})
            with urllib.request.urlopen(BASE_URL + "/notices/watch?" + q, timeout=35) as r:
                d = json.loads(r.read().decode())
            rev = str(d.get("rev") or "")
            GLib.idle_add(set_notif_badge, int(d.get("badge") or 0))
        except Exception:
            time.sleep(2)


def poll_state_loop():
    last_prefs = None
    while True:
        try:
            with urllib.request.urlopen(BASE_URL + "/state", timeout=3) as r:
                items = json.loads(r.read().decode())
            states = {it["session"]: it.get("status", "idle")
                      for it in items if it.get("session")}
            # El número de la campana lo pone notices_watch_loop al instante; aquí no.
            _queue_poll_update(update_dots, states, items, None)
        except Exception:
            pass
        # Watcher de prefs: Ajustes cambiado en CUALQUIER superficie se aplica
        # aqui en <=3s a todas las terminales (fuente/cursor/padding/opacidad
        # y tema). Antes solo se leian al arrancar la app.
        try:
            favorite_generation = _FAVORITE_GENERATION
            with urllib.request.urlopen(BASE_URL + "/prefs", timeout=3) as r:
                p = json.loads(r.read().decode())
            _queue_poll_update(apply_tab_favorites, p.get("favorites", []), favorite_generation)
            snap = {k: p.get(k) for k in _LIVE_PREF_KEYS}
            if last_prefs is None:
                last_prefs = snap
            elif snap != last_prefs:
                theme_changed = snap.get("theme") != last_prefs.get("theme")
                last_prefs = snap
                if theme_changed and snap.get("theme"):
                    _queue_poll_update(apply_theme, snap["theme"])
                if snap.get("tabs_layout") in ("row", "rows"):
                    _queue_poll_update(apply_tabs_layout, snap["tabs_layout"], False)
                # tras el tema tambien: recolorea con la OPACIDAD correcta
                _queue_poll_update(apply_terminal_prefs, p)
        except Exception:
            pass
        time.sleep(3)


def _confirm_must_answer(primary, secondary, yes_label, no_label):
    """Confirm dialog bloqueante — solo cierra con Yes o No. Embebido en
    modal_overlay con dismissable=False: backdrop y ESC son no-op. GLib.MainLoop
    interno para retornar sincronicamente."""
    result = {"value": False, "finished": False}
    loop = GLib.MainLoop()

    # Panel como Frame widget (no toplevel).
    panel = Gtk.Frame()
    panel.set_size_request(480, -1)
    panel.set_halign(Gtk.Align.CENTER); panel.set_valign(Gtk.Align.CENTER)
    panel.get_style_context().add_class("cc-snip-dialog")  # mismo look que snippets

    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    panel.add(root)

    body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
    body.set_margin_top(20); body.set_margin_bottom(16)
    body.set_margin_start(22); body.set_margin_end(22)
    icon = Gtk.Image.new_from_icon_name("dialog-question-symbolic", Gtk.IconSize.DIALOG)
    body.pack_start(icon, False, False, 0)
    txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    l1 = Gtk.Label(label=primary, xalign=0); l1.set_line_wrap(True)
    l1.get_style_context().add_class("primary")
    l2 = Gtk.Label(label=secondary, xalign=0); l2.set_line_wrap(True)
    l2.get_style_context().add_class("dim-label")
    txt.pack_start(l1, False, False, 0)
    txt.pack_start(l2, False, False, 0)
    body.pack_start(txt, True, True, 0)
    root.pack_start(body, True, True, 0)

    actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    actions.set_margin_top(6); actions.set_margin_bottom(14)
    actions.set_margin_start(16); actions.set_margin_end(16)
    actions.set_homogeneous(True)
    no_btn = Gtk.Button(label=no_label)
    yes_btn = Gtk.Button(label=yes_label)
    actions.pack_start(no_btn, True, True, 0)
    actions.pack_start(yes_btn, True, True, 0)
    root.pack_start(actions, False, False, 0)

    close_ref = [None]
    def _finish(value):
        if result["finished"]:
            return
        result["value"] = value
        result["finished"] = True
        if close_ref[0]:
            close_ref[0]()
        try: loop.quit()
        except Exception: pass

    no_btn.connect("clicked", lambda *_: _finish(False))
    yes_btn.connect("clicked", lambda *_: _finish(True))

    # Y/N keyboard shortcuts (must-answer no permite ESC).
    def on_key(ev):
        if ev.keyval in (Gdk.KEY_y, Gdk.KEY_Y, Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            _finish(True); return True
        if ev.keyval in (Gdk.KEY_n, Gdk.KEY_N):
            _finish(False); return True
        return False

    close_ref[0] = show_modal_panel(panel, on_key=on_key, dismissable=False)
    yes_btn.grab_focus()
    loop.run()
    return bool(result["value"])


def close_tab(key, confirm=True):
    # Confirmar SIEMPRE (salvo cierres ya confirmados en el tablero remoto).
    # La sesion tmux sigue viva y queda en "Recientes (cerradas)" del tablero.
    box = tabs.get(key)
    label = getattr(box, "_label", key) if box is not None else key
    # NO usamos Gtk.MessageDialog + d.run() — en WSLg el compositor destruia
    # la ventana con click afuera (bypassing modal+deletable+delete-event) y
    # d.run() retornaba NONE dejando la logica en estado indefinido.
    # Alternativa: Gtk.Window custom + GLib.MainLoop propio + boton YES/NO.
    # Al no ser Gtk.Dialog, no hay response signal ni handling default del WM.
    snip_log(f"close_tab confirm for key={key} label={label} confirm={confirm}")
    resp = True if not confirm else _confirm_must_answer(
        primary=(f"¿Cerrar la pestaña «{label}»?" if ES else f"Close tab “{label}”?"),
        secondary=("La sesión tmux sigue viva; puedes recuperarla en Recientes del tablero."
                   if ES else
                   "The tmux session stays alive; recover it from the dashboard's Recents."),
        yes_label=("Sí" if ES else "Yes"),
        no_label=("No" if ES else "No"),
    )
    snip_log(f"close_tab confirm resp={resp}")
    if not resp:
        return
    archive_tab(key, reason="closed")
    box = tabs.pop(key, None)
    if box is not None:
        if getattr(box, "_term", None) is not None:
            box._term._respawn = False
        ws_forget(key, box)
    save_tabs()
    # Scratch (term-*) con puro shell ocioso: cerrar la pestana MATA la sesion
    # (adios sesiones fantasma). Si algo corre adentro (vite, claude, ssh...),
    # la sesion sobrevive como siempre.
    if key and key.startswith("term-"):
        r = tmuxc("list-panes", "-s", "-t", "=" + key, "-F", "#{pane_current_command}")
        cmds = set(r.stdout.split())
        if r.returncode == 0 and cmds and cmds <= {"zsh", "bash", "sh", "fish"}:
            tmuxc("kill-session", "-t", "=" + key)


def current_cwd():
    """Directorio del pane activo de la pestana actual (para 'nueva terminal aqui')."""
    page = nb.get_nth_page(nb.get_current_page())
    term = getattr(page, "_term", None)
    if term:
        sess = term_session(term)
        if sess:
            r = tmuxc("display-message", "-p", "-t", f"={sess}:", "#{pane_current_path}")
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
    return os.path.expanduser("~")


TERM_N = [0]
_TERM_N_LOCK = threading.Lock()


def _create_term_session(cwd):
    """Crea term-<pid>-<n> sin chocar con sesiones vivas de corridas previas
    (el pid se repite). Devuelve el nombre solo si tmux confirma; si no, None."""
    for _ in range(50):
        with _TERM_N_LOCK:
            TERM_N[0] += 1
            sess = f"term-{os.getpid() % 10000}-{TERM_N[0]}"
        if subprocess.run(["tmux", "has-session", "-t", "=" + sess],
                          capture_output=True, timeout=5).returncode == 0:
            continue
        tmux = ["tmux", "new-session", "-d", "-P", "-F", "#{session_name}", "-s", sess, "-c", cwd]
        try:
            r = subprocess.run(["systemd-run", "--user", "--scope", "--collect", "--quiet", *tmux],
                               capture_output=True, text=True, timeout=12)
        except FileNotFoundError:
            r = subprocess.run(tmux, capture_output=True, text=True, timeout=12)
        if r.returncode == 0 and (r.stdout or "").strip() == sess:
            return sess
        if subprocess.run(["tmux", "has-session", "-t", "=" + sess],
                          capture_output=True, timeout=5).returncode != 0:
            return None   # fallo real, no una colision
    return None


def new_local_tab(*_):
    """Nueva pestana de terminal en el MISMO directorio donde esta el cursor."""
    cwd = current_cwd()

    def done(sess):
        if sess:
            open_tab(sess, "claude", label=os.path.basename(cwd) or "term")
        else:
            notify_popup("Nueva terminal" if ES else "New terminal",
                         "tmux no pudo crear la sesion" if ES else "tmux could not create the session")
        return False

    def work():
        try:
            sess = _create_term_session(cwd)
        except Exception as ex:
            print(f"new_local_tab: {ex}")
            sess = None
        GLib.idle_add(done, sess)
    threading.Thread(target=work, daemon=True).start()


# Terminal rápida (E2): shell pelona en una carpeta fechada NUEVA que elige
# cc-dash (/terminal/quick, el mismo backend que el remoto). No hereda el cwd
# del pane activo. El requestId se conserva hasta el éxito: un reintento
# devuelve la MISMA terminal y nunca abre dos shells.
_QUICK_TERMINAL_PENDING = [None]
_QUICK_TERMINAL_BUSY = [False]


def request_quick_terminal(make_id=None):
    """Corre en hilo. Devuelve (resultado, error)."""
    rid = _QUICK_TERMINAL_PENDING[0]
    if not rid:
        rid = make_id() if make_id else "gtk-" + secrets.token_hex(12)
        _QUICK_TERMINAL_PENDING[0] = rid
    result, err = http_post("/terminal/quick", {"requestId": rid}, timeout=30)
    if isinstance(result, dict) and result.get("tabId"):
        if _QUICK_TERMINAL_PENDING[0] == rid:
            _QUICK_TERMINAL_PENDING[0] = None
        return result, None
    return None, err or ("sin respuesta de cc-dash" if ES else "no answer from cc-dash")


def open_quick_terminal(*_):
    if _QUICK_TERMINAL_BUSY[0]:
        return
    _QUICK_TERMINAL_BUSY[0] = True

    def done(result, err):
        _QUICK_TERMINAL_BUSY[0] = False
        if result:
            open_tab(result["tabId"], "claude", label=result.get("label") or result["tabId"])
        else:
            notify_popup("Terminal", err)
        return False

    def work():
        try:
            result, err = request_quick_terminal()
        except Exception as ex:
            result, err = None, str(ex)
        GLib.idle_add(done, result, err)
    threading.Thread(target=work, daemon=True).start()


def _ensure_cc_webterm():
    """Arranca cc-webterm si no responde en 127.0.0.1:4779. Idempotente."""
    try:
        urllib.request.urlopen("http://127.0.0.1:4779/token", timeout=0.4)
        return
    except Exception:
        pass
    bin_path = shutil.which("cc-webterm") or os.path.join(CC_REPO, "bin", "cc-webterm")
    subprocess.Popen([bin_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


_XTERM_PENDING = set()


def open_xterm_tab(sess="local"):
    """Pestana EXPERIMENTAL con xterm.js dentro de WebKit2WebView, que shape las
    ligaduras de JetBrainsMono (VTE no las shape). Reusa cc-webterm (ttyd en
    127.0.0.1:4779) como backend PTY vía WebSocket. Arrancar cc-webterm y
    pedir el token va en un hilo; la pestana se arma en GTK por idle_add."""
    if not WIN_RE.match(sess or ""):
        sess = "local"
    key = f"xterm-{sess}"
    if key in tabs:
        ws_select(key)
        return
    if key in _XTERM_PENDING:
        return
    _XTERM_PENDING.add(key)
    theme_name = next((k for k, v in THEMES.items() if v is THEME), "noche")

    def build(token):
        _XTERM_PENDING.discard(key)
        if key in tabs:
            return False
        uri = (f"file://{TERM_HTML}?auth={quote(token, safe='')}&"
               f"arg={quote(sess, safe='')}&theme={quote(theme_name, safe='')}")

        wv = WebKit2.WebView()
        st = wv.get_settings()
        # file:// necesita permiso explícito para leer TTF y .js del mismo repo.
        try: st.set_property("allow-file-access-from-file-urls", True)
        except Exception: pass
        try: st.set_property("allow-universal-access-from-file-urls", True)
        except Exception: pass
        st.set_property("enable-write-console-messages-to-stdout", True)
        wv.load_uri(uri)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.pack_start(wv, True, True, 0)
        box._term = None          # no es VTE — los handlers que lo usan lo ignoran
        box._webview = wv
        box._key = key
        box._label = f"xterm · {sess}"
        idx = nb.append_page(box, tab_label(box._label, key))
        nb.set_tab_reorderable(box, False)
        box.show_all()
        nb.set_current_page(idx)
        tabs[key] = box
        save_tabs()
        return False

    def work():
        token = ""
        try:
            _ensure_cc_webterm()
            with urllib.request.urlopen(BASE_URL + "/webterm-token", timeout=2) as response:
                token = json.loads(response.read().decode()).get("token") or ""
        except Exception:
            pass
        GLib.idle_add(build, token)
    threading.Thread(target=work, daemon=True).start()


WIN_RE = re.compile(r"^[A-Za-z0-9_-]{1,32}$")
SESSION_RE = re.compile(r"^[A-Za-z0-9._-]{1,80}$")   # el mismo que cc-dash


def select_win(sess, winname):
    """Selecciona la ventana pedida. Si 'claude' ya no se llama asi (claude
    murio o relanzado y tmux renombro la ventana), busca donde corre claude
    de verdad; si en ninguna, la primera ventana — nunca el shell perdido."""
    if tmuxc("select-window", "-t", f"={sess}:{winname}").returncode == 0:
        return
    if winname != "claude":
        return
    r = tmuxc("list-panes", "-s", "-t", "=" + sess,
              "-F", "#{window_index}|#{pane_current_command}")
    for l in r.stdout.splitlines():
        idx, _, cmd = l.partition("|")
        if cmd == "claude":
            tmuxc("select-window", "-t", f"={sess}:{idx}")
            return
    tmuxc("select-window", "-t", f"={sess}:^")


def open_tab(sess, winname, label=None):
    """Abre (o enfoca) LA pestana de una sesion tmux; winname elige que ventana
    (claude/shell/ssh) se muestra."""
    if not WIN_RE.match(winname or ""):
        winname = "claude"
    if not SESSION_RE.match(sess or ""):
        print(f"open_tab: sesion invalida {sess!r}")
        return
    key = sess
    if ssh_host_from_session(sess):
        tmuxc("set-option", "-t", sess, "mouse", "off")
    if key in tabs:
        select_win(sess, winname)
        ws_select(key)
        return
    select_win(sess, winname)
    target = shlex.quote("=" + sess)
    cmd = (f"tmux attach -t {target} || {{ echo '[sesion terminada — cierra esta pestana con la x]'; exec cat; }}")
    box = make_term(cmd, session=sess)
    box._key = key
    box._term._session_hint = sess
    _attach_model_bar(box, sess)
    box._label = label or saved_tab_label(sess) or sess
    idx = nb.append_page(box, tab_label(box._label, key))
    nb.set_tab_reorderable(box, False)
    box.show_all()
    nb.set_current_page(idx)
    box._term.grab_focus()
    tabs[key] = box
    save_tabs()


def set_tab_label(box, text):
    box._label = text
    hb = tab_hb(box)
    if hb is not None and getattr(hb, "_text", None) is not None:
        hb._text.set_text(text)
    save_tabs()


def fuzzy_score(q, s):
    """None si no matchea; menor = mejor (subsecuencia con saltos penalizados)."""
    q, s = q.lower(), s.lower()
    score, pos = 0, 0
    for ch in q:
        i = s.find(ch, pos)
        if i < 0:
            return None
        score += i - pos
        pos = i + 1
    return score + len(s) * 0.01


SW_ORDER = {"waiting": 0, "done": 1, "working": 2}
SW_HINT = ({"waiting": "espera TU respuesta", "working": "trabajando", "done": "listo"} if ES else
           {"waiting": "waiting for YOU", "working": "working", "done": "done"})


def close_on_click_outside(w):
    """Cierra un popup al hacer click fuera / Alt+Tab / ESC.
    En WSLg ni focus-out ni el bubbling de button-press son confiables cuando
    hay `transient_for + modal=False`. La forma robusta es un POINTER GRAB
    (Gdk.Seat.grab): mientras el popup vive, TODOS los clicks del display
    llegan primero a `w` — chequeamos si el punto cae dentro del bbox del
    popup y, si no, cerramos y propagamos el click a la app."""
    w._armed = False
    w._seat = None

    def _arm():
        w._armed = True
        try:
            seat = w.get_display().get_default_seat()
            gdkwin = w.get_window()
            if gdkwin is not None:
                seat.grab(gdkwin,
                          Gdk.SeatCapabilities.POINTER,
                          True, None, None, None)
                w._seat = seat
        except Exception:
            pass
        return False

    def _release_grab():
        try:
            if w._seat is not None:
                w._seat.ungrab()
                w._seat = None
        except Exception:
            pass

    def _kill():
        _release_grab()
        w.destroy()
        return False

    def _dismiss():
        if not getattr(w, "_armed", False):
            return
        w._armed = False
        _release_grab()
        # DESTROY sync — hide+idle nunca completaba porque WSLg emitía un
        # enter-notify sobre la ventana hidden y la reactivaba antes de que
        # el idle callback disparara.
        try:
            w.destroy()
        except Exception:
            pass

    def on_press(_w, ev):
        if not getattr(w, "_armed", False):
            return False
        wx, wy = w.get_position()
        ww, wh = w.get_size()
        px, py = int(ev.x_root), int(ev.y_root)
        inside = wx <= px < wx + ww and wy <= py < wy + wh
        if inside:
            return False   # dejar que el widget hijo maneje el click
        _dismiss()
        return True

    def on_key(_w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            _dismiss()
            return True
        return False

    def _tick():
        # Polling — la única señal confiable en WSLg de "perdió foco".
        # Cuando is_active() == False después de estar armado, cerramos.
        if not getattr(w, "_armed", False):
            return False   # stop
        try:
            if not w.is_active():
                _dismiss()
                return False
        except Exception:
            return False
        return True

    w.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    w.connect("button-press-event", on_press)
    w.connect("key-press-event", on_key)
    w.connect("destroy", lambda *_: _release_grab())
    GLib.timeout_add(200, _arm)
    GLib.timeout_add(300, _tick)   # empieza a poll después de armado


def open_switcher(*_):
    """Ctrl+K: saltar a cualquier pestana/sesion escribiendo 2-3 letras.
    Las que ESPERAN tu respuesta salen arriba; Enter va a la primera.
    Panel embebido en modal_overlay."""
    # Panel como Frame widget (no toplevel).
    w = Gtk.Frame()
    w.set_size_request(560, -1)
    w.set_halign(Gtk.Align.CENTER); w.set_valign(Gtk.Align.CENTER)
    w.get_style_context().add_class("switcher")
    close_ref = [None]
    def _close():
        if close_ref[0]:
            close_ref[0]()
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    v.set_property("margin", 12)
    entry = Gtk.Entry()
    entry.set_placeholder_text("Salta a...  (parte del nombre, Enter va a la primera)" if ES else
                                "Jump to...  (type part of a name, Enter opens the first)")
    v.pack_start(entry, False, False, 0)
    lb = Gtk.ListBox()
    lb.set_activate_on_single_click(True)
    v.pack_start(lb, True, True, 0)
    w.add(v)
    rows = []

    def candidates():
        out, seen = [], set()
        for page in notebook_pages():
            key = getattr(page, "_key", None)
            if key in tabs:
                out.append((tab_page_label(page), key, True))
                seen.add(key)
        for s, it in STATE_ITEMS.items():
            if s in seen or s == "local" or it.get("alive") is False or it.get("zombie"):
                continue
            orphan_term = s.startswith("term-") and not it.get("tabbed") and \
                not it.get("agent") and it.get("status", "idle") == "idle"
            if orphan_term:
                continue
            out.append((it.get("project") or s, s, False))
        return out

    def refill(*_):
        for ch in lb.get_children():
            lb.remove(ch)
        rows.clear()
        q = entry.get_text().strip()
        scored = []
        for label, key, is_open in candidates():
            sc = fuzzy_score(q, f"{label} {key}") if q else 0
            if sc is None:
                continue
            st = STATE_CACHE.get(key, "")
            scored.append((SW_ORDER.get(st, 3), sc, label.lower(), label, key, st, is_open))
        scored.sort()
        for _, _, _, label, key, st, is_open in scored[:12]:
            r = Gtk.ListBoxRow()
            h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
            h.set_property("margin", 7)
            d = Gtk.Label()
            d.set_markup(f'<span size="9000" foreground="{DOT_COLORS.get(st, DOT_IDLE)}">●</span>')
            h.pack_start(d, False, False, 0)
            h.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
            hint = SW_HINT.get(st, "") + ("" if is_open else ("   [abrir]" if ES else "   [open]"))
            m = Gtk.Label(label=hint.strip(), xalign=1)
            m.get_style_context().add_class("sw-meta")
            h.pack_end(m, False, False, 0)
            r.add(h)
            lb.add(r)
            rows.append((r, key, is_open))
        lb.show_all()
        if rows:
            lb.select_row(rows[0][0])

    def go(row):
        for r, key, _is_open in rows:
            if r is row:
                _close()
                open_tab(key, "claude")
                return

    def close_selected():
        sel = lb.get_selected_row()
        for r, key, is_open in rows:
            if r is sel and is_open and key in tabs:
                close_tab(key)
                refill()
                return True
        return True

    def move_sel(delta):
        sel = lb.get_selected_row()
        idx = next((i for i, (r, _key, _is_open) in enumerate(rows) if r is sel), 0)
        idx = max(0, min(len(rows) - 1, idx + delta))
        if rows:
            lb.select_row(rows[idx][0])

    # on_key handler para el switcher — retorna True si consume la tecla.
    # ESC ya lo maneja show_modal_panel; los demas son navegacion propia.
    def on_sw_key(ev):
        if ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            sel = lb.get_selected_row()
            if sel:
                go(sel)
            return True
        if ev.keyval == Gdk.KEY_Down:
            move_sel(1); return True
        if ev.keyval == Gdk.KEY_Up:
            move_sel(-1); return True
        if ev.keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace) and entry.get_text() == "":
            return close_selected()
        if ev.state & Gdk.ModifierType.CONTROL_MASK and ev.keyval in (Gdk.KEY_w, Gdk.KEY_W):
            return close_selected()
        # Cuando el usuario tipea texto normal, redirigimos al entry si no
        # tiene foco todavia (por si el key llega al win antes que al entry).
        return False

    lb.connect("row-activated", lambda _l, row: go(row))
    entry.connect("changed", refill)
    refill()
    close_ref[0] = show_modal_panel(w, on_key=on_sw_key)
    entry.grab_focus()


def tab_page_label(page):
    if getattr(page, "_label", None):
        return page._label
    hb = tab_hb(page)
    txt = getattr(hb, "_text", None)
    if txt is not None:
        return txt.get_text()
    return getattr(page, "_key", "tab") or "tab"


def open_tabs_overview(*_):
    w = Gtk.Frame()
    w.set_size_request(500, 480)
    w.set_halign(Gtk.Align.CENTER); w.set_valign(Gtk.Align.CENTER)
    w.get_style_context().add_class("switcher")
    close_ref = [None]
    def _close():
        if close_ref[0]:
            close_ref[0]()
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    v.set_property("margin", 12)
    title = Gtk.Label(label="Tabs abiertas" if ES else "Open tabs", xalign=0)
    title.get_style_context().add_class("help-sec")
    v.pack_start(title, False, False, 0)
    sc = Gtk.ScrolledWindow()
    sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    sc.set_min_content_height(320)
    lb = Gtk.ListBox()
    lb.set_activate_on_single_click(True)
    sc.add(lb)
    v.pack_start(sc, True, True, 0)
    w.add(v)
    rows = []

    def focus_page(page):
        _close()
        idx = nb.page_num(page)
        if idx >= 0:
            nb.set_current_page(nb.page_num(page))
            term = getattr(page, "_term", None)
            if term:
                term.grab_focus()

    def refill():
        for ch in lb.get_children():
            lb.remove(ch)
        rows.clear()
        for page in notebook_pages():
            key = getattr(page, "_key", None)
            label = tab_page_label(page)
            st = STATE_CACHE.get(key, "") if key else ""
            row = Gtk.ListBoxRow()
            h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
            h.set_property("margin", 8)
            dot = Gtk.Label()
            dot.set_markup(f'<span size="9500" foreground="{DOT_COLORS.get(st, DOT_IDLE)}">●</span>')
            h.pack_start(dot, False, False, 0)
            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            texts.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
            meta = Gtk.Label(label=(key or "local"), xalign=0)
            meta.get_style_context().add_class("sw-meta")
            texts.pack_start(meta, False, False, 0)
            h.pack_start(texts, True, True, 0)
            if key:
                close = Gtk.Button(label="×")
                close.set_relief(Gtk.ReliefStyle.NONE)
                close.get_style_context().add_class("tabplus")

                def on_close(_b, key=key):
                    close_tab(key)
                    refill()

                close.connect("clicked", on_close)
                h.pack_end(close, False, False, 0)
            row.add(h)
            lb.add(row)
            rows.append((row, page))
        lb.show_all()

    def go(_lb, row):
        for r, page in rows:
            if r is row:
                focus_page(page)
                return

    lb.connect("row-activated", go)
    refill()
    close_ref[0] = show_modal_panel(w)


def rename_tab(key):
    box = tabs.get(key)
    if box is None:
        return
    dlg = Gtk.Dialog(title="Renombrar pestana" if ES else "Rename tab", transient_for=win)
    dlg.set_decorated(False)
    dlg.get_style_context().add_class("cc-dialog")
    dlg.add_buttons("Cancelar" if ES else "Cancel", Gtk.ResponseType.CANCEL,
                    "Renombrar" if ES else "Rename", Gtk.ResponseType.OK)
    area = dlg.get_content_area()
    area.set_property("margin", 14); area.set_spacing(8)
    area.add(Gtk.Label(label="Nombre de la pestana:" if ES else "Tab name:", xalign=0))
    entry = Gtk.Entry()
    entry.set_text(getattr(box, "_label", key))
    entry.set_activates_default(True)
    area.add(entry)
    dlg.set_default_response(Gtk.ResponseType.OK)
    dlg.show_all()
    entry.grab_focus()
    if dlg.run() == Gtk.ResponseType.OK:
        name = entry.get_text().strip()
        if name:
            set_tab_label(box, name)
    dlg.destroy()


# Estilo propio de la app (pestanas, scrollbars, separadores), tematizable
_prov = Gtk.CssProvider()
_prov.load_from_data(theme_css(THEME).encode())
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), _prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def apply_theme(name):
    """Cambia el tema EN CALIENTE: chrome GTK + colores de TODAS las
    terminales abiertas (lo dispara el boton de tema del tablero)."""
    global THEME
    THEME = THEMES.get(name, THEMES["noche"])
    try:
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", name != "dia")
    except Exception:
        pass
    _prov.load_from_data(theme_css(THEME).encode())
    # Regenerar el CSS de headerbar, menús, paned separator, notebook border
    # con los colores del NUEVO tema — sin esto queda "oscuro" en modo día.
    try:
        _HB_CSS.load_from_data(_build_hb_css())
        _PANED_CSS.load_from_data((
            b"paned.cc-paned > separator,paned.cc-paned paned > separator{"   # solo los de los paned: el de la cabecera de pane (box) se ve
            b" background:transparent;background-image:none;"
            b" background-color:transparent;"
            b" border:0;box-shadow:none;"
            b" min-width:0;min-height:0;margin:0;padding:0;"
            b"}"
            b"notebook.cc-notebook,notebook.cc-notebook > header,"
            b"notebook.cc-notebook > stack,notebook.cc-notebook > stack > *,"
            b"notebook.cc-notebook scrolledwindow,notebook.cc-notebook frame,"
            b"notebook.cc-notebook viewport{"
            b" border-top:0;border-right:0;border-bottom:0;"
            b" box-shadow:none;outline:none;"
            b"}"
            b"notebook.cc-notebook{"
            b" border-left:1px solid " + THEME["line"].encode() + b";"
            b" border-radius:0;"
            b"}"
        ) + _shelf_separator_css())
    except Exception as e:
        print(f"apply_theme CSS reload err: {e}")
    for button, icon_name, icon_size in list(globals().get("_THEMED_ICON_BUTTONS", [])):
        try:
            button.set_image(_themed_icon_image(icon_name, icon_size))
        except Exception:
            pass
    if "apply_tabs_layout" in globals():
        apply_tabs_layout(TABS_LAYOUT["mode"], False)     # el ⊞ activo vuelve al color de acento del tema nuevo
    if "_left_btn_paint" in globals():
        _left_btn_paint()
    for box in list(tabs.values()) + [hub]:
        t = getattr(box, "_term", None)
        if t:
            t.set_colors(rgba(THEME["fg"]), rgba(THEME["bg"]),
                         [rgba(p) for p in THEME["pal"]])
            t.set_color_cursor(rgba(THEME["cursor"]))
    # Tmux status bar — respetá el tema también. Sin esto la barra inferior
    # se veía oscura en modo día.
    _apply_tmux_theme()
    if "apply_button_style" in globals():
        apply_button_style()   # los botones de la cabecera usan los colores del tema nuevo


def _apply_tmux_theme():
    bg    = THEME["bar"]
    fg    = THEME["dim"]
    brand = THEME["brand"]
    text  = THEME["text"]
    line  = THEME["line"]
    for opts in (
        ("status-style",                 f"bg={bg},fg={fg}"),
        ("window-status-style",          f"bg={bg},fg={fg}"),
        ("window-status-current-style",  f"bg={bg},fg={text},bold"),
        ("window-status-activity-style", f"bg={bg},fg={THEME['cursor']},bold"),
        # Prototipo aprobado (30-sep): el marco de cada pane lo pinta la app
        # (_draw_pane_frames, verde el activo). Las líneas de tmux van del color
        # del fondo para no duplicarlo; copy-mode se sigue señalando en AMARILLO.
        ("pane-active-border-style",     f"#{{?pane_in_mode,fg=yellow,fg={THEME['bg']}}}"),
        ("pane-border-style",            f"fg={THEME['bg']}"),
        ("message-style",                f"bg={brand},fg={bg}"),
        # Riel reservado VACIO: el texto @ccmodel detras de la pildora GTK
        # (titulos $$$ / modelo) no se pinta. La pildora es el unico chrome.
        ("pane-border-status",           "top"),
        ("pane-border-format",           " "),
        # Prototipo: nada fuera de los marcos. La barra de pestañas de la app ya
        # dice dónde estás; la línea de estado de tmux sobraba debajo de los panes.
        ("status",                       "off"),
    ):
        tmuxc("set-option", "-g", opts[0], opts[1])

# Pestana "local": tu terminal de control (scratch en HOME). Es el cliente que
# mueven Super+N y los popups. No aparece como tarjeta en el tablero.
try:
    restore_saved_layout("local")
except Exception as exc:
    print(f"no pude restaurar local: {exc}", file=sys.stderr)
hub = make_term("tmux new-session -A -s local -c ~", before_spawn=prepare_local_terminal, session="local")
# Aplica el tema al tmux status ya en el arranque (idempotente).
GLib.timeout_add(500, lambda: (_apply_tmux_theme(), False)[1])
hub._key = "local"   # la pestana ⌂ opera la sesion tmux "local": sin esto, al pararte
# aqui el tablero seguia "pinneando" la sesion de la pestana anterior (p.ej. Signara)
nb.append_page(hub, tab_label("⌂ local", closable=False))
nb.set_tab_reorderable(hub, False)
nb.connect("page-reordered", on_tab_reordered)


# ---- Workspace compartido (bloque W): grupos de tabs acoplados, la MISMA
# distribucion que el remoto. cc-dash (/workspace) es la autoridad; aqui se
# reparentan las terminales existentes (nunca se recrean) y se arrastran tabs
# completas a bordes con vista previa, igual que en dash/workspace-dock.js.
_WS = {"revision": 0, "doc": None, "drag": None, "target": None, "posting": False, "press": None}


def ws_widget(key):
    return hub if key == "local" else tabs.get(key)


def ws_tab_label(key, text):
    if key.startswith("group:"):
        group_id = key[6:]
        hb = tab_label(text, key=None, closable=True, on_close=lambda: close_group_guarded(group_id))
        hb._set_group_text = hb._text.set_text
        hb._group = key[6:]
    else:
        hb = tab_label(text or key, key=key, closable=key != "local")
    hb.show_all()
    return hb


def ws_header(key, box):
    ev = Gtk.EventBox()
    ev.get_style_context().add_class("ws-leaf-head")
    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    grip = Gtk.Label(label="⠿")
    grip.get_style_context().add_class("dim-label")
    row.pack_start(grip, False, False, 0)
    name = Gtk.Label(label=getattr(box, "_label", key), xalign=0)
    name.set_ellipsize(Pango.EllipsizeMode.END)
    row.pack_start(name, True, True, 0)
    ev.add(row)
    ev.set_tooltip_text("Arrastra para mover esta tab" if ES else "Drag to move this tab")
    ev.connect("button-press-event", lambda *_: (ws_select(key), False)[1])
    ws_drag_source(ev, key)
    return ev


def ws_forget(key, box):
    """Drop a closed tab: plain page removed, docked member taken out."""
    page = WS_VIEW.page_of(box)
    if isinstance(page, gtk_workspace.GroupPage):
        leaf = page.leaves.pop(key, None)
        page.members.pop(key, None)
        if leaf is not None and box.get_parent() is leaf:
            leaf.remove(box)
        page._shape = None
        if WS_VIEW.doc is not None:
            WS_VIEW.apply(WS_VIEW.doc)
    elif page is not None and nb.page_num(page) >= 0:
        nb.remove_page(nb.page_num(page))


def ws_select(key):
    if not WS_VIEW.select(key):
        box = ws_widget(key)
        if box is not None and nb.page_num(box) >= 0:
            nb.set_current_page(nb.page_num(box))


WS_VIEW = gtk_workspace.WorkspaceView(nb, ws_widget, ws_tab_label, ws_header)


def ws_apply(state):
    if not isinstance(state, dict) or not isinstance(state.get("groups"), list):
        return False
    if _WS["drag"] is not None or _WS["posting"]:
        return False           # nunca mover la distribucion bajo un gesto
    doc = {"schema": state.get("schema", 1), "groups": state["groups"], "tabs": state.get("tabs", {})}
    if "bindings" in state:
        doc["bindings"] = state["bindings"]
    _WS["doc"], _WS["revision"] = doc, state.get("revision", 0)
    try:
        WS_VIEW.apply(doc)
    except Exception as exc:
        print(f"workspace apply: {exc}", file=sys.stderr)
    if not _WS.get("focus_restored"):
        _WS["focus_restored"] = True
        _in_background(lambda: _dash_call("/workspace/client?deviceId=" + WS_DEVICE, timeout=3), _ws_restore_focus)
    return False


# Foco POR DISPOSITIVO: el escritorio recuerda su tab activa sin tocar la
# distribucion compartida ni el foco de otros equipos.
WS_DEVICE = "desktop-" + re.sub(r"[^A-Za-z0-9_.-]", "-", os.uname().nodename or "local")[:60]


def _ws_restore_focus(res):
    """Al arrancar vuelve a la última tab de este equipo. restore_tabs deja
    seleccionada la ÚLTIMA tab restaurada (no local), así que la condición no
    puede mirar la tab actual: solo se respeta una elección real de la persona
    (clic o tecla desde que abrió la app)."""
    status, mine = res
    key = mine.get("activeTabId") if status == 200 else None
    chose = (_PRESENCE.get("last") or 0) > 0
    if key and key in tabs and not chose:
        ws_select(key)
    _WS["focus_saved"] = key
    _WS["focus_ready"] = True


# Presencia del escritorio para la politica compartida de avisos (N2): la
# interaccion solo cuenta con teclas/clics reales en la ventana; el latido
# periodico nunca la marca. El hook de este equipo usa el mismo deviceId.
_PRESENCE = {"last": 0.0, "visible": True}


def report_presence(interaction=False):
    now = time.monotonic()
    if interaction and now - _PRESENCE["last"] < 5:
        return False
    if interaction:
        _PRESENCE["last"] = now
    body = {"deviceId": WS_DEVICE, "kind": "desktop", "visible": _PRESENCE["visible"],
            "canPlayAudio": True, "interaction": bool(interaction)}
    _in_background(lambda: _dash_call("/presence", body, timeout=3), lambda res: None)
    return False


def _presence_window_state(_win, event):
    iconified = bool(event.new_window_state & Gdk.WindowState.ICONIFIED)
    if _PRESENCE["visible"] == (not iconified):
        return False
    _PRESENCE["visible"] = not iconified
    report_presence()
    return False


def _ws_save_focus(*_):
    page = nb.get_nth_page(nb.get_current_page())
    key = getattr(page, "_key", None)
    if not key or not _WS.get("focus_ready") or key == _WS.get("focus_saved"):
        return False   # antes de la respuesta del restore, la tab actual es la de restore_tabs, no la tuya
    _WS["focus_saved"] = key
    _in_background(lambda: _dash_call("/workspace/client", {"deviceId": WS_DEVICE, "activeTabId": key}, timeout=3),
                   lambda res: res[0] == 200 or _WS.update(focus_saved=None))
    return False


def ws_poll_loop():
    while True:
        try:
            with urllib.request.urlopen(BASE_URL + "/workspace", timeout=3) as r:
                state = json.loads(r.read().decode())
            if state.get("revision") != _WS["revision"] and _LAYOUT_RESTORE_READY:
                GLib.idle_add(ws_apply, state)
        except Exception:
            pass
        time.sleep(2)


def tab_reorder(session, index):
    """Mueve la tab (su grupo completo) en la distribución COMPARTIDA; mover
    solo el notebook local se deshacía en el siguiente poll y no llegaba al remoto."""
    doc = _WS.get("doc")
    moved = workspace_layout.move_tab_group(doc, session, int(index)) if doc and session else None
    if moved:
        ws_commit(moved, focus=session)
        return True
    i, page = _page_for(session)
    if page:
        nb.reorder_child(page, int(index))
        save_tabs()
        return True
    return False


def ws_commit(doc, focus=None):
    """POST a new arrangement; the server's answer (or its conflict) wins."""
    _WS["posting"] = True
    _WS["doc"] = doc
    WS_VIEW.apply(doc)
    if focus:
        ws_select(focus)
    payload = {"requestId": secrets.token_hex(12), "expectedRevision": _WS["revision"], "document": doc}

    def work():
        req = urllib.request.Request(BASE_URL + "/workspace", data=json.dumps(payload).encode(),
                                     headers={"Content-Type": "application/json"})
        state, error = None, None
        try:
            with urllib.request.urlopen(req, timeout=5) as r:
                state = json.loads(r.read().decode())
        except urllib.error.HTTPError as e:
            try:
                body = json.loads(e.read().decode())
            except Exception:
                body = {}
            state, error = body.get("current"), body.get("error") or str(e)
        except Exception as e:
            error = str(e)

        def done():
            _WS["posting"] = False
            if state:
                _WS["revision"] = -1          # fuerza aplicar la respuesta
                ws_apply(state)
            if error:
                notify_popup("Distribución" if ES else "Layout",
                             ("Otro dispositivo cambió la distribución; se muestra la actual."
                              if ES else "Another device changed the layout; showing the current one.")
                             if state else error)
            return False
        GLib.idle_add(done)
    threading.Thread(target=work, daemon=True).start()


def _dash_call(path, payload=None, timeout=15):
    """(status, body) from cc-dash; never raises."""
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(BASE_URL + path, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read().decode() or "{}")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read().decode() or "{}")
        except Exception:
            return e.code, {"error": str(e)}
    except Exception as e:
        return 0, {"error": str(e)}


def _in_background(work, done):
    """Run ``work()`` off the UI thread, then ``done(result)`` on it."""
    def run():
        result = work()
        GLib.idle_add(lambda: (done(result), False)[1])
    threading.Thread(target=run, daemon=True).start()


def close_group_guarded(group_id):
    """Confirmar la lista FIJA de pestañas del grupo y cerrar solo esas.

    El servidor revalida revision e identidad de cada sesion; las pestañas
    cerradas llegan por app-tab-close.json, el mismo camino que el remoto.
    """
    title = "Cerrar grupo" if ES else "Close group"

    def confirm(res):
        status, preview = res
        if status != 200:
            notify_popup(title, preview.get("error") or "No se pudo preparar el cierre")
            return
        members = preview.get("members") or []
        closing = [m for m in members if not m.get("kept")]
        lines = "\n".join("• " + str(m.get("label")) + ((" — se queda abierta" if ES else " — stays open") if m.get("kept") else "")
                          for m in members)
        if not closing or not _confirm_must_answer(
                primary=(f"¿Cerrar {len(closing)} pestañas de este grupo?" if ES else f"Close {len(closing)} tabs in this group?"),
                secondary=lines + ("\n\nLas sesiones tmux siguen vivas en Recientes." if ES else "\n\ntmux sessions stay alive in Recents."),
                yes_label=("Cerrar" if ES else "Close"), no_label=("Cancelar" if ES else "Cancel")):
            return
        body = {"requestId": secrets.token_hex(12), "groupId": group_id,
                "expectedRevision": preview.get("revision"), "members": members}
        _in_background(lambda: _dash_call("/workspace/close-group", body), report)

    def report(res):
        status, result = res
        if status != 200:
            notify_popup(title, (result.get("error") or "No se cerró nada") + (" No se cerró nada." if ES else " Nothing was closed."))
        elif not result.get("ok"):
            notify_popup(title, (f"Se cerraron {len(result.get('closed', []))}; quedan: {', '.join(result.get('remaining', []))}. "
                                 if ES else f"Closed {len(result.get('closed', []))}; still open: {', '.join(result.get('remaining', []))}. ")
                         + str(result.get("error") or ""))
    _in_background(lambda: _dash_call("/workspace/close-group?groupId=" + quote(group_id, safe="")), confirm)


def close_split_guarded(sess, pane_id):
    """Cerrar un split por identidad comprobada, con copia previa (igual que el remoto)."""
    title = "Cerrar split" if ES else "Close split"

    def confirm(res):
        status, listing = res
        pane = next((p for p in listing.get("panes") or [] if p.get("id") == pane_id), None) if status == 200 else None
        if not pane:
            notify_popup(title, listing.get("error") or ("El panel ya no existe" if ES else "The pane is gone"))
            return
        if not _confirm_must_answer(
                primary=(f"¿Cerrar el split «{pane.get('title') or pane_id}»?" if ES else f"Close split “{pane.get('title') or pane_id}”?"),
                secondary=("Termina el proceso de ese panel. Se guarda una copia antes; los demás paneles siguen abiertos."
                           if ES else "Ends that pane's process. A copy is saved first; other panes stay open."),
                yes_label=("Cerrar" if ES else "Close"), no_label=("Cancelar" if ES else "Cancel")):
            return
        body = {"session": sess, "action": "close", "pane": pane_id, "identity": pane.get("identity")}
        _in_background(lambda: _dash_call("/terminal-panes", body), report)

    def report(res):
        status, result = res
        if status != 200:
            notify_popup(title, result.get("error") or ("No se cerró" if ES else "Not closed"))
    _in_background(lambda: _dash_call("/terminal-panes", {"session": sess, "action": "list"}), confirm)


def ws_resized(group_id, path, ratio):
    if _WS["doc"] is None:
        return
    try:
        doc = workspace_layout.resize_split(_WS["doc"], group_id, path, ratio)
    except ValueError:
        return
    ws_commit(doc)


WS_VIEW.on_resize = ws_resized


def _ws_member_focused(_page, _key):
    """Clic dentro de otra terminal del grupo: la barra de comandos y el marco
    verde siguen a esa terminal ya, no al miembro elegido antes en la tira."""
    GLib.idle_add(_report_active_tab)
    GLib.timeout_add(800, _ws_save_focus)
    GLib.idle_add(lambda: (_refresh_tab_models(), False)[1])


WS_VIEW.on_focus = _ws_member_focused


# -- arrastre -------------------------------------------------------------
def _ws_source_of(widget, key):
    if key:
        return key
    for page in notebook_pages():
        label = nb.get_tab_label(page)
        if label is not None and (label is widget or widget.is_ancestor(label)):
            if isinstance(page, gtk_workspace.GroupPage):
                return "group:" + page.group_id
            return getattr(page, "_key", None)
    return None


def ws_drag_source(widget, key):
    """Own gesture on the button's implicit grab (no GTK DnD): works on X11,
    Wayland and Broadway alike. Press, move >7 px, release; Escape cancels."""
    widget.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                      | Gdk.EventMask.POINTER_MOTION_MASK)
    widget.connect("button-press-event", lambda w, e: _ws_press(w, e, key))
    widget.connect("motion-notify-event", _ws_pointer_move)
    widget.connect("button-release-event", _ws_release)


def _ws_press(widget, event, key):
    if event.button == 1 and event.type == Gdk.EventType.BUTTON_PRESS and _WS["doc"] is not None:
        # La página ANTES de que el notebook cambie por el clic: si esto acaba en
        # arrastre, esa es la vista donde se quiere soltar (fix 4, grill 30-sep).
        _WS["press"] = {"widget": widget, "key": key, "x": event.x_root, "y": event.y_root,
                        "page": nb.get_current_page()}
    return False   # el notebook sigue cambiando de pestana con el clic


def _ws_layer_point(widget, event):
    pos = widget.translate_coordinates(_ws_layer, int(event.x), int(event.y))
    return pos if pos is not None else _ws_layer_point_root(event.x_root, event.y_root)


def _ws_layer_point_root(x_root, y_root):
    """Punto de pantalla → coordenadas de la capa (sirve aunque el widget de
    origen ya no esté mapeado: la pestaña acoplada cuya página se ocultó)."""
    gdk_win = win.get_window()
    if gdk_win is None:
        return (-1, -1)
    try:
        _ok, wx, wy = gdk_win.get_origin()
    except Exception:
        return (-1, -1)
    off = _ws_layer.translate_coordinates(win, 0, 0) or (0, 0)
    return (x_root - wx - off[0], y_root - wy - off[1])


def _ws_pointer_move(widget, event):
    press = _WS.get("press")
    if not press or press["widget"] is not widget:
        return False
    if _WS["drag"] is None:
        if ((event.x_root - press["x"]) ** 2 + (event.y_root - press["y"]) ** 2) < 49:
            return False
        _ws_drag_begin(_ws_source_of(widget, press["key"]), press.get("page"))
        if _WS["drag"] is None:
            return False
    x, y = _ws_layer_point(widget, event)
    _WS["pointer"] = (x, y)
    _WS["target"] = _ws_target(x, y)
    _ws_layer.queue_draw()
    return True


def _ws_release(widget, event):
    press, _WS["press"] = _WS.get("press"), None
    if _WS["drag"] is None or not press or press["widget"] is not widget:
        return False
    x, y = _ws_layer_point(widget, event)
    _ws_finish(_ws_target(x, y))
    return True


def _ws_window_motion(widget, event):
    """Con el agarre en la ventana, el movimiento llega aquí aunque el widget
    presionado se haya ocultado (cambio de página al posar o auto-desplazar)."""
    if _WS["drag"] is None:
        return False
    x, y = _ws_layer_point_root(event.x_root, event.y_root)
    _WS["pointer"] = (x, y)
    _WS["target"] = _ws_target(x, y)
    _ws_layer.queue_draw()
    return True


def _ws_window_release(widget, event):
    if _WS["drag"] is None or event.button != 1:
        return False
    _WS["press"] = None
    x, y = _ws_layer_point_root(event.x_root, event.y_root)
    _ws_finish(_ws_target(x, y))
    return True


def _ws_grab(on):
    """Agarre del puntero en la ventana durante el arrastre: los eventos no
    dependen del widget de origen (fix 4, 30-sep)."""
    try:
        seat = Gdk.Display.get_default().get_default_seat()
        if on:
            seat.grab(win.get_window(), Gdk.SeatCapabilities.POINTER, False, None, None, None, None)
        else:
            seat.ungrab()
    except Exception:
        pass


def _ws_button_still_down():
    try:
        seat = Gdk.Display.get_default().get_default_seat()
        _w, _x, _y, mask = win.get_window().get_device_position(seat.get_pointer())
        return bool(mask & Gdk.ModifierType.BUTTON1_MASK)
    except Exception:
        return True


def ws_cancel_drag():
    if _WS["drag"] is None:
        return False
    _WS["press"] = None
    _ws_drag_end()
    return True


def _ws_moved_ids(source):
    doc = _WS["doc"] or {}
    if source and source.startswith("group:"):
        group = next((g for g in doc.get("groups", []) if g["id"] == source[6:]), None)
        return gtk_workspace.tab_ids(group["tree"]) if group else []
    return [source] if source else []


def ws_strip_edge_step(x, width, zone=56):
    """-1/0/1: arrastrando cerca del borde de la barra, las pestañas corren (paridad con remoto)."""
    if x < zone:
        return -1
    if x > width - zone:
        return 1
    return 0


def _ws_edge_tick():
    """Mientras se arrastra en la franja de pestañas cerca de un borde, avanza una
    pestaña cada tick; GtkNotebook solo desplaza sus tabs cambiando de página."""
    if _WS["drag"] is None:
        _WS["edge_timer"] = None
        return False
    if not _ws_button_still_down():
        # El release se perdió (widget de origen desmontado, grab roto): cerrar
        # el arrastre donde está el puntero en vez de dejarlo pegado.
        x, y = _WS.get("pointer") or (-1, -1)
        _WS["press"] = None
        _ws_finish(_ws_target(x, y))
        _WS["edge_timer"] = None
        return False
    x, y = _WS.get("pointer") or (-1, -1)
    layout = _ws_layout()
    strip_h = layout["strip"][3]
    step = ws_strip_edge_step(x, _ws_layer.get_allocated_width()) if 0 <= y <= strip_h + 12 else 0
    if step:
        if hasattr(nb, "scroll_by"):
            nb.scroll_by(step * 120)
        else:
            (nb.prev_page if step < 0 else nb.next_page)()
        _WS["target"] = _ws_target(x, y)
        _ws_layer.queue_draw()
        return True
    # Posar el puntero ~½ s sobre otra pestaña la muestra: así se puede soltar
    # la arrastrada dentro de CUALQUIER tab (agrupar), no solo en la que veías.
    over = next((page for page, (ex, ey, ew, eh) in layout["entries"]
                 if ex <= x <= ex + ew and ey <= y <= ey + eh), None) if 0 <= y <= strip_h else None
    if over is not None and over is not _ws_source_page(_WS["drag"]) and over is not nb.get_nth_page(nb.get_current_page()):
        if _WS.get("dwell") is over:
            nb.set_current_page(nb.page_num(over))
            _WS["dwell"] = None
            _WS["target"] = _ws_target(x, y)
            _ws_layer.queue_draw()
        else:
            _WS["dwell"] = over
    else:
        _WS["dwell"] = None
    return True


def _ws_source_page(source):
    """Página del notebook de la pestaña/grupo que se arrastra."""
    for page in notebook_pages():
        if isinstance(page, gtk_workspace.GroupPage):
            if source == "group:" + page.group_id:
                return page
        elif getattr(page, "_key", None) == source:
            return page
    return None


def _ws_drag_begin(source, press_page=None):
    if _WS["doc"] is None or not source:
        return
    _WS["drag"] = source
    _WS["target"] = None
    _WS["dwell"] = None
    # Volver a la vista que tenías al presionar: el clic ya había cambiado a la
    # pestaña arrastrada y soltarla sobre su propia área no acomoda nada.
    if press_page is not None and 0 <= press_page < nb.get_n_pages() and press_page != nb.get_current_page():
        nb.set_current_page(press_page)
    _WS["drag_page"] = nb.get_current_page()
    page = _ws_source_page(source)
    label = nb.get_tab_label(page) if page is not None else None
    _WS["source_label"] = label           # la capa la tapa: en la barra queda solo su sombra
    if not _WS.get("edge_timer"):
        _WS["edge_timer"] = GLib.timeout_add(260, _ws_edge_tick)
    _ws_layer.show()
    _ws_grab(True)


def _ws_drag_end():
    _ws_grab(False)
    _WS["source_label"] = None
    _WS["drag"] = None
    _WS["target"] = None
    _WS["trays"] = None
    _WS["dwell"] = None
    _ws_layer.hide()


def _ws_rect(widget):
    alloc = widget.get_allocation()
    pos = widget.translate_coordinates(_ws_layer, 0, 0)
    if pos is None:
        return None
    return (pos[0], pos[1], alloc.width, alloc.height)


def _ws_layout():
    entries, bottoms = [], []
    for page in notebook_pages():
        label = nb.get_tab_label(page)
        rect = _ws_rect(label) if label is not None and label.get_mapped() else None
        if rect:
            entries.append((page, rect))
            bottoms.append(rect[1] + rect[3])
    width = _ws_layer.get_allocated_width()
    strip_h = (max(bottoms) + 6) if bottoms else 0
    page = nb.get_nth_page(nb.get_current_page())
    area = _ws_rect(page) if page is not None else None
    leaves, active, active_tabs = {}, None, []
    if isinstance(page, gtk_workspace.GroupPage):
        active = page.group_id
        active_tabs = list(page.members)
        for key, leaf in page.leaves.items():
            rect = _ws_rect(leaf)
            if rect:
                leaves[key] = rect
    elif page is not None and area:
        key = getattr(page, "_key", None)
        group = next((g for g in (_WS["doc"] or {}).get("groups", [])
                      if key in gtk_workspace.tab_ids(g["tree"])), None)
        if group:
            active, active_tabs = group["id"], gtk_workspace.tab_ids(group["tree"])
            leaves[key] = area
    return {"strip": (0, 0, width, strip_h), "entries": entries, "area": area or (0, strip_h, width, 1),
            "leaves": leaves, "active": active, "activeTabs": active_tabs}


WS_TRAYS = (("frozen", "Aparcar"), ("awaiting_reply", "Esperando"), ("resolved", "Hecho"), ("none", "Quitar"))


def ws_tray_rects(width, height, w=112, h=70, gap=12, bottom=80):
    """Bandejas de estado (grill 30-sep): fila centrada cerca del fondo del área."""
    total = len(WS_TRAYS) * w + (len(WS_TRAYS) - 1) * gap if "WS_TRAYS" in globals() else 4 * w + 3 * gap
    x0, y = max(0, (width - total) / 2), max(0, height - bottom - h)
    marks = [m for m, _l in WS_TRAYS] if "WS_TRAYS" in globals() else ["frozen", "awaiting_reply", "resolved", "none"]
    return [(m, (x0 + i * (w + gap), y, w, h)) for i, m in enumerate(marks)]


def ws_tray_at(rects, x, y, strip_bottom):
    if y < strip_bottom + 30:
        return None
    return next((m for m, (rx, ry, rw, rh) in rects if rx - 8 <= x <= rx + rw + 8 and ry - 8 <= y <= ry + rh + 8), None)


def _ws_target(x, y):
    layout = _ws_layout()
    source = _WS["drag"]
    _WS["trays"] = None
    if source and not source.startswith("group:") and source != "local":
        strip_bottom = layout["strip"][3]
        if y >= strip_bottom + 30:          # hacia abajo: bandejas de estado
            rects = ws_tray_rects(_ws_layer.get_allocated_width(), _ws_layer.get_allocated_height())
            _WS["trays"] = rects
            mark = ws_tray_at(rects, x, y, strip_bottom)
            if mark:
                return {"kind": "mark", "mark": mark, "rect": dict(rects)[mark]}
    raw = layout["entries"]
    layout["entries"] = [(None, r) for _p, r in raw]
    target = gtk_workspace.dock_target(layout, x, y, _ws_moved_ids(_WS["drag"]))
    if target and target["kind"] == "bar":
        # Posicion en el documento: antes del grupo de la pagina en ese lugar.
        pages = [p for p, _r in raw]
        idx = target["index"]
        target["docIndex"] = _ws_doc_index(pages[idx] if idx < len(pages) else None)
        rx = raw[idx][1][0] if idx < len(raw) else (raw[-1][1][0] + raw[-1][1][2] if raw else 0)
        src = _WS.get("source_label")
        sw = src.get_allocation().width if src is not None else 0
        sw = sw if sw > 12 else 96
        target["rect"] = (rx - sw / 2, 2, sw, max(8, layout["strip"][3] - 8))
        target["slot"] = True
    return target


def _ws_doc_index(page):
    groups = (_WS["doc"] or {}).get("groups", [])
    if page is None:
        return len(groups)
    if isinstance(page, gtk_workspace.GroupPage):
        gid = page.group_id
    else:
        key = getattr(page, "_key", None)
        gid = next((g["id"] for g in groups if key in gtk_workspace.tab_ids(g["tree"])), None)
    return next((i for i, g in enumerate(groups) if g["id"] == gid), len(groups))


def _ws_finish(target):
    source = _WS["drag"]
    start_page = _WS.get("drag_page")
    _ws_drag_end()
    if not target or target.get("kind") == "mark":
        # sin mover pestañas: vuelve a la que tenías si el borde hizo correr la barra
        if start_page is not None and start_page != nb.get_current_page():
            nb.set_current_page(start_page)
    if not target or not source or _WS["doc"] is None:
        return
    if target["kind"] == "mark":             # soltada en una bandeja: tu marca
        set_work_mark("session", source, target["mark"])
        return
    try:
        if target["kind"] == "bar":
            doc = workspace_layout.detach_tab(_WS["doc"], source, target["docIndex"])
        else:
            doc = workspace_layout.move_tab(_WS["doc"], source, target["target"], target["edge"])
    except ValueError:
        return   # soltar sobre si mismo o sin cambio: nada que guardar
    ws_commit(doc, None if source.startswith("group:") else source)


def _ws_draw_trays(cr, target):
    hot = target.get("mark") if target and target.get("kind") == "mark" else None
    colors = {"frozen": (0.38, 0.65, 0.98), "awaiting_reply": (0.96, 0.72, 0.24),
              "resolved": (0.29, 0.87, 0.5), "none": (0.97, 0.44, 0.44)}
    labels = dict(WS_TRAYS)
    for mark, (x, y, w, h) in _WS.get("trays") or []:
        r, g, b = colors[mark]
        cr.set_source_rgba(0.06, 0.09, 0.13, 0.94)
        cr.rectangle(x, y, w, h)
        cr.fill()
        cr.set_source_rgba(r, g, b, 1.0 if mark == hot else 0.55)
        cr.set_line_width(3 if mark == hot else 2)
        cr.set_dash([] if mark == hot else [6, 4])
        cr.rectangle(x, y, w, h)
        cr.stroke()
        cr.set_dash([])
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(13)
        text = labels[mark]
        ext = cr.text_extents(text)
        cr.set_source_rgba(0.9, 0.93, 0.96, 1.0 if mark == hot else 0.75)
        cr.move_to(x + (w - ext.width) / 2, y + h / 2 + ext.height / 2)
        cr.show_text(text)


def _ws_rounded(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -1.5708, 0)
    cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
    cr.arc(x + r, y + h - r, r, 1.5708, 3.1416)
    cr.arc(x + r, y + r, r, 3.1416, 4.7124)
    cr.close_path()


def _ws_draw_ghost(cr):
    """Fantasma (grill 30-sep, variante C): copia de la pestaña arrastrada, un
    poco girada y con sombra, siguiendo al puntero."""
    label, pointer = _WS.get("source_label"), _WS.get("pointer")
    if not pointer:
        return
    if label is None:
        # Pestaña acoplada (sin etiqueta en la barra): fantasma con su nombre.
        source = _WS["drag"] or ""
        box = tabs.get(source) if isinstance(tabs, dict) else None
        text = getattr(box, "_label", None) or source.replace("group:", "") or "…"
        cr.save()
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(12)
        ext = cr.text_extents(text)
        w, h = ext.width + 4, 18
        px, py = pointer
        cr.translate(px, py)
        cr.rotate(-0.045)
        cr.translate(-w / 2, -h / 2)
        bar = Gdk.RGBA(); bar.parse(THEME.get("bar") or "#161B22")
        brand = Gdk.RGBA(); brand.parse(THEME.get("brand") or "#8B7CF6")
        cr.set_source_rgba(0, 0, 0, 0.35)
        _ws_rounded(cr, 2, 5, w + 16, h + 8, 9)
        cr.fill()
        cr.set_source_rgba(bar.red, bar.green, bar.blue, 0.97)
        _ws_rounded(cr, 0, 0, w + 16, h + 8, 9)
        cr.fill_preserve()
        cr.set_source_rgba(brand.red, brand.green, brand.blue, 0.9)
        cr.set_line_width(1.5)
        cr.stroke()
        cr.set_source_rgba(0.92, 0.94, 0.98, 1)
        cr.move_to(8 - ext.x_bearing, 4 + h / 2 + ext.height / 2 - 1)
        cr.show_text(text)
        cr.restore()
        return
    alloc = label.get_allocation()
    w, h = max(24, alloc.width), max(16, alloc.height)
    px, py = pointer
    cr.save()
    cr.translate(px, py)
    cr.rotate(-0.045)
    cr.translate(-w / 2, -h / 2)
    cr.set_source_rgba(0, 0, 0, 0.35)                      # sombra
    _ws_rounded(cr, 2, 5, w + 10, h + 6, 9)
    cr.fill()
    bar = Gdk.RGBA(); bar.parse(THEME.get("bar") or "#161B22")
    brand = Gdk.RGBA(); brand.parse(THEME.get("brand") or "#8B7CF6")
    cr.set_source_rgba(bar.red, bar.green, bar.blue, 0.97)
    _ws_rounded(cr, 0, 0, w + 10, h + 6, 9)
    cr.fill_preserve()
    cr.set_source_rgba(brand.red, brand.green, brand.blue, 0.9)
    cr.set_line_width(1.5)
    cr.stroke()
    cr.translate(5, 3)
    cr.push_group()
    try:
        label.draw(cr)
    except Exception:
        pass
    cr.pop_group_to_source()
    cr.paint_with_alpha(0.95)
    cr.restore()


def _ws_draw_lifted(cr):
    """La pestaña arrastrada se «levanta» de la barra: la capa la cubre con el
    color de la barra y deja una sombra tenue donde estaba."""
    label = _WS.get("source_label")
    rect = _ws_rect(label) if label is not None else None
    if not rect:
        return
    x, y, w, h = rect
    bar = Gdk.RGBA(); bar.parse(THEME.get("bar") or "#161B22")
    cr.set_source_rgba(bar.red, bar.green, bar.blue, 0.86)
    cr.rectangle(x - 1, y - 1, w + 2, h + 2)
    cr.fill()
    cr.set_source_rgba(0, 0, 0, 0.18)
    _ws_rounded(cr, x + 4, y + 4, max(0, w - 8), max(0, h - 8), 7)
    cr.fill()


def _ws_draw(widget, cr):
    target = _WS["target"]
    if _WS["drag"] is not None:
        _ws_draw_lifted(cr)
    if _WS.get("trays"):
        _ws_draw_trays(cr, target)
    if target and target.get("kind") != "mark":
        x, y, w, h = target["rect"]
        brand = Gdk.RGBA()
        brand.parse(THEME.get("brand") or "#8B7CF6")
        if target.get("slot"):                              # ranura punteada donde caerá
            cr.set_source_rgba(brand.red, brand.green, brand.blue, 0.14)
            _ws_rounded(cr, x, y, w, h, 8)
            cr.fill_preserve()
            cr.set_source_rgba(brand.red, brand.green, brand.blue, 0.9)
            cr.set_line_width(2)
            cr.set_dash([5, 4])
            cr.stroke()
            cr.set_dash([])
        else:                                                # mitad del área donde se acopla
            cr.set_source_rgba(brand.red, brand.green, brand.blue, 0.18)
            cr.rectangle(x, y, w, h)
            cr.fill_preserve()
            cr.set_source_rgba(brand.red, brand.green, brand.blue, 0.95)
            cr.set_line_width(2)
            cr.stroke()
    if _WS["drag"] is not None:
        _ws_draw_ghost(cr)
    return False


_ws_overlay = Gtk.Overlay()
_ws_column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)   # barra de pestañas + páginas
_ws_column.pack_start(nb.row, False, False, 0)
_ws_column.pack_start(nb, True, True, 0)
_ws_column.show()
_ws_overlay.add(_ws_column)
_ws_layer = Gtk.DrawingArea()
_ws_layer.set_no_show_all(True)
_ws_layer.connect("draw", _ws_draw)
_ws_overlay.add_overlay(_ws_layer)
_ws_overlay.set_overlay_pass_through(_ws_layer, True)   # solo pinta la vista previa
hub._label = "⌂ local"
ws_drag_source(nb.get_tab_label(hub)._text_box, None)
threading.Thread(target=ws_poll_loop, daemon=True).start()


def tmux_clipboard_loop():
    """Toda copia hecha dentro de tmux (arrastre, doble clic, o una TUI que copia
    con OSC 52, que VTE ignora) llega al portapapeles del sistema. Ver
    lib/tmux_clipboard.py: solo buffers automáticos `bufferN`, nunca los internos."""
    bridge = tmux_clipboard.Bridge()
    while True:
        try:
            r = tmuxc("list-buffers", "-F", tmux_clipboard.LIST_FORMAT)
            name = bridge.poll(r.stdout if r.returncode == 0 else "")
            if name:
                shown = tmuxc("show-buffer", "-b", name)
                if shown.returncode == 0 and shown.stdout:
                    GLib.idle_add(lambda t=shown.stdout: (copy_text_to_clipboard(t), False)[1])
        except Exception:
            pass
        time.sleep(0.35)


threading.Thread(target=tmux_clipboard_loop, daemon=True).start()

# La pestana ACTIVA de la app: el tablero la usa para que el Centro de Control sea siempre
# el operador de la sesion en la que estas parado.
ACTIVE_TAB_FILE = os.path.expanduser("~/.claude/hooks/app-tab-active.json")
APP_TAB_MODELS_FILE = os.path.expanduser("~/.claude/hooks/app-tab-models.json")


def _report_active_tab(*_):
    page = nb.get_nth_page(nb.get_current_page()) if nb.get_n_pages() else None
    key = getattr(page, "_key", None)
    if not isinstance(key, str):
        return
    try:
        tmp = ACTIVE_TAB_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"session": key.partition(":")[0], "ts": time.time()}, f)
        os.replace(tmp, ACTIVE_TAB_FILE)
    except Exception:
        pass


# ---- Pildoras de modelo POR PANE: ancladas a la linea de titulo de cada
# pane tmux (geometria real de list-panes), con boton de motor. El usuario
# marco ese renglon exacto como el lugar de la info y las acciones.
_PV_HEX = {"claude": "#A78BFA", "codex": "#2DD4BF", "grok": "#FB923C",
           "opencode": "#F0ABFC", "gemini": "#93C5FD", "acp": "#67E8F9",
           "agy": "#93C5FD"}
_STATE_UI = {
    "verified":  ("#4ADE80", "✓"),
    "changing":  ("#FBBF24", "⟳"),
    "detecting": ("#9CA3AF", "◌"),
}


def _dash_js(code):
    try:
        try:
            if _SIDE.get("leftHidden"):         # oculto: se muestra a TU ancho, sin ensancharlo
                _left_panel_set(False)
        except Exception:
            pass
        wv.run_javascript(
            f"try{{{code}}}catch(e){{console.error('dash_js: '+(e&&e.stack||e))}}", None, None, None)
    except Exception as e:
        print(f"_dash_js fallo: {e}")


def open_ai_session_here(sess, pane):
    """Click derecho en una terminal NORMAL: mismo wizard que el +, pero
    arranca el CLI en ESTE pane (no crea otra pestaña)."""
    cwd = ""
    if pane and not sess:
        # el tty del cliente no siempre esta registrado (pestanas restauradas):
        # el pane si sabe a que sesion pertenece
        r = tmuxc("display-message", "-p", "-t", pane, "#{session_name}")
        sess = (r.stdout or "").strip() or sess
    target = pane or (("=" + sess + ":") if sess else "")
    if target:
        r = tmuxc("display-message", "-p", "-t", target, "#{pane_current_path}")
        cwd = (r.stdout or "").strip()
    if not sess:
        print("open_ai_session_here: sin sesion tmux (pane=%r)" % (pane,))
        notify_popup("Sin sesión tmux" if ES else "No tmux session",
                     "No pude ver en qué terminal estás" if ES else "Could not see this terminal")
        return
    _dash_js(
        f"nsOpenForPane({json.dumps(sess)},{json.dumps(pane or '')},{json.dumps(cwd)})"
    )


def _esc(t):
    return GLib.markup_escape_text(str(t or ""))


_PV_ICON = {"claude": "anthropic", "codex": "openai", "grok": "grok",
            "acp": "layers", "opencode": "layers", "agy": "gemini"}


def _svg_image(name, size, color):
    """Logo SVG tintado con un color puntual (no el dim del tema)."""
    svg_path = os.path.join(_ICONS_DIR, f"{name}.svg")
    try:
        with open(svg_path, "rb") as f:
            data = f.read().replace(b"currentColor", color.encode())
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        loader.set_size(size, size)
        loader.write(data); loader.close()
        return Gtk.Image.new_from_pixbuf(loader.get_pixbuf())
    except Exception:
        return Gtk.Label(label="⬤")


def _attach_model_bar(box, sess):
    """Envuelve la VTE en un Gtk.Overlay para flotar pildoras sobre la linea
    de titulo de cada pane. No cambia el layout term+scrollbar (aprendido:
    meter una barra al box horizontal recortaba la terminal)."""
    term = getattr(box, "_term", None)
    if term is None:
        return
    ov = Gtk.Overlay()
    pos = 0
    for i, ch in enumerate(box.get_children()):
        if ch is term:
            pos = i
            break
    box.remove(term)
    ov.add(term)
    box.pack_start(ov, True, True, 0)
    box.reorder_child(ov, pos)
    box._pill_overlay = ov
    # Sin capa de marcos encima de la VTE: un DrawingArea tiene ventana propia y
    # se comía el scroll y el teclado de los panes (regresión 30-sep). El marco
    # se pinta en la propia VTE (draw después del contenido), que no toca la entrada.
    box._frames = []
    ov.connect_after("draw", lambda w, cr, b=box: _draw_pane_frames(b, cr))
    box._drag = None
    # Canales entre panes: franjas de entrada propias (_sync_grips) con su cursor;
    # la VTE ya no los ve, así no hay pelea de cursores ni arrastres de tmux.
    term.connect("button-press-event", lambda w, e, b=box: _term_click(b, e))
    term.connect("key-press-event", lambda w, e, b=box: _prefix_watch(b, e))
    term.connect("button-release-event", lambda w, e, b=box: (_pane_geo_soon(b), False)[1])
    term.connect("size-allocate", lambda w, a, b=box: _pane_geo_soon(b))
    box._pill_sess = sess
    box._pill_sig = ""
    box._pills = []
    box.show_all()


def _pane_geometry(sess):
    try:
        out = subprocess.run(
            ["tmux", "list-panes", "-t", f"={sess}", "-F",
             "#{pane_id} #{pane_left} #{pane_top} #{pane_width} #{pane_current_command} #{pane_height} #{pane_active}"],
            capture_output=True, text=True, timeout=2).stdout
    except Exception:
        return {}
    geo = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[0].startswith("%"):
            geo[parts[0]] = (int(parts[1]), int(parts[2]), int(parts[3]))
            _PANE_CMD[parts[0]] = parts[4] if len(parts) > 4 else ""
            if len(parts) >= 7:
                _PANE_BOX[parts[0]] = (int(parts[5]), parts[6] == "1")
    return geo


_PANE_CMD = {}          # pane_id -> comando vivo (zsh/bash/claude/…) del ultimo _pane_geometry
_PANE_BOX = {}          # pane_id -> (alto en filas, activo) para el marco del pane (prototipo)
_SHELLS = {"zsh", "bash", "sh", "fish", "dash", "ksh", "tcsh", "csh", "nu"}


def _shell_pill(sess, pane_id):
    """Pildora para un pane SIN agente: un solo boton grande 'Iniciar IA aqui'.
    Antes esos panes no tenian pildora y la unica via era el click derecho,
    que nadie descubre."""
    pill = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    pill.get_style_context().add_class("pane-pill")
    pill.get_style_context().add_class("pp-shell")
    pill.set_valign(Gtk.Align.START)
    b = Gtk.Button()
    hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    hb.pack_start(_svg_image("layers", 13, THEME.get("brand", "#8B7CFF")), False, False, 0)
    lab = Gtk.Label()
    lab.set_markup(f'<span foreground="{THEME.get("fg", "#ECECEC")}" weight="bold">'
                   f'{_esc("Iniciar IA aquí" if ES else "Start AI here")}</span>')
    hb.pack_start(lab, False, False, 0)
    b.add(hb)
    b.set_relief(Gtk.ReliefStyle.NONE)
    b.get_style_context().add_class("pill-btn")
    b.set_tooltip_text("Elige CLI, motor y cuenta: arranca en ESTA terminal (Ctrl+Shift+A)" if ES
                       else "Pick CLI, engine and account: starts in THIS terminal (Ctrl+Shift+A)")
    b.connect("clicked", lambda *_, s=sess, pn=pane_id: open_ai_session_here(s, pn))
    pill.pack_start(b, False, False, 0)
    pill.pack_start(_extension_pill(sess, pane_id), False, False, 0)
    return pill


def _card_button(icon, text, tooltip, on_click):
    """Botón de la tarjeta: icono + texto corto; toma el estilo 3D de Ajustes."""
    button = Gtk.Button()
    hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
    hb.pack_start(_svg_image(icon, 12, THEME.get("fg", "#ECECEC")), False, False, 0)
    hb.pack_start(Gtk.Label(label=text), False, False, 0)
    button.add(hb)
    button.set_relief(Gtk.ReliefStyle.NONE)
    button.get_style_context().add_class("pill-btn")
    button.set_tooltip_text(tooltip)
    button.connect("clicked", on_click)
    return button


_BADGE_CSS = {}


# Logo del motor = prototipo de la cabecera B y dash/term.html (LOGO): letra blanca
# sobre el color de la marca. Antes el escritorio usaba _PV_HEX (Claude lila) con un
# icono SVG y no coincidía con el remoto ni con el prototipo («A» naranja).
MOTOR_LOGO = {"claude": ("A", "#d97757"), "codex": ("O", "#10a37f"), "grok": ("G", "#fb923c"),
              "opencode": ("OC", "#f0abfc"), "gemini": ("G", "#4285f4"), "agy": ("AG", "#93c5fd"),
              "acp": ("AC", "#67e8f9")}


def _motor_badge(motor):
    """Cuadrito de color del motor con su letra en blanco (prototipo: «A» naranja)."""
    letter, color = MOTOR_LOGO.get(motor, ((motor or "?")[:2].upper(), "#56627a"))
    badge = Gtk.EventBox()
    badge.get_style_context().add_class("pp-logo")
    if motor not in _BADGE_CSS:
        prov = Gtk.CssProvider()
        prov.load_from_data(f".pp-logo.pp-logo-{motor}{{background-color:{color};}}".encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        _BADGE_CSS[motor] = prov
    badge.get_style_context().add_class(f"pp-logo-{motor}")
    glyph = Gtk.Label(label=letter)
    glyph.get_style_context().add_class("pp-logo-glyph")
    glyph.set_halign(Gtk.Align.CENTER)
    glyph.set_valign(Gtk.Align.CENTER)
    badge.add(glyph)
    badge.set_valign(Gtk.Align.CENTER)
    return badge


def _pane_card_ai(sess):
    """Punto de estado de la IA de esta sesión dentro de la tarjeta (el mismo que la pestaña)."""
    icon, _, animated = tab_indicator_display(work_mark_row("session", sess)["mark"], STATE_CACHE.get(sess, ""))
    image = Gtk.Image()
    image._ind, image._frame, image._px = (icon, None), 0, work_mark_state.AI_DOT_PX
    try:
        _set_indicator_frame(image, icon, None, 0)
    except Exception:
        return None
    image.set_tooltip_text("IA: " + work_mark_state.AI_LABELS[icon[3:]][0 if ES else 1])
    image._ai_icon = icon
    return image


def _pane_pill(sess, p, keys=True):
    """Tarjeta del pane (grill 30-sep, igual que el remoto): semáforo + sesión |
    logo + modelo + ✓ | «IA» y «MCPs · Skills». Sin texto redundante: el logo
    ES la identidad; el tooltip carga el detalle (harness→motor, cuentas, pane)."""
    harness, motor = p.get("harness") or "?", p.get("motor") or "?"
    state = p.get("state") or "detecting"
    scol, sglyph = _STATE_UI.get(state, _STATE_UI["detecting"])
    fg = THEME.get("fg", "#ECECEC")
    dim = "#8A8F98"
    pill = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    pill.get_style_context().add_class("pane-pill")
    pill.get_style_context().add_class("pane-card")
    pill.get_style_context().add_class(f"pp-{motor if motor in _PV_HEX else 'x'}")
    pill.set_valign(Gtk.Align.START)
    ai = _pane_card_ai(sess) if sess and sess != "local" else None
    if ai is not None:
        pill.pack_start(ai, False, False, 0)
        pill._ai = ai
    name = Gtk.Label()
    box = tabs.get(sess) if isinstance(tabs, dict) else None
    title = getattr(box, "_label", None) or sess          # el nombre de la pestaña, no la clave tmux
    name.set_markup(f'<span foreground="{fg}" weight="bold">{_esc(title)}</span>')
    name.set_ellipsize(Pango.EllipsizeMode.END)
    name.set_max_width_chars(18)
    pill.pack_start(name, False, False, 0)
    sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
    sep.set_valign(Gtk.Align.CENTER)            # 1×14 px como .pc-sep del remoto y el prototipo B
    pill.pack_start(sep, False, False, 0)
    if motor != harness and harness in _PV_ICON:
        pill.pack_start(_svg_image(_PV_ICON[harness], 12, dim), False, False, 0)
    pill.pack_start(_motor_badge(motor), False, False, 0)
    lab = Gtk.Label()
    if state == "changing":
        lab.set_markup(f'<span foreground="{fg}" weight="bold">{_esc("→ " + (p.get("target") or "…"))}</span>')
    elif state == "verified":
        lab.set_markup(f'<span foreground="{fg}" weight="bold" font_family="Ubuntu Sans Mono">{_esc(p.get("model"))}</span>'
                       + (f'<span foreground="{dim}"> {_esc(p.get("effort"))}</span>' if p.get("effort") else ""))
    else:
        lab.set_markup(f'<span foreground="{dim}">…</span>')
    pill.pack_start(lab, False, False, 0)
    # UNICO acento de color en la tarjeta además del semáforo: el estado del
    # motor. Verde=confia, ambar=espera, gris=aun no se sabe.
    st = Gtk.Label()
    st.set_markup(f'<span foreground="{scol}" weight="bold">{sglyph}</span>')
    pill.pack_start(st, False, False, 0)
    accts = ""
    ha, ma = p.get("hAcct") or "", p.get("mAcct") or ""
    if ha and ha != "unknown":
        accts = ha + ("" if not ma or ma in ("unknown", ha) else "→" + ma)
    pill.set_tooltip_text(f"{harness} → {motor} · {p.get('model') or '?'}"
                          + (f" · {p.get('effort')}" if p.get("effort") else "")
                          + (f" · {p.get('tierSym')}" if p.get("tierSym") else "")
                          + (f" · cuenta {accts}" if accts else "")
                          + (f" · pane {p.get('pane')}" if p.get("pane") else "")
                          + {"verified": " · verificado en el proceso vivo",
                             "changing": " · cambio de motor en curso",
                             "detecting": " · detectando, aun sin confirmar"}.get(state, ""))
    if keys:
        for key in reversed(_pane_card_keys(sess, p, harness)):
            pill.pack_end(key, False, False, 0)
    return pill


def _pane_card_keys(sess, p, harness):
    """«Cuenta: alias» y «✨ MCPs · Skills» de la Tarjeta."""
    pane = p.get("pane") or ""
    keys = []
    if harness in ("claude", "codex", "grok"):       # CLIs con cuentas propias
        alias = p.get("hAcct") or ""
        alias = alias if alias and alias != "unknown" else "…"
        keys.append(_card_button("user", f"Cuenta: {alias}" if ES else f"Account: {alias}",
                                 "Pasar este pane a otra cuenta sin perder la conversación" if ES
                                 else "Move this pane to another account, same conversation",
                                 lambda b, s=sess, pn=pane, h=harness, a=alias: _account_popover(b, s, pn, h, a)))
    return keys + [_extension_pill(sess, pane, harness)]


def _account_bar_class(percent):
    return "full" if percent >= 95 else "warn" if percent >= 85 else ""


_ACCT_STAGES = {"validating": "Validando…", "waiting": "Interrumpiendo lo que está haciendo…",
                "snapshot": "Guardando la conversación…", "applying": "Abriendo la conversación en la otra cuenta…",
                "verifying": "Confirmando que siguió igual…", "recovering": "Recuperando la conversación original…"}
_ACCT_FINAL = ("confirmed", "failed", "rolled_back", "recovery_required")


def _acct_awaiting(alias):
    return (f"La conversación ya corre en {alias}, pero el pane pide algo (confianza de carpeta, login o esfuerzo): "
            "respóndelo en su terminal y el cambio se confirma solo." if ES else
            f"The conversation already runs on {alias}, but the pane asks something (folder trust, login or effort): "
            "answer it in its terminal and the switch confirms itself.")


def _wait_account_switch(key, operation_id, alias, on_stage, attempts=120):
    """Sigue /model/status hasta el resultado real del cambio de cuenta (2-oct: la UI
    no puede decir «en cola» y cerrarse; dice qué pasó). awaiting_confirmation = el
    destino ya corre pero muestra un diálogo: se explica, no se da por hecho."""
    params = urlencode({"operationKey": key or "", "operationId": operation_id or ""})
    awaiting = False
    for _ in range(attempts):
        time.sleep(1.5)
        try:
            with urllib.request.urlopen(BASE_URL + "/model/status?" + params, timeout=8) as r:
                status = json.loads(r.read().decode())
        except Exception:
            continue                      # un fallo de red no decide el resultado
        if status.get("state") in _ACCT_FINAL:
            return status
        awaiting = status.get("state") == "awaiting_confirmation"
        on_stage(_acct_awaiting(alias) if awaiting else
                 (_ACCT_STAGES.get(status.get("stageCode") or status.get("state")) or status.get("stage") or ""))
    if awaiting:
        return {"ok": False, "awaiting": True, "detail": _acct_awaiting(alias)}
    return {"ok": False, "detail": "Sin confirmación en 3 minutos; revisa la terminal del pane." if ES
            else "No confirmation in 3 minutes; check the pane's terminal."}


def _account_popover(button, sess, pane, harness, current):
    """Menú «Cuenta» (grill 2-oct): cada cuenta con 5 h, semana y semana por modelo;
    elegir otra pasa ESTE pane a esa cuenta con la misma conversación (/account/switch),
    interrumpiendo lo que esté haciendo, y muestra el resultado real de la operación."""
    pop = Gtk.Popover.new(button)
    pop.set_position(Gtk.PositionType.BOTTOM)
    pop.get_style_context().add_class("acct-pop")
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    outer.set_margin_start(8); outer.set_margin_end(8); outer.set_margin_top(8); outer.set_margin_bottom(8)
    title = Gtk.Label(label="CUENTA DE ESTE PANE" if ES else "THIS PANE'S ACCOUNT", xalign=0)
    title.get_style_context().add_class("acct-title")
    outer.pack_start(title, False, False, 0)
    rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    outer.pack_start(rows, False, False, 0)
    add = Gtk.Button(label="+ Añadir cuenta" if ES else "+ Add account")
    outer.pack_start(add, False, False, 0)
    note = Gtk.Label(label="Consultando cuentas…" if ES else "Loading accounts…", xalign=0)
    note.set_line_wrap(True); note.set_max_width_chars(38)
    note.get_style_context().add_class("acct-note")
    outer.pack_start(note, False, False, 0)
    pop.add(outer)
    outer.set_size_request(300, -1)
    pop.show_all()

    def login(alias=""):
        add.set_sensitive(False)
        for child in rows.get_children():
            child.set_sensitive(False)
        note.set_text("Abriendo login…" if ES else "Opening login…")
        def work():
            res, err = http_post("/account/add", {"provider": harness, "alias": alias}, timeout=20)
            def done():
                if err or not res or not res.get("ok"):
                    note.set_text(err or (res or {}).get("error") or "No se pudo abrir el login")
                    add.set_sensitive(True)
                    for child in rows.get_children():
                        child.set_sensitive(getattr(child, "_can", False))
                else:
                    pop.popdown()
                    open_tab(res["session"], "claude", label=f"Login {harness} · {res['alias']}")
                return False
            GLib.idle_add(done)
        threading.Thread(target=work, daemon=True).start()
    add.connect("clicked", lambda *_: login())

    def switch(alias):
        for child in rows.get_children():
            child.set_sensitive(False)
        note.set_text((f"Pasando a {alias}…" if ES else f"Moving to {alias}…"))

        def fail(text):
            note.set_text(text)
            note.get_style_context().add_class("acct-err")
            for child in rows.get_children():
                child.set_sensitive(getattr(child, "_can", False))
            return False

        def work():
            res, err = http_post("/account/switch", {"session": sess, "pane": pane, "alias": alias}, timeout=20)
            if err or not res or res.get("ok") is False:
                GLib.idle_add(fail, err or (res or {}).get("error") or "No se pudo cambiar de cuenta")
                return
            GLib.idle_add(note.set_text, (f"Interrumpiendo lo que está haciendo y pasando a {alias} con la misma conversación…" if ES
                                          else f"Interrupting its current work and moving to {alias}, same conversation…"))
            final = _wait_account_switch(res.get("operationKey"), res.get("operationId"), alias,
                                         lambda stage: stage and GLib.idle_add(note.set_text, stage))

            def done():
                if final.get("awaiting"):
                    note.set_text(final["detail"])
                    return False
                if not final.get("ok"):
                    return fail(final.get("detail") or final.get("error") or "El cambio no se confirmó")
                note.set_text(f"Listo: este pane ya sigue la misma conversación en {alias}." if ES
                              else f"Done: this pane now continues the same conversation on {alias}.")
                GLib.timeout_add(2200, lambda: (pop.popdown(), False)[1])
                return False
            GLib.idle_add(done)
        threading.Thread(target=work, daemon=True).start()

    def fill(data, err):
        if err or not data:
            note.set_text(err or "No se pudieron leer las cuentas")
            note.get_style_context().add_class("acct-err")
            return False
        for a in data.get("accounts") or []:
            alias = a.get("alias") or ""
            on, can = alias == current and bool(a.get("selectable")), alias != current or not a.get("selectable")
            btn = Gtk.Button()
            btn.set_relief(Gtk.ReliefStyle.NONE)
            btn.get_style_context().add_class("acct-row")
            if on:
                btn.get_style_context().add_class("on")
            grid = Gtk.Grid(column_spacing=8, row_spacing=3)
            name = Gtk.Label(xalign=0)
            name.set_markup(f"<b>{GLib.markup_escape_text(alias)}</b>")
            name.set_hexpand(True)
            tag = Gtk.Label(label=("en uso" if on else "cambiar →" if a.get("selectable") else "iniciar sesión →") if ES
                            else ("in use" if on else "switch →" if a.get("selectable") else "sign in →"), xalign=1)
            tag.get_style_context().add_class("acct-tag")
            grid.attach(name, 0, 0, 2, 1); grid.attach(tag, 2, 0, 1, 1)
            if a.get("identity"):
                identity = Gtk.Label(label=a["identity"], xalign=0)
                identity.get_style_context().add_class("acct-dim")
                grid.attach(identity, 0, 1, 3, 1)
            for i, lim in enumerate(a.get("limits") or [], start=2 if a.get("identity") else 1):
                pct = int(lim.get("percent") or 0)
                lab = Gtk.Label(label=str(lim.get("label") or ""), xalign=0)
                lab.get_style_context().add_class("acct-dim")
                bar = Gtk.LevelBar.new_for_interval(0, 100)
                bar.set_mode(Gtk.LevelBarMode.CONTINUOUS)
                for off in ("low", "high", "full"):
                    try:
                        bar.remove_offset_value(off)
                    except Exception:
                        pass
                bar.set_value(pct); bar.set_hexpand(True); bar.set_valign(Gtk.Align.CENTER)
                bar.get_style_context().add_class("acct-bar")
                if _account_bar_class(pct):
                    bar.get_style_context().add_class(_account_bar_class(pct))
                val = Gtk.Label(label=f"{pct}%", xalign=1)
                val.get_style_context().add_class("acct-dim")
                grid.attach(lab, 0, i, 1, 1); grid.attach(bar, 1, i, 1, 1); grid.attach(val, 2, i, 1, 1)
            btn.add(grid)
            btn.set_tooltip_text(a.get("identity") or alias)
            btn._can = can
            btn.set_sensitive(can)
            if can:
                btn.connect("clicked", lambda *_, al=alias, ready=bool(a.get("selectable")): switch(al) if ready else login(al))
            rows.pack_start(btn, False, False, 0)
        note.set_text("Sigue la misma conversación. Si está respondiendo, se interrumpe y cambia al instante." if ES
                      else "Same conversation. If it is replying, it is interrupted and switches right away.")
        rows.show_all()
        return False

    def load():
        try:
            with urllib.request.urlopen(BASE_URL + "/accounts?harness=" + quote(harness), timeout=8) as r:
                data, err = json.loads(r.read().decode()), None
        except Exception as e:
            data, err = None, str(e)
        GLib.idle_add(lambda: fill(data, err))
    threading.Thread(target=load, daemon=True).start()
    return pop


def _extension_pill(sess, pane, harness=""):
    return _card_button("ia-spark", "MCPs · Skills", "Extensiones de este panel" if ES else "This pane's extensions",
                        lambda *_: _open_extension_shelf(sess, pane, harness))


_EXTENSION_SHELF = {"view": None, "target": None, "save": 0}
# El estante vive bajo las terminales en un Paned vertical: su separador se
# arrastra y la altura elegida se recuerda entre aperturas y reinicios.
SHELF_HEIGHT_FILE = os.path.expanduser("~/.claude/hooks/app-extension-shelf.json")
_SHELF_MIN, _SHELF_TERMINAL_MIN = 180, 160


def _shelf_height(total, saved):
    """Altura del estante dentro de `total` px: la guardada o ~48 % por defecto,
    sin bajar del mínimo usable ni tapar las terminales."""
    wanted = saved if saved > 0 else max(270, min(520, int(total * .48)))
    return max(_SHELF_MIN, min(int(wanted), total - _SHELF_TERMINAL_MIN))


def _load_shelf_height():
    try:
        with open(SHELF_HEIGHT_FILE) as f:
            return int(json.load(f).get("height") or 0)
    except Exception:
        return 0


def _save_shelf_height():
    _EXTENSION_SHELF["save"] = 0
    view = _EXTENSION_SHELF.get("view")
    if view is None or not view.get_visible():
        return False
    height = view.get_allocated_height()
    if height < _SHELF_MIN:
        return False
    try:
        os.makedirs(os.path.dirname(SHELF_HEIGHT_FILE), exist_ok=True)
        tmp = SHELF_HEIGHT_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"height": height}, f)
        os.replace(tmp, SHELF_HEIGHT_FILE)
    except Exception:
        pass
    return False


def _queue_shelf_height_save(*_):
    """notify::position llega en cada movimiento del arrastre: escribir una vez al soltar."""
    view = _EXTENSION_SHELF.get("view")
    if view is None or not view.get_visible():
        return
    if _EXTENSION_SHELF.get("save"):
        GLib.source_remove(_EXTENSION_SHELF["save"])
    _EXTENSION_SHELF["save"] = GLib.timeout_add(350, _save_shelf_height)


# Cajón de Avisos del escritorio: la campana lo abre BAJO las terminales, en el
# mismo estante que MCPs · Skills (pedido 30-sep), con index.html?panel=notices.
_NOTICES_SHELF = {"view": None}


def _toggle_notices_shelf(*_):
    if _NOTICES_SHELF["view"] is None:
        view = WebKit2.WebView.new_with_user_content_manager(ucm)   # mismo puente «centro»
        view.set_no_show_all(True)
        view.set_size_request(-1, _SHELF_MIN)
        _shelf_box.pack_start(view, True, True, 0)
        _NOTICES_SHELF["view"] = view
        view.load_uri(f"{BASE_URL}/?panel=notices&app=1&v={_DASH_V}")
    view = _NOTICES_SHELF["view"]
    if view.get_visible():
        view.hide()
        _shelf_box_sync()
        return False
    ext = _EXTENSION_SHELF.get("view")
    if ext is not None and ext.get_visible():
        _close_extension_shelf()
    total = _shelf_paned.get_allocated_height()
    _shelf_paned.set_position(total - _shelf_height(total, _load_shelf_height()) - _SHELF_HANDLE)
    view.show()
    _shelf_box_sync()
    return False


def _shelf_box_sync():
    """El estante se ve solo si alguna de sus vistas está visible."""
    if any(v is not None and v.get_visible() for v in (_EXTENSION_SHELF.get("view"), _NOTICES_SHELF.get("view"))):
        _shelf_box.show()
    else:
        _shelf_box.hide()


def _close_extension_shelf(*_):
    view = _EXTENSION_SHELF.get("view")
    if view is not None:
        view.hide()
        view.load_uri("about:blank")  # Stop inventory polling while collapsed.
    _EXTENSION_SHELF["target"] = None
    _shelf_box_sync()
    return False


def _extension_message(_manager, result):
    view = _EXTENSION_SHELF.get("view")
    if view is None:
        return
    uri = urlparse(view.get_uri() or "")
    expected = urlparse(BASE_URL)
    if (uri.scheme, uri.netloc, uri.path) != (expected.scheme, expected.netloc, "/extensions.html"):
        return
    if result.get_js_value().to_string() == "close":
        _close_extension_shelf()


def _open_extension_shelf(sess, pane, harness=""):
    if not isinstance(sess, str) or not isinstance(pane, str) or not re.fullmatch(r"%\d+", pane):
        return False
    if pane not in _pane_geometry(sess):
        return False
    target = (sess, pane, harness if harness in ("claude", "codex", "grok", "opencode", "agy") else "")
    if sess in tabs:
        ws_select(sess)
    if _EXTENSION_SHELF["view"] is None:
        manager = WebKit2.UserContentManager()
        manager.register_script_message_handler("extensions")
        manager.connect("script-message-received::extensions", _extension_message)
        view = WebKit2.WebView.new_with_user_content_manager(manager)
        view.set_no_show_all(True)
        view.set_size_request(-1, _SHELF_MIN)
        _shelf_box.pack_start(view, True, True, 0)
        _EXTENSION_SHELF["view"] = view
    view = _EXTENSION_SHELF["view"]
    notices = _NOTICES_SHELF.get("view")
    if notices is not None and notices.get_visible():
        notices.hide()                      # un estante a la vez
    if not view.get_visible():
        # Solo al abrir: si ya está abierto, re-pulsar no mueve lo que el usuario arrastró.
        total = _shelf_paned.get_allocated_height()
        _shelf_paned.set_position(total - _shelf_height(total, _load_shelf_height()) - _SHELF_HANDLE)
    if _EXTENSION_SHELF["target"] != target:
        query = "session=" + quote(sess, safe="") + "&pane=" + quote(pane, safe="")
        if target[2]:
            query += "&harness=" + target[2]
        view.load_uri(BASE_URL + "/extensions.html?" + query + "&v=" + _DASH_V)
        _EXTENSION_SHELF["target"] = target
    view.show()
    _shelf_box_sync()
    return False


def _draw_pane_frames(box, cr):
    """Borde redondeado de 1 px alrededor de cada pane tmux; el activo con la marca
    del tema (grill 1-oct: el color sale del tema, nunca fijo)."""
    frames = getattr(box, "_frames", None) or []
    if not frames:
        return False
    line = Gdk.RGBA(); line.parse(THEME.get("line") or "#223044")
    accent = Gdk.RGBA(); accent.parse(THEME.get("brand") or "#8B7CF6")
    for x, y, w, h, active in frames:
        c = accent if active else line
        cr.set_source_rgba(c.red, c.green, c.blue, 0.9 if active else 1.0)
        cr.set_line_width(1)
        _ws_rounded(cr, x + 0.5, y + 0.5, max(0, w - 1), max(0, h - 1), 10)
        cr.stroke()
    hot = getattr(box, "_hot_gutter", None)
    gutters = _PANE_GUTTERS.get(id(getattr(box, "_term", None)), [])
    if hot is not None and hot < len(gutters):
        orient, gx, gy, gw, gh = gutters[hot][:5]
        brand = Gdk.RGBA(); brand.parse(THEME.get("brand") or "#8B7CF6")
        dragging = bool(getattr(box, "_hot_state", (None, False))[1])
        vertical = orient == "v"
        cx, cy = gx + gw / 2, gy + gh / 2
        # 1) línea fina a todo lo largo del canal: qué borde tomas
        cr.set_source_rgba(brand.red, brand.green, brand.blue, 1.0 if dragging else 0.55)
        if vertical:
            cr.rectangle(cx - 1, gy, 2, gh)
        else:
            cr.rectangle(gx, cy - 1, gw, 2)
        cr.fill()
        # 2) pastilla central con sombra; crece al arrastrar
        long_, thick = (44, 8) if dragging else (34, 6)
        pw, ph = (thick, long_) if vertical else (long_, thick)
        cr.set_source_rgba(0, 0, 0, 0.35)
        _ws_rounded(cr, cx - pw / 2, cy - ph / 2 + 1, pw, ph, thick / 2)
        cr.fill()
        cr.set_source_rgba(brand.red, brand.green, brand.blue, 1.0)
        _ws_rounded(cr, cx - pw / 2, cy - ph / 2, pw, ph, thick / 2)
        cr.fill()
        # 3) tres puntos: «esto se arrastra»
        cr.set_source_rgba(1, 1, 1, 0.9)
        for k in (-7, 0, 7):
            cr.arc(cx if vertical else cx + k, cy + k if vertical else cy, 1.3, 0, 6.2832)
            cr.fill()
        # 4) al arrastrar, la medida en celdas de los dos lados: «100 | 80 col»
        label = _gutter_measure(box, gutters[hot]) if dragging else ""
        if label:
            cr.select_font_face("Ubuntu Sans Mono", 0, 1)
            cr.set_font_size(11)
            ext = cr.text_extents(label)
            bw, bh = ext.width + 16, 20
            bx = cx - bw / 2
            by = (cy - long_ / 2 - bh - 6) if vertical else (cy - bh - 10)
            bx = max(gx - 200, bx)
            cr.set_source_rgba(0, 0, 0, 0.35)
            _ws_rounded(cr, bx, by + 1, bw, bh, 5)
            cr.fill()
            cr.set_source_rgba(brand.red, brand.green, brand.blue, 1.0)
            _ws_rounded(cr, bx, by, bw, bh, 5)
            cr.fill()
            ink = Gdk.RGBA(); ink.parse(THEME.get("bg") or "#0A0D13")
            cr.set_source_rgba(ink.red, ink.green, ink.blue, 1.0)
            cr.move_to(bx + 8 - ext.x_bearing, by + bh / 2 - ext.height / 2 - ext.y_bearing)
            cr.show_text(label)
    return False


def _shell_pill_xy(rows, pane_id, m_l, m_t, left, top, cw, chh):
    """«Iniciar IA aquí» centrado en el renglón de cabecera, dentro del marco."""
    if pane_id in rows:
        fx, rail_y, _fw, fy = rows[pane_id]
        top_y = int(fy) + 1
        return int(fx) + 8, top_y + max(0, (int(rail_y + chh) - top_y - 22) // 2)
    return max(0, int(m_l + left * cw + cw)), _pill_row_y(m_t, top, chh)


def _pill_row_y(m_t, top, chh):
    """Y de la pildora: SOBRE el renglon de borde tmux (pane-border-status top,
    formato vacio = riel reservado), que es la fila pane_top-1. Antes se usaba
    pane_top a secas y la pildora caia en la PRIMERA fila de contenido, tapando
    el prompt o el titulo del TUI."""
    row = top - 1 if top >= 1 else 0
    return max(0, int(m_t + row * chh))


def _visible_boxes():
    """Terminales visibles ahora: la pestaña activa o, si es un grupo, todos sus
    miembros; más la terminal de la barra si está a la vista."""
    page = nb.get_nth_page(nb.get_current_page()) if nb.get_n_pages() else None
    out = list(page.members.values()) if isinstance(page, gtk_workspace.GroupPage) else ([page] if page is not None else [])
    side = _SIDE.get("box") if "_SIDE" in globals() else None
    if side is not None and _side_term_host.get_visible():
        out.append(side)
    return out


def _box_focused(box):
    """¿Esta terminal tiene el foco? En un grupo, solo el miembro enfocado; la de la
    barra, cuando el teclado está en ella."""
    if getattr(box, "_side", False):
        return bool(getattr(box, "_term", None) and box._term.has_focus())
    page = nb.get_nth_page(nb.get_current_page()) if nb.get_n_pages() else None
    if isinstance(page, gtk_workspace.GroupPage):
        return page.members.get(page.focus) is box
    return page is box


_PANE_GUTTERS = {}     # id(VTE) -> [(orient, x, y, w, h, pane)] canales entre panes (para la agarradera)
_PANE_GEO = {}         # id(VTE) -> {pane: (left, top, width)} de los últimos marcos dibujados


def _gutter_at(box, x, y, slack=6):
    """Índice del canal bajo (x, y). La zona es ancha (canal ± 6 px): el arrastre
    lo hace ComandOS, ya no hay que atinarle a la columna de 1 celda de tmux."""
    term = getattr(box, "_term", None)
    for i, g in enumerate(_PANE_GUTTERS.get(id(term), [])):
        _orient, gx, gy, gw, gh = g[:5]
        if gx - slack <= x <= gx + gw + slack and gy - slack <= y <= gy + gh + slack:
            return i
    return None


def _gutter_neighbor(geo, heights, pane, orient):
    """Pane al otro lado del canal (a la derecha si es vertical, abajo si es
    horizontal) que más se traslapa con `pane`; None si no hay."""
    left, top, width = geo[pane][:3]
    height = heights.get(pane, 0)
    best, overlap = None, 0
    for other, g in geo.items():
        if other == pane:
            continue
        o_left, o_top, o_width = g[:3]
        o_height = heights.get(other, 0)
        if orient == "v" and o_left == left + width + 1:
            ov = min(top + height, o_top + o_height) - max(top, o_top)
        elif orient == "h" and o_top == top + height + 1:
            ov = min(left + width, o_left + o_width) - max(left, o_left)
        else:
            continue
        if ov > overlap:
            best, overlap = other, ov
    return best


def _gutter_target(geo, heights, pane, orient, cell, nb=None):
    """Tamaño nuevo (celdas) de `pane` si el canal se suelta en la celda `cell`
    (columna si es vertical, fila si es horizontal). Cada lado conserva 2 celdas."""
    left, top, width = geo[pane][:3]
    start, size = (left, width) if orient == "v" else (top, heights.get(pane, 0))
    if nb is not None and nb in geo:
        room = size + (geo[nb][2] if orient == "v" else heights.get(nb, 0))
        return max(2, min(room - 2, cell - start))
    return max(2, cell - start)


def _gutter_half(geo, heights, pane, orient, nb):
    """Doble clic en el canal (grill 1-oct): los dos lados quedan a la mitad."""
    size = geo[pane][2] if orient == "v" else heights.get(pane, 0)
    other = geo[nb][2] if orient == "v" else heights.get(nb, 0)
    return max(2, (size + other) // 2)


def _gutter_measure(box, g):
    """«100 | 80 col» o «29 / 21 filas» del canal que se arrastra."""
    term = getattr(box, "_term", None)
    geo = _PANE_GEO.get(id(term), {})
    orient, pane = g[0], g[5] if len(g) > 5 else None
    if pane not in geo:
        return ""
    heights = {k: v[0] for k, v in _PANE_BOX.items()}
    nb = _gutter_neighbor(geo, heights, pane, orient)
    if orient == "v":
        right = geo[nb][2] if nb else 0
        return f"{geo[pane][2]} | {right} col" if nb else f"{geo[pane][2]} col"
    below = heights.get(nb, 0) if nb else 0
    return f"{heights.get(pane, 0)} / {below} filas" if nb else f"{heights.get(pane, 0)} filas"


_CURSOR_CACHE = {}
GRIP_SLACK = 8         # px de agarre a cada lado del canal entre panes


def _grip_cursor(widget, name):
    """Cursor propio de una franja de agarre: es SU ventana de entrada, así la VTE
    no lo pisa (la pelea VTE ↔ manita hacía parpadear flecha/mano, 1-oct)."""
    win_ = widget.get_window() if hasattr(widget, "get_window") else None
    if win_ is None:
        return
    key = (id(widget.get_display()), name)
    if key not in _CURSOR_CACHE:
        _CURSOR_CACHE[key] = Gdk.Cursor.new_from_name(widget.get_display(), name)
    win_.set_cursor(_CURSOR_CACHE[key])


def _grip_rect(g):
    """Zona de agarre de un canal: el canal más GRIP_SLACK px a cada lado."""
    orient, gx, gy, gw, gh = g[:5]
    if orient == "v":
        return int(gx - GRIP_SLACK), int(gy), int(gw + 2 * GRIP_SLACK), int(gh)
    return int(gx), int(gy - GRIP_SLACK), int(gw), int(gh + 2 * GRIP_SLACK)


def _sync_grips(box):
    """Una franja de entrada (EventBox sin ventana visible) sobre cada canal entre
    panes. Solo cubre el canal; el resto de la terminal recibe todo como siempre."""
    ov, term = getattr(box, "_pill_overlay", None), getattr(box, "_term", None)
    if ov is None or term is None:
        return
    gutters = _PANE_GUTTERS.get(id(term), [])
    grips = getattr(box, "_grips", None)
    if grips is None:
        grips = box._grips = []
    while len(grips) < len(gutters):
        eb = Gtk.EventBox()
        eb.set_visible_window(False)
        eb.set_halign(Gtk.Align.START)
        eb.set_valign(Gtk.Align.START)
        eb.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_PRESS_MASK
                      | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK
                      | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        eb.connect("realize", lambda w: _grip_cursor(w, "grab"))
        eb.connect("enter-notify-event", lambda w, e, b=box: _grip_enter(b, w))
        eb.connect("leave-notify-event", lambda w, e, b=box: _grip_leave(b, w))
        eb.connect("button-press-event", lambda w, e, b=box: _gutter_press(b, w, e))
        eb.connect("motion-notify-event", lambda w, e, b=box: _gutter_motion(b, w, e))
        eb.connect("button-release-event", lambda w, e, b=box: _gutter_release(b, w, e))
        eb._rect, eb._i = None, len(grips)
        ov.add_overlay(eb)
        grips.append(eb)
    for i, eb in enumerate(grips):
        if i >= len(gutters):
            eb.hide()
            continue
        rect = _grip_rect(gutters[i])
        if eb._rect != rect:                 # sin recolocar si no cambió (evita relayout)
            eb._rect = rect
            x, y, w, h = rect
            eb.set_margin_start(max(0, x)); eb.set_margin_top(max(0, y))
            eb.set_size_request(max(1, w), max(1, h))
        eb.show()


def _gutter_hot(box, hot, dragging):
    state = (hot, bool(dragging))
    if getattr(box, "_hot_state", None) != state:
        box._hot_gutter, box._hot_state = hot, state
        ov = getattr(box, "_pill_overlay", None)
        if ov is not None:
            ov.queue_draw()


def _grip_enter(box, w):
    if not getattr(box, "_drag", None):
        _gutter_hot(box, w._i, False)
    return False


def _grip_leave(box, w):
    if not getattr(box, "_drag", None) and getattr(box, "_hot_gutter", None) == w._i:
        _gutter_hot(box, None, False)
    return False


def _box_cell(box, ex, ey):
    """(columna, fila) de tmux bajo un punto de la VTE (coordenadas del evento)."""
    term = box._term
    cw, chh = term.get_char_width(), term.get_char_height()
    if cw < 4 or chh < 6:
        return None
    return int(ex // cw), int(ey // chh)


def _focus_frame_now(box, ex, ey):
    """Clic en un pane: el marco salta a él al instante, sin esperar a tmux
    (tmux selecciona ese mismo pane con MouseDown1Pane)."""
    term = getattr(box, "_term", None)
    geo = _PANE_GEO.get(id(term), {})
    cell = _box_cell(box, ex, ey) if geo else None
    if not cell:
        return
    col, row = cell
    for pane, g in geo.items():
        left, top, width = g[:3]
        height = _PANE_BOX.get(pane, (0, False))[0]
        if left <= col < left + width and top - 1 <= row < top + height:
            if _PANE_BOX.get(pane, (0, False))[1]:
                return
            for other in geo:
                h = _PANE_BOX.get(other, (0, False))[0]
                _PANE_BOX[other] = (h, other == pane)
            _reposition_pills(box, geo)
            # En un grupo el foco GTK cambia después del clic: repintar entonces también.
            GLib.idle_add(lambda: (_reposition_pills(box, geo), False)[1])
            return


_TMUX_PREFIX = [None]


def _tmux_prefix():
    """(keyval, máscara) del prefijo de tmux (C-b por defecto)."""
    if _TMUX_PREFIX[0] is None:
        key = "C-b"
        try:
            key = subprocess.run(["tmux", "show", "-gv", "prefix"], capture_output=True,
                                 text=True, timeout=2).stdout.strip() or key
        except Exception:
            pass
        mask, name = 0, key
        while len(name) > 2 and name[1] == "-" and name[0] in "CMS":
            mask |= {"C": Gdk.ModifierType.CONTROL_MASK, "M": Gdk.ModifierType.MOD1_MASK,
                     "S": Gdk.ModifierType.SHIFT_MASK}[name[0]]
            name = name[2:]
        _TMUX_PREFIX[0] = (Gdk.keyval_to_lower(Gdk.keyval_from_name(name)), mask)
    return _TMUX_PREFIX[0]


def _prefix_watch(box, event):
    """Cambiar de pane con el teclado (prefijo + o, flechas, q…): tras la tecla que
    sigue al prefijo, el marco se actualiza en ~0.1 s en vez de esperar el sondeo."""
    keyval, mask = _tmux_prefix()
    mods = event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK)
    now = time.monotonic()
    if Gdk.keyval_to_lower(event.keyval) == keyval and mods == mask:
        box._prefix_until = now + 1.5
        return False
    if now < getattr(box, "_prefix_until", 0):
        box._prefix_until = now + 0.6          # tmux repite flechas sin prefijo ~500 ms
        GLib.timeout_add(60, lambda: _pane_geo_soon(box))
    return False


def _gutter_send(box, d):
    """Manda a tmux el último tamaño pedido; uno a la vez, sin bloquear la UI."""
    if d.get("proc") is not None and d["proc"].poll() is None:
        return
    d["proc"] = None
    want = d.get("want")
    if want is None or want == d.get("sent"):
        return
    pane, axis, n = want
    try:
        d["proc"] = subprocess.Popen(["tmux", "resize-pane", "-t", pane, axis, str(n)],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        return
    d["sent"] = want

    def done():
        if d["proc"] is not None and d["proc"].poll() is None:
            return True
        d["proc"] = None
        _pane_geo_soon(box)
        _gutter_send(box, d)
        return False
    GLib.timeout_add(15, done)


def _term_click(box, e):
    """Clic en la terminal (fuera de los canales): el marco salta al pane al instante."""
    if e.button == 1 and e.type == Gdk.EventType.BUTTON_PRESS:
        _focus_frame_now(box, e.x, e.y)
    return False


def _grip_to_term(box, w, e):
    """Coordenadas de un evento de la franja → coordenadas de la VTE."""
    term = box._term
    return (w.get_margin_start() + e.x - term.get_margin_start(),
            w.get_margin_top() + e.y - term.get_margin_top())


def _gutter_press(box, w, e):
    """Presionar en la franja del canal: el arrastre lo hace ComandOS (no tmux).
    Doble clic deja los dos lados a la mitad."""
    if e.button != 1:
        return False
    term = box._term
    gutters = _PANE_GUTTERS.get(id(term), [])
    hot = getattr(w, "_i", None)
    if hot is None or hot >= len(gutters) or len(gutters[hot]) < 6:
        return True
    g = gutters[hot]
    orient, pane = g[0], g[5]
    geo = _PANE_GEO.get(id(term), {})
    heights = {k: v[0] for k, v in _PANE_BOX.items()}
    if pane not in geo:
        return True
    nb = _gutter_neighbor(geo, heights, pane, orient)
    axis = "-x" if orient == "v" else "-y"
    if e.type == Gdk.EventType._2BUTTON_PRESS:
        box._drag = None
        if nb is not None:
            _gutter_send(box, {"want": (pane, axis, _gutter_half(geo, heights, pane, orient, nb))})
        return True
    if e.type != Gdk.EventType.BUTTON_PRESS:
        return True
    box._drag = {"pane": pane, "orient": orient, "axis": axis, "nb": nb, "want": None, "sent": None, "proc": None}
    _grip_cursor(w, "grabbing")
    _gutter_hot(box, hot, True)
    return True


def _gutter_motion(box, w, e):
    d = getattr(box, "_drag", None)
    if not d:
        return True
    cell = _box_cell(box, *_grip_to_term(box, w, e))
    geo = _PANE_GEO.get(id(box._term), {})
    if cell and d["pane"] in geo:
        heights = {k: v[0] for k, v in _PANE_BOX.items()}
        at = cell[0] if d["orient"] == "v" else cell[1]
        d["want"] = (d["pane"], d["axis"], _gutter_target(geo, heights, d["pane"], d["orient"], at, d["nb"]))
        _gutter_send(box, d)
    return True


def _gutter_release(box, w, e):
    d = getattr(box, "_drag", None)
    if e.button != 1:
        return False
    box._drag = None
    if d:
        _gutter_send(box, d)
    _grip_cursor(w, "grab")
    a = w.get_allocation()
    inside = 0 <= e.x < a.width and 0 <= e.y < a.height
    _gutter_hot(box, w._i if inside else None, False)
    return True


def _pane_frames(term, geo, m_l, m_t, cw, chh, focused=True):
    """Marcos de los panes (prototipo: borde 1 px, radio 10, verde el pane con
    foco) y el renglón de cabecera de cada uno. Cada marco encierra la CABECERA
    (el renglón que tmux reserva arriba del pane con pane-border-status top) y el
    contenido debajo: nada del pane queda fuera. Van en la capa Overlay, en los
    márgenes de la VTE y en el hueco entre panes, sin cruzar texto."""
    frames, rows, gutters = [], {}, []
    rows_total = term.get_row_count() if hasattr(term, "get_row_count") else 0
    cols_total = term.get_column_count() if hasattr(term, "get_column_count") else 0
    for pane_id, g3 in geo.items():
        left, top, width = g3[:3]
        height, active = _PANE_BOX.get(pane_id, (0, False))
        if height <= 0 or width < 8:
            continue
        rail = m_t + (top - 1) * chh if top >= 1 else m_t      # renglón de cabecera
        x0 = m_l + left * cw - (5 if left == 0 else 3)
        x1 = m_l + (left + width) * cw + 3
        # Panes de arriba: el marco (y su cabecera) sube al margen extra sobre la VTE,
        # así la cabecera mide ~35 px sin tapar texto. Panes apilados: el renglón tmux.
        # Apilados: 5 px de aire entre el marco de arriba y la cabecera de abajo.
        y0 = rail - (HEADER_EXTRA + 3) if top <= 1 else rail + 3
        bottom = m_t + (top + height) * chh
        at_bottom = rows_total and top + height >= rows_total
        y1 = bottom + 3 if at_bottom else bottom - 2
        frames.append((x0, y0, x1 - x0, y1 - y0, active and focused))
        rows[pane_id] = (x0, rail, x1 - x0, y0)
        # Canales donde tmux redimensiona: la columna a la derecha del pane y el
        # renglón debajo (que es la cabecera del de abajo). Ahí va la agarradera.
        if cols_total and left + width < cols_total:
            gutters.append(("v", m_l + (left + width) * cw, y0 + 6, cw, max(0, y1 - y0 - 12), pane_id))
        if rows_total and top + height < rows_total:
            gutters.append(("h", x0 + 10, bottom - 2, max(0, x1 - x0 - 20), 5, pane_id))
    _PANE_GUTTERS[id(term)] = gutters
    _PANE_GEO[id(term)] = dict(geo)
    return frames, rows


def _card_rect(rows, pane_id, chh):
    """Cabecera B (grill 30-sep): franja pegada arriba del marco, a todo su ancho,
    desde el borde superior del marco hasta donde empieza el contenido."""
    fx, rail_y, fw, fy = rows[pane_id]
    top = int(fy) + 1
    return int(fx) + 1, top, max(120, int(fw) - 2), max(18, int(rail_y + chh) - top)


KEY_H = 22     # alto de «IA» / «MCPs · Skills» en la cabecera


def _reposition_pills(box, geo):
    """Redimensionar panes: mueve marcos y Tarjetas existentes sin reconstruir
    nada. False si cambió qué panes hay (entonces toca reconstruir)."""
    term, ov = getattr(box, "_term", None), getattr(box, "_pill_overlay", None)
    if term is None or ov is None:
        return False
    try:
        cw, chh = term.get_char_width(), term.get_char_height()
    except Exception:
        return False
    if cw < 4 or chh < 6:
        return False
    m_l, m_t = term.get_margin_start(), term.get_margin_top()
    frames, rows = _pane_frames(term, geo, m_l, m_t, cw, chh, _box_focused(box))
    _sync_grips(box)
    for w in getattr(box, "_pills", []):
        pid = getattr(w, "_pane_id", None)
        if pid is None:
            continue
        if pid not in geo or (getattr(w, "_kind", "") != "shell" and pid not in rows):
            return False
    box._frames, box._card_rows = frames, rows
    for w in getattr(box, "_pills", []):
        pid, kind = getattr(w, "_pane_id", None), getattr(w, "_kind", "")
        if pid is None:
            continue
        if kind == "shell":
            left, top = geo[pid][0], geo[pid][1]
            sx, sy = _shell_pill_xy(rows, pid, m_l, m_t, left, top, cw, chh)
            w.set_margin_top(sy)
            w.set_margin_start(sx)
            continue
        cx, cy, cwid, chgt = _card_rect(rows, pid, chh)
        if kind == "card":
            w.set_size_request(cwid, chgt)
            w.set_margin_start(cx); w.set_margin_top(cy)
        elif kind == "keys":
            w.set_margin_start(max(cx, cx + cwid - int(getattr(w, "_kw", 0) or 0) - 8))
            w.set_margin_top(cy + max(0, (chgt - KEY_H) // 2) - 1)
    ov.queue_draw()
    return True


_GEO_PENDING = {}


def _pane_geo_soon(box):
    """Mientras se arrastra un borde de tmux, sigue el tamaño de los panes en
    vivo (cada ~40 ms) en vez de esperar el sondeo de 2 s."""
    if _GEO_PENDING.get(id(box)):
        return False
    def run():
        _GEO_PENDING.pop(id(box), None)
        if box not in _visible_boxes() and box is not hub:
            return False
        geo = _pane_geometry(getattr(box, "_pill_sess", ""))
        sig = json.dumps(sorted(geo.items())) + json.dumps(sorted((k, _PANE_BOX.get(k)) for k in geo))
        if geo and sig != getattr(box, "_geo_sig", ""):
            box._geo_sig = sig
            if not _reposition_pills(box, geo):
                box._pill_sig = ""          # cambió qué panes hay: el sondeo reconstruye
        return False
    _GEO_PENDING[id(box)] = GLib.timeout_add(40, run)
    return False


def _place_pills(box, panes, geo=None):
    ov = getattr(box, "_pill_overlay", None)
    term = getattr(box, "_term", None)
    if ov is None or term is None:
        return
    for w in getattr(box, "_pills", []):
        try: ov.remove(w)
        except Exception: pass
    box._pills = []
    if geo is None:
        geo = _pane_geometry(getattr(box, "_pill_sess", ""))
    if not geo:
        return
    try:
        cw = term.get_char_width(); chh = term.get_char_height()
    except Exception:
        return
    if cw < 4 or chh < 6:
        box._pill_sig = ""      # fuente aun no lista: reintenta al siguiente tick
        return
    m_l = term.get_margin_start(); m_t = term.get_margin_top()
    box._frames, box._card_rows = _pane_frames(term, geo, m_l, m_t, cw, chh, _box_focused(box))
    _sync_grips(box)
    ov.queue_draw()
    placed = set()
    for p in panes[:6]:
        g = geo.get(p.get("pane") or "")
        if not g:
            continue
        if _PANE_CMD.get(p.get("pane") or "", "") in _SHELLS:
            # cc-dash aun cree que hay agente pero el pane ya volvio al shell
            # (sesion detenida): NO pintar el modelo viejo; abajo va 'Iniciar IA'.
            continue
        placed.add(p.get("pane"))
        left, top, width = g[:3]
        sess_now = getattr(box, "_pill_sess", "")
        pill = _pane_pill(sess_now, p, keys=False)
        # Tarjeta (prototipo aprobado): ocupa todo el ancho del pane. Va sobre el
        # renglón de borde de tmux, así que es TRANSPARENTE al ratón: arrastrar ese
        # borde sigue redimensionando los panes. Solo sus dos botones reciben clic
        # (van en su propia capa, encima, al canto derecho).
        if (p.get("pane") or "") not in box._card_rows:
            continue
        card_x, card_y, card_w, card_h = _card_rect(box._card_rows, p.get("pane") or "", chh)
        pill.set_size_request(card_w, card_h)
        pill._pane_id, pill._kind = p.get("pane") or "", "card"
        # anclada al INICIO de cada pane, SOBRE el renglon de titulo tmux
        # que va vacio (riel reservado): no tapa contenido y la posicion es
        # determinista sin medir anchos de widget
        pill.set_halign(Gtk.Align.START)
        pill.set_valign(Gtk.Align.START)
        # Sobre el renglón de borde tmux (vacío). Sin -3: ese offset metía la
        # pildora en la statusline del TUI (Grok/Claude) y el titulo se veía detrás.
        pill.set_margin_top(card_y)
        pill.set_margin_start(card_x)
        ov.add_overlay(pill)
        ov.set_overlay_pass_through(pill, True)
        pill.show_all()
        box._pills.append(pill)
        keys = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)  # 10 px entre «IA» y «MCPs · Skills»
        keys.get_style_context().add_class("pane-card-keys")
        for key in _pane_card_keys(sess_now, p, p.get("harness") or ""):
            keys.pack_start(key, False, False, 0)
        keys.set_halign(Gtk.Align.START)
        keys.set_valign(Gtk.Align.START)
        keys.set_margin_top(card_y + max(0, (card_h - KEY_H) // 2) - 1)
        ov.add_overlay(keys)                 # primero en la jerarquía: así el ancho ya trae el CSS aplicado
        keys.show_all()
        kw = keys.get_preferred_width()[1] if hasattr(keys, "get_preferred_width") else 0
        keys._pane_id, keys._kind, keys._kw = p.get("pane") or "", "keys", kw
        keys.set_margin_start(max(card_x, card_x + card_w - int(kw or 0) - 8))   # 8 px al canto derecho
        box._pills.append(keys)
    # Panes SIN agente (shell vivo): boton visible para arrancar una IA ahi.
    with_agent = placed
    sess = getattr(box, "_pill_sess", "")
    for pane_id, g3 in geo.items():
        left, top, width = g3[:3]
        if pane_id in with_agent or _PANE_CMD.get(pane_id, "") not in _SHELLS or width < 24:
            continue
        pill = _shell_pill(sess, pane_id)
        pill._pane_id, pill._kind = pane_id, "shell"
        pill.set_halign(Gtk.Align.START)
        pill.set_valign(Gtk.Align.START)
        sx, sy = _shell_pill_xy(box._card_rows, pane_id, m_l, m_t, left, top, cw, chh)
        pill.set_margin_top(sy)
        pill.set_margin_start(sx)
        ov.add_overlay(pill)
        pill.show_all()
        box._pills.append(pill)


def _refresh_tab_models():
    try:
        with open(APP_TAB_MODELS_FILE) as f:
            models = json.load(f)
    except Exception:
        return True
    pages = list(tabs.items())
    if hub not in tabs.values():
        pages.append(("local", hub))
    side_state = globals().get("_SIDE") or {}
    side = side_state.get("box")
    if side is not None:
        pages.append((side_state.get("sess") or "", side))
    current = nb.get_nth_page(nb.get_current_page())
    visible = _visible_boxes()
    for key, box in pages:
        session = str(key).partition(":")[0]
        info = models.get(session) if isinstance(models, dict) else None
        hb = tab_hb(box)
        label = getattr(hb, "_model", None)
        # la pestana ⌂ local NO lleva sufijo de modelo (infla el tab strip);
        # SEMANTICA: logo del proveedor + modelo corto (no "Claude · fable")
        micon = getattr(hb, "_micon", None)
        if label is not None and box is not hub:
            panes = (info or {}).get("panes") if isinstance(info, dict) else None
            first = next((p for p in (panes or []) if p.get("model")), None)
            text, icon = "", None
            if first:
                extra = len([p for p in panes if p.get("model")]) - 1
                text = f"{first['model']}{f' +{extra}' if extra > 0 else ''}"
                # Prototipo aprobado (30-sep): la pestaña lleva semáforo + nombre +
                # modelo; el logo del motor vive en la Tarjeta del pane, no aquí.
            if getattr(label, "_model_text", None) != text:
                label.set_text(text)
                label._model_text = text
            if getattr(hb, "_model_icon", False) != icon:
                if micon is not None:
                    if icon is None:
                        micon.hide()
                    else:
                        try:
                            img = _svg_image(icon[0], 11, icon[1])
                            micon.set_from_pixbuf(img.get_pixbuf())
                            micon.show()
                        except Exception:
                            micon.hide()
                hb._model_icon = icon
        elif micon is not None:
            micon.hide()
        if getattr(box, "_pill_overlay", None) is None or box not in visible:
            continue
        panes = (info or {}).get("panes") if isinstance(info, dict) else None
        try:
            metrics = (box._term.get_char_width(), box._term.get_char_height(),
                       box._term.get_margin_start(), box._term.get_margin_top())
        except Exception:
            metrics = ()
        geo_now = _pane_geometry(session)   # tambien refresca _PANE_CMD
        sig = (json.dumps(panes or [], sort_keys=True) + "|" + json.dumps(sorted(geo_now))
               + "|" + json.dumps(sorted((k, _PANE_CMD.get(k, "")) for k in geo_now))
               + "|" + json.dumps([THEME.get("fg"), THEME.get("brand")])
               + "|" + work_mark_state.ai_status(STATE_CACHE.get(session, ""))
               + "|" + work_mark_row("session", session)["mark"])
        if sig != getattr(box, "_pill_sig", ""):
            box._pill_sig = sig
            _place_pills(box, panes or [], geo_now)
        elif not _reposition_pills(box, geo_now):   # solo cambió el tamaño o el foco: mover, no reconstruir
            box._pill_sig = ""
    return True


